diff --git a/runtime/class_linker.cc b/runtime/class_linker.cc
index db91a54..ccb987b 100644
--- a/runtime/class_linker.cc
+++ b/runtime/class_linker.cc
@@ -4604,10 +4604,35 @@ void ClassLinker::LoadClassHelper::Commit(Handle<mirror::Class> klass,
   }
 }
 
+#if defined(GESHER)
+// gesher: ClassLinker::LoadClass as an app's packer hooks it on a device. Ijiami
+// (and packers like it) ship dex files whose method bodies are missing, find
+// libart.so in /proc/self/maps, hook this function by its symbol and fill a
+// class's bodies in the dex file before ART reads them. ART is not libart.so
+// here: compat/bionic/art_shim.cc loads a stand-in libart.so for such an app
+// (only then) and sets this to its LoadClass, a System V function that does
+// nothing unless the packer hooked it (ADR 0086). Null otherwise.
+extern "C" void* volatile gesher_art_load_class_hook;
+void* volatile gesher_art_load_class_hook = nullptr;
+using GesherLoadClassHook = void(ART_SYSV_ABI*)(ClassLinker* linker,
+                                                Thread* self,
+                                                const DexFile* dex_file,
+                                                const dex::ClassDef* dex_class_def,
+                                                Handle<mirror::Class> klass);
+#endif
+
 void ClassLinker::LoadClass(Thread* self,
                             const DexFile& dex_file,
                             const dex::ClassDef& dex_class_def,
                             Handle<mirror::Class> klass) {
+#if defined(GESHER)
+  if (void* hook = gesher_art_load_class_hook;
+      UNLIKELY(hook != nullptr) && !klass->IsBootStrapClassLoaded()) {
+    // The same arguments as the device's ClassLinker::LoadClass (this, then
+    // references as pointers, the Handle by value), before the class data is read.
+    reinterpret_cast<GesherLoadClassHook>(hook)(this, self, &dex_file, &dex_class_def, klass);
+  }
+#endif
   ClassAccessor accessor(dex_file,
                          dex_class_def,
                          /* parse_hiddenapi_class_data= */ klass->IsBootStrapClassLoaded());
