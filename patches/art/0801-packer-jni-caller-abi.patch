--- a/runtime/jni/jni_env_ext.cc
+++ b/runtime/jni/jni_env_ext.cc
@@ -327,4 +327,19 @@ void JNIEnvExt::ResetFunctionTable() {
   runtime->GetThreadList()->ForEach(ThreadResetFunctionTable, nullptr);
 }
 
+#if defined(GESHER)
+// gesher: for compat/bionic/jni_bridge.cc (ADR 0086). A packer that makes Java
+// methods native by writing their ArtMethod (Ijiami) gets ART's own JNIEnv, and
+// calls its table with the System V ABI; the bridge then installs a table whose
+// entries choose the ABI by their caller.
+extern "C" const JNINativeInterface* gesher_art_jni_function_table() {
+  Thread* self = Thread::Current();
+  return self != nullptr ? self->GetJniEnv()->functions : GetJniNativeInterface();
+}
+
+extern "C" void gesher_art_set_jni_table_override(const JNINativeInterface* table) {
+  JNIEnvExt::SetTableOverride(table);
+}
+#endif
+
 }  // namespace art
