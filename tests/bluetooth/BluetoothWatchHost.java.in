import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;

public final class BluetoothWatchHost {
    private static final class Service {
        private final Object mLock = new Object();
        private Thread mWatch;
        private int mState = -1;
        private long mPollMs = 10000;
        private final CountDownLatch pollEntered = new CountDownLatch(1);
        private final CountDownLatch releasePoll = new CountDownLatch(1);
        private final AtomicInteger pollCalls = new AtomicInteger();

        // Models slow paired-device enumeration without holding the state lock.
        public void poll() {
            pollCalls.incrementAndGet();
            pollEntered.countDown();
            try {
                releasePoll.await();
                synchronized (mLock) { mState = BluetoothAdapter.STATE_ON; }
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
        // PRODUCTION_WATCH_METHODS
    }
    private static void check(boolean value, String message) {
        if (!value) throw new AssertionError(message);
    }
    public static void main(String[] args) throws Exception {
        Service service = new Service();
        CountDownLatch returned = new CountDownLatch(1);
        AtomicReference<Throwable> failure = new AtomicReference<>();
        Thread caller = new Thread(() -> {
            try { service.startWatch(); }
            catch (Throwable e) { failure.set(e); }
            finally { returned.countDown(); }
        }, "adapter-caller");
        caller.start();
        try {
            check(service.pollEntered.await(5, TimeUnit.SECONDS), "background enumeration started");
            check(returned.await(1, TimeUnit.SECONDS),
                    "adapter watch startup must return while paired-device enumeration is blocked");
            check(failure.get() == null, "watch startup failed: " + failure.get());
            check(service.state() == BluetoothAdapter.STATE_ON,
                    "state answers from the adapter before the enumeration baseline exists");
            Thread watcher = service.mWatch;
            service.startWatch();
            check(service.mWatch == watcher && service.pollCalls.get() == 1,
                    "repeated startup keeps one background watch and does not poll the caller");
        } finally {
            service.releasePoll.countDown();
            caller.join(5000);
            if (service.mWatch != null) {
                service.mWatch.interrupt();
                service.mWatch.join(5000);
            }
        }
        check(!caller.isAlive() && !service.mWatch.isAlive(), "fixture threads terminated");
        System.out.println("BluetoothWatchHost passed: nonblocking startup, state fallback, one watch");
    }
}
class BluetoothAdapter { static final int STATE_OFF = 10, STATE_ON = 12; }
class WindowsBluetooth {
    static final class Adapter { final boolean present = true, on = true; }
    static Adapter adapter(long maxAge) { return new Adapter(); }
    static boolean waitForChange(int timeoutMs) throws InterruptedException {
        new CountDownLatch(1).await(timeoutMs, TimeUnit.MILLISECONDS);
        return false;
    }
}
class SystemServer { static void log(String text) {} }
