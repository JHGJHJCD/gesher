// Security options use a recording Winsock stand-in.
std::vector<int> options;
int failOption = 0;
struct FakeWinsock {
  int setsockopt(SOCKET, int level, int option, const char* value, int length) const {
    if (level != SOL_RFCOMM || length != sizeof(ULONG) ||
        *reinterpret_cast<const ULONG*>(value) != TRUE) return SOCKET_ERROR;
    options.push_back(option);
    return option == failOption ? SOCKET_ERROR : 0;
  }
};
const FakeWinsock& Ws() { static FakeWinsock ws; return ws; }
int WSAGetLastError() { return 10013; }
@SECURITY@

int failures = 0;
void Check(bool result, const char* text) {
  std::printf("bluetooth-native: %s %s\n", result ? "PASS" : "FAIL", text);
  if (!result) ++failures;
}
template <typename F> bool Until(F condition, int timeout = 1000) {
  const auto start = GetTickCount64();
  while (!condition()) {
    if (GetTickCount64() - start >= static_cast<ULONGLONG>(timeout)) return false;
    Sleep(1);
  }
  return true;
}

// Test objects are owned by their fixture; reference counts expose leaked COM
// ownership without deleting the stand-in before the checks can inspect it.
#define FAKE_INSPECTABLE \
  std::atomic<ULONG> refs{1}; \
  ULONG AddRef() override { return ++refs; } \
  ULONG Release() override { return --refs; } \
  HRESULT GetIids(ULONG*, IID**) override { return E_NOTIMPL; } \
  HRESULT GetRuntimeClassName(HSTRING*) override { return E_NOTIMPL; } \
  HRESULT GetTrustLevel(int*) override { return E_NOTIMPL; }

template <typename T>
class Operation final : public IAsyncOperation<T>, public winrt::IAsyncInfo {
 public:
  FAKE_INSPECTABLE
  std::atomic<int> state{0}, cancels{0};
  std::atomic<bool> requested{false}, inResults{false}, releaseResults{true};
  T result = nullptr;
  HRESULT QueryInterface(REFIID iid, void** out) override {
    *out = nullptr;
    if (iid == winrt::IID_IAsyncInfo) *out = static_cast<winrt::IAsyncInfo*>(this);
    else if (iid == IID_IUnknown) *out = static_cast<IAsyncOperation<T>*>(this);
    if (!*out) return E_NOINTERFACE;
    AddRef();
    return S_OK;
  }
  HRESULT put_Completed(IUnknown*) override { return E_NOTIMPL; }
  HRESULT get_Completed(IUnknown**) override { return E_NOTIMPL; }
  HRESULT GetResults(T* out) override {
    inResults.store(true);
    Until([this] { return releaseResults.load(); }, 3000);
    *out = result;
    if (result) result->AddRef();
    return S_OK;
  }
  HRESULT get_Id(UINT32* id) override { *id = 1; return S_OK; }
  HRESULT get_Status(int* value) override { *value = state; return S_OK; }
  HRESULT get_ErrorCode(HRESULT* value) override { *value = E_FAIL; return S_OK; }
  HRESULT Cancel() override { ++cancels; state = 2; return S_OK; }
  HRESULT Close() override { return S_OK; }
};

class Service final : public IGattDeviceService, public winrt::IClosable {
 public:
  FAKE_INSPECTABLE
  int closes = 0;
  HRESULT QueryInterface(REFIID iid, void** out) override {
    *out = nullptr;
    if (iid == winrt::IID_IClosable) *out = static_cast<winrt::IClosable*>(this);
    if (!*out) return E_NOINTERFACE;
    AddRef(); return S_OK;
  }
  HRESULT unused1() override { return E_NOTIMPL; }
  HRESULT unused2() override { return E_NOTIMPL; }
  HRESULT unused3() override { return E_NOTIMPL; }
  HRESULT get_Uuid(GUID* value) override { *value = {}; return S_OK; }
  HRESULT get_AttributeHandle(UINT16* value) override { *value = 10; return S_OK; }
  HRESULT Close() override { ++closes; return S_OK; }
};

class ServiceList final : public IVectorView<IGattDeviceService*> {
 public:
  explicit ServiceList(Service* value) : service(value) {}
  FAKE_INSPECTABLE
  Service* service;
  HRESULT QueryInterface(REFIID, void** out) override { *out = nullptr; return E_NOINTERFACE; }
  HRESULT GetAt(UINT32 index, IGattDeviceService** out) override {
    if (index != 0) return E_INVALIDARG;
    *out = service; service->AddRef(); return S_OK;
  }
  HRESULT get_Size(UINT32* value) override { *value = 1; return S_OK; }
};

class ServicesResult final : public IGattDeviceServicesResult {
 public:
  explicit ServicesResult(ServiceList* value) : list(value) {}
  FAKE_INSPECTABLE
  ServiceList* list;
  HRESULT QueryInterface(REFIID, void** out) override { *out = nullptr; return E_NOINTERFACE; }
  HRESULT get_Status(int* value) override { *value = 0; return S_OK; }
  HRESULT get_ProtocolError(IReference<uint8_t>** value) override { *value = nullptr; return S_OK; }
  HRESULT get_Services(IVectorView<IGattDeviceService*>** value) override {
    *value = list; list->AddRef(); return S_OK;
  }
};

class Session final : public IGattSession, public winrt::IClosable {
 public:
  FAKE_INSPECTABLE
  int maintain = 0, handlers = 0, closes = 0;
  HRESULT QueryInterface(REFIID iid, void** out) override {
    *out = nullptr;
    if (iid == winrt::IID_IClosable) *out = static_cast<winrt::IClosable*>(this);
    if (!*out) return E_NOINTERFACE;
    AddRef(); return S_OK;
  }
  HRESULT unused1() override { return E_NOTIMPL; }
  HRESULT get_CanMaintainConnection(uint8_t* value) override { *value = 1; return S_OK; }
  HRESULT put_MaintainConnection(uint8_t value) override { maintain = value; return S_OK; }
  HRESULT get_MaintainConnection(uint8_t* value) override { *value = maintain; return S_OK; }
  HRESULT get_MaxPduSize(UINT16* value) override { *value = 23; return S_OK; }
  HRESULT get_SessionStatus(int* value) override { *value = 0; return S_OK; }
  HRESULT add_MaxPduSizeChanged(IUnknown*, EventRegistrationToken* token) override {
    ++handlers; token->value = 1; return S_OK;
  }
  HRESULT remove_MaxPduSizeChanged(EventRegistrationToken) override { --handlers; return S_OK; }
  HRESULT add_SessionStatusChanged(IUnknown*, EventRegistrationToken* token) override {
    ++handlers; token->value = 2; return S_OK;
  }
  HRESULT remove_SessionStatusChanged(EventRegistrationToken) override { --handlers; return S_OK; }
  HRESULT Close() override { ++closes; return S_OK; }
};

class SessionFactory final : public IGattSessionStatics {
 public:
  explicit SessionFactory(Operation<IGattSession*>* value) : operation(value) {}
  FAKE_INSPECTABLE
  Operation<IGattSession*>* operation;
  HRESULT QueryInterface(REFIID iid, void** out) override {
    *out = nullptr;
    if (!(iid == IID_IGattSessionStatics)) return E_NOINTERFACE;
    *out = static_cast<IGattSessionStatics*>(this); AddRef(); return S_OK;
  }
  HRESULT FromDeviceIdAsync(IInspectable*, IAsyncOperation<IGattSession*>** out) override {
    *out = operation; operation->AddRef(); operation->requested = true; return S_OK;
  }
};
IUnknown* activationFactory = nullptr;

class Device final : public IBluetoothLEDevice, public IBluetoothLEDevice3,
                     public IBluetoothLEDevice4, public winrt::IClosable {
 public:
  explicit Device(Operation<IGattDeviceServicesResult*>* op) : operation(op) {}
  FAKE_INSPECTABLE
  Operation<IGattDeviceServicesResult*>* operation;
  int closes = 0;
  HRESULT QueryInterface(REFIID iid, void** out) override {
    *out = nullptr;
    if (iid == IID_IBluetoothLEDevice3) *out = static_cast<IBluetoothLEDevice3*>(this);
    else if (iid == IID_IBluetoothLEDevice4 && activationFactory)
      *out = static_cast<IBluetoothLEDevice4*>(this);
    else if (iid == winrt::IID_IClosable) *out = static_cast<winrt::IClosable*>(this);
    if (!*out) return E_NOINTERFACE;
    AddRef(); return S_OK;
  }
  HRESULT unused1() override { return E_NOTIMPL; }
  HRESULT unused2() override { return E_NOTIMPL; }
  HRESULT unused3() override { return E_NOTIMPL; }
  HRESULT unused4() override { return E_NOTIMPL; }
  HRESULT unused5() override { return E_NOTIMPL; }
  HRESULT get_Name(HSTRING*) override { return E_NOTIMPL; }
  HRESULT get_ConnectionStatus(int* out) override { *out = 0; return S_OK; }
  HRESULT get_BluetoothAddress(UINT64* out) override { *out = 1; return S_OK; }
  HRESULT add_GattServicesChanged(IUnknown*, EventRegistrationToken*) override { return S_OK; }
  HRESULT remove_GattServicesChanged(EventRegistrationToken) override { return S_OK; }
  HRESULT add_ConnectionStatusChanged(IUnknown*, EventRegistrationToken*) override { return S_OK; }
  HRESULT remove_ConnectionStatusChanged(EventRegistrationToken) override { return S_OK; }
  HRESULT GetGattServicesWithCacheModeAsync(int,
      IAsyncOperation<IGattDeviceServicesResult*>** out) override {
    *out = operation; operation->AddRef(); operation->requested = true; return S_OK;
  }
  HRESULT get_BluetoothDeviceId(IInspectable** out) override {
    *out = static_cast<IBluetoothLEDevice*>(this); AddRef(); return S_OK;
  }
  HRESULT Close() override { ++closes; return S_OK; }
};

void PendingDiscoveryIsCancelled() {
  Operation<IGattDeviceServicesResult*> operation;
  Device device(&operation);
  device.AddRef();  // WinGatt takes ownership.
  WinGatt gatt(&device);
  std::atomic<bool> done{false};
  int result = kGattSuccess;
  std::thread worker([&] {
    std::vector<Attribute> attributes;
    result = gatt.Discover(&attributes);
    done = true;
  });
  Check(Until([&] { return operation.requested.load(); }), "discovery began");
  gatt.Close();
  bool promptly = Until([&] { return done.load(); }, 1000);
  operation.state = 2;  // Unblock the pre-fix implementation before joining it.
  worker.join();
  Check(promptly && operation.cancels == 1 && result == kGattError,
        "Close cancels pending WinRT discovery promptly");
  Check(device.refs == 1 && operation.refs == 1, "cancelled discovery releases COM ownership");
}

void LateDiscoveryCannotRestoreAttributes() {
  Service service;
  ServiceList list(&service);
  ServicesResult services(&list);
  Operation<IGattDeviceServicesResult*> operation;
  operation.state = 1;
  operation.result = &services;
  operation.releaseResults = false;
  Device device(&operation);
  device.AddRef();
  WinGatt gatt(&device);
  std::vector<Attribute> attributes;
  int result = kGattSuccess;
  std::thread worker([&] { result = gatt.Discover(&attributes); });
  Check(Until([&] { return operation.inResults.load(); }), "discovery result reached barrier");
  gatt.Close();
  operation.releaseResults = true;
  worker.join();
  Check(result == kGattError && attributes.empty() && service.refs == 1 && service.closes == 1,
        "a result racing Close is discarded and its service is closed");
}

void LateConnectReleasesSession() {
  Session session;
  Operation<IGattSession*> operation;
  operation.state = 1;
  operation.result = &session;
  operation.releaseResults = false;
  SessionFactory factory(&operation);
  activationFactory = &factory;
  Device device(nullptr);
  device.AddRef();
  WinGatt gatt(&device);
  HRESULT result = S_OK;
  std::thread worker([&] { int mtu = 0; result = gatt.Connect(3000, &mtu); });
  Check(Until([&] { return operation.inResults.load(); }), "session result reached barrier");
  gatt.Close();
  operation.releaseResults = true;
  worker.join();
  Check(result == E_ABORT && session.maintain == 0 && session.handlers == 0 &&
            session.closes == 1 && session.refs == 1,
        "a session racing Close drops maintain-connection, handlers and COM ownership");
  activationFactory = nullptr;
}

void SecureSocketsRequireBothOptions() {
#if HAVE_SECURITY_HELPER
  options.clear();
  failOption = 0;
  Check(SetRfcommSecurity(1, true) == S_OK && options == std::vector<int>({1, 2}),
        "secure RFCOMM requires authentication and encryption");
  for (int option : {SO_BTH_AUTHENTICATE, SO_BTH_ENCRYPT}) {
    options.clear();
    failOption = option;
    Check(SetRfcommSecurity(1, true) == HRESULT_FROM_WIN32(10013) && options.back() == option,
          "a security-option failure is returned to the caller");
  }
  options.clear();
  Check(SetRfcommSecurity(1, false) == S_OK && options.empty(),
        "insecure RFCOMM leaves security options unchanged");
#endif
}
}  // namespace
}  // namespace gesher::devices::bluetooth

namespace gesher::devices::winrt {
HRESULT GetActivationFactory(const wchar_t*, const IID& iid, void** out) {
  using namespace gesher::devices::bluetooth;
  *out = nullptr;
  return activationFactory ? activationFactory->QueryInterface(iid, out) : E_NOTIMPL;
}
}  // namespace gesher::devices::winrt

int main() {
  using namespace gesher::devices::bluetooth;
  PendingDiscoveryIsCancelled();
  LateDiscoveryCannotRestoreAttributes();
  LateConnectReleasesSession();
  SecureSocketsRequireBothOptions();
  return failures == 0 ? 0 : 1;
}
