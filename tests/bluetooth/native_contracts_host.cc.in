using HRESULT = int32_t;
using ULONG = uint32_t;
using UINT32 = uint32_t;
using UINT64 = uint64_t;
using UINT16 = uint16_t;
using INT16 = int16_t;
using BYTE = uint8_t;
using DWORD = uint32_t;
using ULONGLONG = uint64_t;
using SOCKET = uintptr_t;
#define STDMETHODCALLTYPE
struct GUID { uint32_t Data1; uint16_t Data2, Data3; uint8_t Data4[8]; };
using IID = GUID;
using REFIID = const IID&;
bool operator==(const GUID& a, const GUID& b) { return std::memcmp(&a, &b, sizeof(a)) == 0; }
constexpr IID IID_IUnknown{};
constexpr HRESULT S_OK = 0, E_FAIL = -1, E_POINTER = -2, E_NOINTERFACE = -3,
                  E_ABORT = -4, E_NOTIMPL = -5, E_INVALIDARG = -6;
constexpr int ERROR_TIMEOUT = 1460, SOL_RFCOMM = 3, SO_BTH_AUTHENTICATE = 1,
              SO_BTH_ENCRYPT = 2, SOCKET_ERROR = -1, TRUE = 1;
bool SUCCEEDED(HRESULT hr) { return hr >= 0; }
bool FAILED(HRESULT hr) { return hr < 0; }
HRESULT HRESULT_FROM_WIN32(int error) { return error == 0 ? 0 : -error; }
ULONGLONG GetTickCount64() {
  return std::chrono::duration_cast<std::chrono::milliseconds>(
      std::chrono::steady_clock::now().time_since_epoch()).count();
}
void Sleep(DWORD ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); }
struct IUnknown {
  virtual HRESULT QueryInterface(REFIID, void**) = 0;
  virtual ULONG AddRef() = 0;
  virtual ULONG Release() = 0;
};

namespace gesher::devices::winrt {
using HSTRING = void*;
@WINRT_API@
const IID IID_IAsyncInfo{1, 0, 0, {}};
const IID IID_IClosable{2, 0, 0, {}};
template <typename T> void Release(T*& p) { if (p) { p->Release(); p = nullptr; } }
HRESULT EnsureApartment() { return S_OK; }
HRESULT GetActivationFactory(const wchar_t*, const IID&, void**);
std::wstring StringOf(HSTRING) { return {}; }
void DeleteString(HSTRING) {}
HRESULT Wait(IUnknown* object, int64_t timeout) {
  IAsyncInfo* info = nullptr;
  HRESULT hr = object->QueryInterface(IID_IAsyncInfo, reinterpret_cast<void**>(&info));
  if (FAILED(hr)) return hr;
  const auto start = GetTickCount64();
  for (;;) {
    int state = 0;
    hr = info->get_Status(&state);
    if (FAILED(hr) || state != 0) {
      if (SUCCEEDED(hr)) hr = state == 1 ? S_OK : E_ABORT;
      break;
    }
    if (GetTickCount64() - start >= static_cast<ULONGLONG>(timeout)) {
      info->Cancel();
      hr = HRESULT_FROM_WIN32(ERROR_TIMEOUT);
      break;
    }
    Sleep(1);
  }
  info->Release();
  return hr;
}
}  // namespace gesher::devices::winrt

namespace gesher::devices::bluetooth {
@BLUETOOTH_API@
std::string Utf8(const std::wstring&) { return {}; }
namespace {
using winrt::HSTRING;
