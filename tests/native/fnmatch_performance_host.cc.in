#include <ctype.h>
#include <string.h>
#include <array>
#include <chrono>
#include <clocale>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>
#include "@HEADER@"

@PRODUCTION@
@REFERENCE@

static size_t checks = 0;
static void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "fnmatch check %zu failed: %s\n", checks, message);
    std::exit(1);
  }
}

struct Token {
  char kind = 'l';
  std::array<bool, 256> accepts{};
};

// Tokenization shares only the unchanged bracket parser. Literal, wildcard,
// path/period and prefix matching are independent of the production matcher.
static bool Oracle(const std::string& pattern, const std::string& text, int flags) {
  std::vector<Token> tokens;
  for (size_t i = 0; i < pattern.size();) {
    Token token;
    unsigned char c = static_cast<unsigned char>(pattern[i++]);
    if (c == '*' || c == '?') token.kind = static_cast<char>(c);
    else if (c == '[') {
      const char* expression = pattern.c_str() + i;
      bool literal = false;
      size_t after = i;
      token.kind = '[';
      for (int value = 1; value < 256; ++value) {
        const char* end = expression;
        const int match = production::MatchBracket(&end, value, flags);
        if (match < 0) { literal = true; break; }
        token.accepts[value] = match != 0;
        if (end != expression) after = static_cast<size_t>(end - pattern.c_str());
      }
      if (literal) { token.kind = 'l'; token.accepts['['] = true; }
      else i = after;
    } else {
      if (c == '\\' && !(flags & FNM_NOESCAPE) && i < pattern.size())
        c = static_cast<unsigned char>(pattern[i++]);
      for (int value = 1; value < 256; ++value)
        token.accepts[value] = (flags & FNM_CASEFOLD) ? tolower(c) == tolower(value) : c == value;
    }
    tokens.push_back(token);
  }
  const size_t width = text.size() + 1;
  std::vector<bool> reachable((tokens.size() + 1) * width, false);
  reachable[0] = true;
  for (size_t t = 0; t < tokens.size(); ++t) {
    const auto& token = tokens[t];
    for (size_t s = 0; s <= text.size(); ++s) {
      if (!reachable[t * width + s]) continue;
      const bool at_end = s == text.size();
      const unsigned char c = at_end ? 0 : static_cast<unsigned char>(text[s]);
      const bool forbidden = ((flags & FNM_PATHNAME) && c == '/') ||
          ((flags & FNM_PERIOD) && c == '.' &&
           (s == 0 || ((flags & FNM_PATHNAME) && text[s - 1] == '/')));
      if (token.kind == '*') {
        // FNM_PERIOD forbids even the zero-width transition at a leading dot.
        if (!((flags & FNM_PERIOD) && c == '.' &&
              (s == 0 || ((flags & FNM_PATHNAME) && text[s - 1] == '/')))) {
          reachable[(t + 1) * width + s] = true;
          if (!at_end && !forbidden) reachable[t * width + s + 1] = true;
        }
      } else if (!at_end &&
                 (token.kind == 'l' ? token.accepts[c] :
                  !forbidden && (token.kind == '?' || token.accepts[c]))) {
        reachable[(t + 1) * width + s + 1] = true;
      }
    }
  }
  for (size_t s = 0; s <= text.size(); ++s)
    if (reachable[tokens.size() * width + s] &&
        (s == text.size() || ((flags & FNM_LEADING_DIR) && text[s] == '/'))) return true;
  return false;
}

static void Compare(const std::string& pattern, const std::string& text, int flags) {
  const bool actual = production::Fnmatch(pattern.c_str(), text.c_str(), flags) == 0;
  const bool expected = Oracle(pattern, text, flags);
  if (actual != expected) {
    std::fprintf(stderr, "oracle mismatch pattern=[%s] text=[%s] flags=%d actual=%d expected=%d\n",
                 pattern.c_str(), text.c_str(), flags, actual, expected);
    Check(false, "dynamic-programming oracle");
  }
  ++checks;
#if @HAS_REFERENCE@
  const bool reference_result = reference::Fnmatch(pattern.c_str(), text.c_str(), flags) == 0;
  Check(actual == reference_result, "previous-source differential");
#endif
}

static void Generate(const std::string& alphabet, unsigned depth, std::string value,
                     std::vector<std::string>* results) {
  results->push_back(value);
  if (!depth) return;
  for (char c : alphabet) Generate(alphabet, depth - 1, value + c, results);
}
static uint32_t state = 0x48b33c2d;
static uint32_t Random() {
  state ^= state << 13;
  state ^= state >> 17;
  state ^= state << 5;
  return state;
}

int main(int argc, char** argv) {
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  std::setlocale(LC_ALL, "C");
  std::vector<std::string> patterns, texts;
  Generate("ab*?", 5, "", &patterns);
  Generate("ab", 5, "", &texts);
  for (const auto& pattern : patterns)
    for (const auto& text : texts) Compare(pattern, text, 0);

  static const char* pieces[] = {"a", "b", "A", ".", "/", "*", "?", "**", "\\*", "\\?",
      "\\/", "\\", "[a-z]", "[!ab]", "[^A]", "[[:digit:]]", "[[:upper:]]", "[a/]",
      "[", "[]", "[]a]", "[z-a]", "[[:oops:]]", "[\\]]", "[-a]", "[a-]", "[a\\-z]", "\x80"};
  static const char characters[] = "aAb09./*?[]\\-\x80";
  for (unsigned sample = 0; sample < 6500; ++sample) {
    std::string pattern, text;
    for (unsigned n = Random() % 9; n; --n) pattern += pieces[Random() % std::size(pieces)];
    for (unsigned n = Random() % 15; n; --n) text += characters[Random() % (sizeof(characters) - 1)];
    for (int flags = 0; flags < 32; ++flags) Compare(pattern, text, flags);
  }
  // More targeted cases exercise nonzero-width successful bracket/star paths.
  for (const auto& pattern : {"*[a-z]*a", "*/[!a]*", "*\\**?", "*/.*", "a*/*b", "*a*b*", "*[[:digit:]]*"})
    for (const auto& text : {"a", "ab", "zba", "a/b", "a/.b", ".a", "ab9a", "a*bb", "a/9a"})
      for (int flags = 0; flags < 32; ++flags) Compare(pattern, text, flags);

  std::string long_pattern, long_text;
  for (int i = 0; i < 256; ++i) { long_pattern += "*a/"; long_text += "a/"; }
  long_pattern += 'z';
  long_text += 'z';
  production::work = 0;
  const bool deep_match = production::Fnmatch(long_pattern.c_str(), long_text.c_str(), FNM_PATHNAME) == 0;
  std::printf("fnmatch 256-star path match=%d match_steps=%zu\n", deep_match, production::work);
  if (enforce) Check(deep_match, "valid patterns may exceed 64 stars");

  std::string hostile;
  for (int i = 0; i < 8; ++i) hostile += "*a";
  hostile += 'b';
  for (size_t length : {12, 16, 20, 24}) {
    std::string input(length, 'a');
    input += 'c';
    production::work = 0;
    const auto start = std::chrono::steady_clock::now();
    const int result = production::Fnmatch(hostile.c_str(), input.c_str(), FNM_CASEFOLD);
    const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
        std::chrono::steady_clock::now() - start).count();
    Check(result == FNM_NOMATCH, "hostile nonmatch");
    std::printf("fnmatch hostile bytes=%zu match_steps=%zu elapsed_us=%lld\n", input.size(),
                production::work, static_cast<long long>(elapsed));
    if (enforce) Check(production::work <= (hostile.size() + 1) * (input.size() + 1), "bounded suffix retry work");
  }
  std::printf("fnmatch matching contracts: %zu PASS\n", checks);
}
