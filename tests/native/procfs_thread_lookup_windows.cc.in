#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <tlhelp32.h>
#include <algorithm>
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

static size_t snapshots = 0;
static size_t opens = 0;
HANDLE CountSnapshot(DWORD flags, DWORD pid) {
  ++snapshots;
  return CreateToolhelp32Snapshot(flags, pid);
}
HANDLE CountOpenThread(DWORD access, BOOL inherit, DWORD tid) {
  ++opens;
  return OpenThread(access, inherit, tid);
}
#define CreateToolhelp32Snapshot CountSnapshot
#define OpenThread CountOpenThread
@IMPLEMENTATION@
#undef CreateToolhelp32Snapshot
#undef OpenThread

static unsigned checks = 0;
static void Check(bool ok, const char* context = "") {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "procfs thread check %u failed, Win32=%lu: %s\n", checks, GetLastError(), context);
    std::exit(1);
  }
}
DWORD WINAPI Wait(void* event) {
  WaitForSingleObject(static_cast<HANDLE>(event), INFINITE);
  return STILL_ACTIVE;  // An exit code alone cannot distinguish a live thread.
}
DWORD WINAPI Exit(void*) { return STILL_ACTIVE; }

struct TokenState {
  bool present = false;
  LUID id{};
  std::vector<LUID_AND_ATTRIBUTES> privileges;
};
static TokenState ReadToken(HANDLE token) {
  TokenState state;
  TOKEN_STATISTICS statistics{};
  DWORD size = 0;
  Check(GetTokenInformation(token, TokenStatistics, &statistics, sizeof(statistics), &size), "read token identity");
  state.present = true;
  state.id = statistics.TokenId;
  Check(!GetTokenInformation(token, TokenPrivileges, nullptr, 0, &size) &&
        GetLastError() == ERROR_INSUFFICIENT_BUFFER, "size token privilege list");
  std::vector<unsigned char> bytes(size);
  Check(GetTokenInformation(token, TokenPrivileges, bytes.data(), size, &size), "read token privileges");
  const auto* privileges = reinterpret_cast<const TOKEN_PRIVILEGES*>(bytes.data());
  state.privileges.assign(privileges->Privileges, privileges->Privileges + privileges->PrivilegeCount);
  return state;
}
static TokenState ThreadToken() {
  HANDLE token = nullptr;
  if (!OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token)) {
    Check(GetLastError() == ERROR_NO_TOKEN, "query optional thread token");
    return {};
  }
  auto state = ReadToken(token);
  Check(CloseHandle(token), "close thread token query");
  return state;
}
static bool SameToken(const TokenState& a, const TokenState& b) {
  if (a.present != b.present) return false;
  if (!a.present) return true;
  return a.id.LowPart == b.id.LowPart && a.id.HighPart == b.id.HighPart &&
         a.privileges.size() == b.privileges.size() &&
         std::equal(a.privileges.begin(), a.privileges.end(), b.privileges.begin(),
                    [](const auto& x, const auto& y) {
                      return x.Luid.LowPart == y.Luid.LowPart && x.Luid.HighPart == y.Luid.HighPart &&
                             x.Attributes == y.Attributes;
                    });
}
static bool DebugEnabled(const TokenState& state, const LUID& debug) {
  for (const auto& privilege : state.privileges)
    if (privilege.Luid.LowPart == debug.LowPart && privilege.Luid.HighPart == debug.HighPart)
      return (privilege.Attributes & SE_PRIVILEGE_ENABLED) != 0;
  return false;
}

// Hosted runners may enable SeDebugPrivilege, which explicitly bypasses a
// thread DACL in OpenThread. Test denial with an unprivileged duplicate for
// this thread only, preserving any previous impersonation token exactly.
class ScopedUnprivilegedThread {
 public:
  explicit ScopedUnprivilegedThread(const LUID& debug) {
    HANDLE source = nullptr;
    if (OpenThreadToken(GetCurrentThread(), TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_IMPERSONATE, TRUE, &previous_)) {
      source = previous_;
    } else {
      Check(GetLastError() == ERROR_NO_TOKEN, "open previous impersonation token");
      Check(OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &source), "open process token for duplicate");
    }
    const auto before = ReadToken(source);
    Check(DuplicateTokenEx(source, TOKEN_QUERY | TOKEN_ADJUST_PRIVILEGES | TOKEN_IMPERSONATE,
                           nullptr, SecurityImpersonation, TokenImpersonation, &restricted_), "duplicate scoped thread token");
    if (source != previous_) Check(CloseHandle(source), "close process token duplicate source");
    SetLastError(ERROR_SUCCESS);
    Check(AdjustTokenPrivileges(restricted_, TRUE, nullptr, 0, nullptr, nullptr) &&
          GetLastError() == ERROR_SUCCESS, "disable privileges only in duplicate");
    const auto after = ReadToken(restricted_);
    Check(std::none_of(after.privileges.begin(), after.privileges.end(), [](const auto& privilege) {
      return (privilege.Attributes & SE_PRIVILEGE_ENABLED) != 0;
    }), "scoped token contains no enabled privilege");
    const bool debug_before = DebugEnabled(before, debug), debug_after = DebugEnabled(after, debug);
    std::printf("procfs DACL token debug_enabled_before=%d debug_enabled_after=%d\n", debug_before, debug_after);
    Check(SetThreadToken(nullptr, restricted_), "apply scoped unprivileged token");
  }
  ~ScopedUnprivilegedThread() {
    Check(SetThreadToken(nullptr, previous_), "restore previous thread token");
    Check(CloseHandle(restricted_), "close scoped token");
    if (previous_) Check(CloseHandle(previous_), "close saved previous token handle");
  }
  ScopedUnprivilegedThread(const ScopedUnprivilegedThread&) = delete;
  ScopedUnprivilegedThread& operator=(const ScopedUnprivilegedThread&) = delete;

 private:
  HANDLE previous_ = nullptr, restricted_ = nullptr;
};

static void CheckDeniedThread(DWORD tid, bool alive) {
  HANDLE process_token = nullptr;
  Check(OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &process_token), "observe original process token");
  const auto process_before = ReadToken(process_token), thread_before = ThreadToken();
  // Resolve once before the handle baseline: the first privilege-name lookup
  // can initialize the system's cached LSA/RPC connection.
  static const LUID debug = [] {
    LUID value{};
    Check(LookupPrivilegeValueW(nullptr, L"SeDebugPrivilege", &value), "resolve debug privilege identity");
    return value;
  }();
  std::printf("procfs DACL process debug_enabled=%d\n", DebugEnabled(process_before, debug));
  DWORD handles_before = 0, handles_after = 0;
  Check(GetProcessHandleCount(GetCurrentProcess(), &handles_before), "handles before scoped token");
  {
    ScopedUnprivilegedThread scope(debug);
    const auto outer_token = ThreadToken();
    {
      ScopedUnprivilegedThread nested(debug);
      Check(!SameToken(ThreadToken(), outer_token), "nested scope has a separate token identity");
    }
    Check(SameToken(ThreadToken(), outer_token), "nested scope restores outer token identity and privileges");
    SetLastError(ERROR_SUCCESS);
    HANDLE query = OpenThread(THREAD_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE, tid);
    const DWORD error = query == nullptr ? GetLastError() : ERROR_SUCCESS;
    if (query != nullptr) Check(CloseHandle(query), "close unexpectedly granted query handle");
    std::printf("procfs DACL lookup alive=%d denied=%d Win32=%lu\n", alive, query == nullptr, error);
    Check(query == nullptr && error == ERROR_ACCESS_DENIED, "empty DACL must deny unprivileged OpenThread");
    const size_t snapshots_before = snapshots;
    Check(IsOwnThread(tid) == alive, "DACL fallback preserves live/dead task membership");
    Check(snapshots == snapshots_before + 1, "access denial uses the production snapshot fallback");
  }
  Check(SameToken(ThreadToken(), thread_before), "restore original thread token identity and privileges");
  Check(SameToken(ReadToken(process_token), process_before), "process token identity and privileges remain unchanged");
  Check(GetProcessHandleCount(GetCurrentProcess(), &handles_after), "handles after scoped token");
  std::printf("procfs DACL handles before=%lu after=%lu\n", handles_before, handles_after);
  Check(handles_before == handles_after, "scoped tokens do not leak handles");
  Check(CloseHandle(process_token), "close process token observer");
}

int main(int argc, char** argv) {
  if (argc > 1 && std::strcmp(argv[1], "child") == 0) {
    Sleep(30000);
    return 0;
  }
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  HANDLE event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
  Check(event != nullptr);
  DWORD tid = 0;
  HANDLE thread = CreateThread(nullptr, 0, Wait, event, 0, &tid);
  Check(thread != nullptr);
  const DWORD current = GetCurrentThreadId();
  Check(IsOwnThread(current));
  Check(IsOwnThread(tid));
  Check(!IsOwnThread(0));
  Check(!IsOwnThread(0xffffffff));
  // Enumeration must still find an own thread whose DACL denies OpenThread.
  ACL denied_acl;
  SECURITY_DESCRIPTOR security;
  Check(InitializeAcl(&denied_acl, sizeof(denied_acl), ACL_REVISION));
  Check(InitializeSecurityDescriptor(&security, SECURITY_DESCRIPTOR_REVISION));
  Check(SetSecurityDescriptorDacl(&security, TRUE, &denied_acl, FALSE));
  SECURITY_ATTRIBUTES attributes = {sizeof(attributes), &security, FALSE};
  DWORD denied_tid = 0;
  HANDLE denied = CreateThread(&attributes, 0, Wait, event, 0, &denied_tid);
  Check(denied != nullptr);
  CheckDeniedThread(denied_tid, true);
  auto ids = ThreadIds();
  Check(std::is_sorted(ids.begin(), ids.end()));
  Check(std::find(ids.begin(), ids.end(), current) != ids.end());
  Check(std::find(ids.begin(), ids.end(), tid) != ids.end());

  wchar_t executable[32768];
  Check(GetModuleFileNameW(nullptr, executable, 32768) != 0);
  wchar_t command[] = L"procfs-fixture child";
  STARTUPINFOW startup = {};
  startup.cb = sizeof(startup);
  PROCESS_INFORMATION foreign = {};
  Check(CreateProcessW(executable, command, nullptr, nullptr, FALSE, CREATE_NO_WINDOW,
                       nullptr, nullptr, &startup, &foreign));
  Check(!IsOwnThread(foreign.dwThreadId));
  DWORD dead_tid = 0;
  HANDLE dead = CreateThread(nullptr, 0, Exit, nullptr, 0, &dead_tid);
  Check(dead != nullptr);
  Check(WaitForSingleObject(dead, 5000) == WAIT_OBJECT_0);
  DWORD code = 0;
  Check(GetExitCodeThread(dead, &code) && code == STILL_ACTIVE);
  // The retained thread HANDLE keeps its ID and owner valid after exit.
  Check(GetProcessIdOfThread(dead) == GetCurrentProcessId());
  Check(!IsOwnThread(dead_tid));

  DWORD handles_before = 0, handles_after = 0;
  Check(GetProcessHandleCount(GetCurrentProcess(), &handles_before));
  snapshots = 0;
  opens = 0;
  const auto start = std::chrono::steady_clock::now();
  for (int i = 0; i < 128; ++i) {
    Check(IsOwnThread(current));
    Check(IsOwnThread(tid));
    Check(!IsOwnThread(dead_tid));
    Check(!IsOwnThread(foreign.dwThreadId));
  }
  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
      std::chrono::steady_clock::now() - start).count();
  std::printf("procfs task lookups=512 snapshots=%zu OpenThread=%zu elapsed_us=%lld\n",
              snapshots, opens, static_cast<long long>(elapsed));
  if (enforce) {
    Check(snapshots == 0);
    Check(opens == 384);
  }
  Check(GetProcessHandleCount(GetCurrentProcess(), &handles_after));
  Check(handles_after == handles_before);
  Check(TerminateProcess(foreign.hProcess, 0));
  Check(WaitForSingleObject(foreign.hProcess, 5000) == WAIT_OBJECT_0);
  CloseHandle(foreign.hProcess);
  CloseHandle(foreign.hThread);
  Check(SetEvent(event));
  Check(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0);
  Check(WaitForSingleObject(denied, 5000) == WAIT_OBJECT_0);
  CheckDeniedThread(denied_tid, false);
  CloseHandle(dead);
  CloseHandle(denied);
  CloseHandle(thread);
  CloseHandle(event);
  std::printf("procfs thread contracts: %u PASS\n", checks);
}
