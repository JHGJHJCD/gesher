// The two production ABI adapters and timeout branches are inserted verbatim.
// Only the Windows socket boundary is replaced: it uses real local Linux
// sockets, with an explicit 32-bit intermediate timeval and millisecond API.
#include "shim_internal.h"
#include <algorithm>
#include <cerrno>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <dlfcn.h>
#include <sys/socket.h>
#include <sys/time.h>

static int failures;
static void check(const char* what, bool ok) {
  std::printf("%-78s %s\n", what, ok ? "ok" : "FAIL");
  if (!ok) ++failures;
}
namespace timeout_transport {
struct timeval { int32_t tv_sec, tv_usec; };
static_assert(sizeof(timeval) == 8);
struct SocketFd { int socket; };
static bool Lookup(int fd, SocketFd* state) {
  int type;
  socklen_t length = sizeof(type);
  if (::getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) != 0) return false;
  state->socket = fd;
  return true;
}
namespace ws {
enum class Option { kRcvTimeo, kSndTimeo };
static int last_milliseconds;
static int SetOption(int fd, Option option, int milliseconds) {
  last_milliseconds = milliseconds;
  ::timeval tv{milliseconds / 1000, (milliseconds % 1000) * 1000};
  return ::setsockopt(fd, SOL_SOCKET, option == Option::kRcvTimeo ? SO_RCVTIMEO : SO_SNDTIMEO,
                      &tv, sizeof(tv));
}
static int GetOption(int fd, Option option, int* milliseconds) {
  ::timeval tv{};
  socklen_t length = sizeof(tv);
  if (::getsockopt(fd, SOL_SOCKET, option == Option::kRcvTimeo ? SO_RCVTIMEO : SO_SNDTIMEO,
                   &tv, &length) != 0) return -1;
  // Linux can round the maximum millisecond value up to its next clock tick.
  *milliseconds = static_cast<int>(std::min<int64_t>(INT32_MAX, tv.tv_sec * 1000 + tv.tv_usec / 1000));
  return 0;
}
}
static int setsockopt(int fd, int level, int name, const void* value, socklen_t len) {
@HOST_SET_PROLOGUE@
@HOST_SET_TIMEOUT@
  return ::setsockopt(fd, level, name, value, len);
}
static int getsockopt(int fd, int level, int name, void* value, socklen_t* len) {
@HOST_GET_PROLOGUE@
  int v;
@HOST_GET_TIMEOUT@
  return ::getsockopt(fd, level, name, value, len);
}
}
namespace gesher::bionic {
namespace {
using timeout_transport::timeval;
using timeout_transport::setsockopt;
using timeout_transport::getsockopt;
@TIMEVAL_TYPE@
@TIMEOUT_ADAPTERS@
}
void RegisterTimeoutContracts(SymbolTable& table) {
#define E(name, fn) table[name] = reinterpret_cast<void*>(&fn)
@TIMEOUT_REGISTRATIONS@
#undef E
}
}
static void* timeout_symbol(void*, const char* name) {
  static gesher::bionic::SymbolTable table = [] {
    gesher::bionic::SymbolTable result;
    gesher::bionic::RegisterTimeoutContracts(result);
    return result;
  }();
  auto found = table.find(name);
  return found == table.end() ? nullptr : found->second;
}
#define dlsym timeout_symbol
#include "socket_timeout_contract_test.inc"
#undef dlsym

static void host_boundaries() {
  auto set = reinterpret_cast<socket_timeout_set_fn>(timeout_symbol(nullptr, "setsockopt"));
  auto get = reinterpret_cast<socket_timeout_get_fn>(timeout_symbol(nullptr, "getsockopt"));
  int fd = socket(AF_INET, SOCK_STREAM, 0);
  check("socket timeout: host boundary socket", fd >= 0);
  if (fd < 0) return;
  const int64_t seconds[] = {INT64_C(1) << 32, INT64_MAX};
  for (int64_t value : seconds) {
    socket_timeout_value tv{value, 999999};
    check("socket timeout: positive overflow saturates the Windows millisecond limit",
          set(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) == 0 &&
          timeout_transport::ws::last_milliseconds == INT32_MAX);
  }
  // Linux accepts negative seconds as an immediate timeout; Gesher's host
  // currently rejects them. Preserve that explicit limitation without wrapping.
  const int64_t negative_seconds[] = {-1, -(INT64_C(1) << 32), INT64_MIN};
  for (int64_t value : negative_seconds) {
    socket_timeout_value tv{value, 0};
    errno = 0;
    check("socket timeout: negative seconds retain the host's domain error",
          set(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) == -1 && errno == EDOM);
  }
  socket_timeout_value tv{};
  errno = 0;
  check("socket timeout: short guest buffer stays EINVAL", set(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, 8) == -1 && errno == EINVAL);
  errno = 0;
  check("socket timeout: null guest buffer stays EINVAL", set(fd, SOL_SOCKET, SO_RCVTIMEO, nullptr, sizeof(tv)) == -1 && errno == EINVAL);
  uint32_t length = 8;
  errno = 0;
  check("socket timeout: short output buffer stays EINVAL", get(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, &length) == -1 && errno == EINVAL);
  close(fd);
}
int main() {
  test_socket_timeout_contracts();
  host_boundaries();
  std::printf("socket timeout contracts: %d failure(s)\n", failures);
  return failures != 0;
}
