#ifdef _WIN32
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#else
using HANDLE = void*;
using DWORD = unsigned long;
using BOOL = int;
#endif
#include <algorithm>
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <new>
#include <thread>
#include <vector>

static bool tracking = false;
static size_t allocations = 0, allocated_bytes = 0;
void* operator new(size_t n) {
  if (tracking) { ++allocations; allocated_bytes += n; }
  if (void* p = std::malloc(n ? n : 1)) return p;
  std::abort();
}
void* operator new[](size_t n) { return ::operator new(n); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }

static std::vector<uint8_t> observed;
static size_t calls = 0;
static const void* first_write = nullptr;
static DWORD chunk = std::numeric_limits<DWORD>::max();
static size_t fail_at = SIZE_MAX, zero_at = SIZE_MAX;
static bool native = false;
static BOOL FixtureWriteFile(HANDLE pipe, const void* data, DWORD n, DWORD* written, void* overlapped) {
#ifdef _WIN32
  if (native) return ::WriteFile(pipe, data, n, written, static_cast<OVERLAPPED*>(overlapped));
#else
  (void)pipe;
  (void)overlapped;
  (void)native;
#endif
  const size_t call = calls++;
  if (call == 0) first_write = data;
  *written = 0;
  if (call == fail_at) return 0;
  if (call == zero_at) return 1;
  *written = std::min(n, chunk);
  const auto* bytes = static_cast<const uint8_t*>(data);
  observed.insert(observed.end(), bytes, bytes + *written);
  return 1;
}

@OUTPUT@
#define WriteFile FixtureWriteFile
@WRITE@
@SEND@
#undef WriteFile

static size_t checks = 0;
static void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "Binder reply check %zu failed: %s\n", checks, message);
    std::exit(1);
  }
}
static void Reset(size_t size) {
  observed.clear();
  observed.reserve(size);
  calls = 0;
  first_write = nullptr;
  chunk = std::numeric_limits<DWORD>::max();
  fail_at = zero_at = SIZE_MAX;
}
static std::vector<uint8_t> Frame(const std::vector<uint8_t>& payload) {
  std::vector<uint8_t> expected(4 + payload.size());
  const uint32_t length = static_cast<uint32_t>(payload.size());
  std::memcpy(expected.data(), &length, 4);
  if (!payload.empty()) std::memcpy(expected.data() + 4, payload.data(), payload.size());
  return expected;
}

#ifdef _WIN32
static bool ReadAll(HANDLE pipe, void* output, DWORD size) {
  auto* bytes = static_cast<uint8_t*>(output);
  while (size) {
    DWORD got = 0;
    if (!::ReadFile(pipe, bytes, size, &got, nullptr) || got == 0) return false;
    size -= got;
    bytes += got;
  }
  return true;
}
static void NativeRoundTrip(WireReply& reply, const std::vector<uint8_t>& expected) {
  HANDLE read = nullptr, write = nullptr;
  Check(CreatePipe(&read, &write, nullptr, 0), "create real byte-stream pipe");
  std::atomic<bool> valid{false};
  std::thread receiver([&] {
    uint32_t size = 0;
    if (ReadAll(read, &size, 4) && size == expected.size() - 4) {
      std::vector<uint8_t> payload(size);
      valid = ReadAll(read, payload.data(), size) &&
              std::equal(payload.begin(), payload.end(), expected.begin() + 4);
    }
    CloseHandle(read);
  });
  native = true;
  const bool sent = WriteMessage(write, reply);
  native = false;
  CloseHandle(write);
  receiver.join();
  Check(sent && valid, "real pipe length and payload round trip");
}
#endif

int main(int argc, char** argv) {
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  for (size_t size : {size_t(0), size_t(1), size_t(4), size_t(16), size_t(28), size_t(29),
                     size_t(32), size_t(256), size_t(4096), size_t(1048583), size_t(4194304)}) {
    std::vector<uint8_t> payload(size);
    for (size_t i = 0; i < size; ++i) payload[i] = static_cast<uint8_t>((i * 71) ^ (i >> 8));
    WireReply reply;
    reply.Write(payload.data(), payload.size());
    const auto expected = Frame(payload);
    Reset(expected.size());
    allocations = allocated_bytes = 0;
    tracking = true;
    const bool sent = WriteMessage(nullptr, reply);
    tracking = false;
    Check(sent, "complete stream write");
    Check(observed == expected, "exact wire bytes");
    Check(calls == 1, "single write for complete stream");
    std::printf("Binder payload=%zu send_allocations=%zu send_bytes=%zu\n", size, allocations, allocated_bytes);
    if (enforce) {
      Check(allocations == 0, "sending must not allocate/copy another payload");
      Check(first_write == reply.bytes.data(), "write directly from owned reply storage");
    }
    // Prefix mutation must permit a safe retry of the same complete reply.
    Reset(expected.size());
    Check(WriteMessage(nullptr, reply) && observed == expected, "repeat send");
    if (size <= 4096) {
      Reset(expected.size());
      chunk = 3;
      Check(WriteMessage(nullptr, reply) && observed == expected, "partial stream writes");
      for (size_t failed_call : {size_t(0), size_t(1)}) {
        Reset(expected.size());
        chunk = 3;
        fail_at = failed_call;
        Check(!WriteMessage(nullptr, reply), "injected stream failure");
        Check(observed.size() == 3 * failed_call, "no bytes after failed write");
        Reset(expected.size());
        chunk = 3;
        zero_at = failed_call;
        Check(!WriteMessage(nullptr, reply), "zero-byte write terminates");
        Check(observed.size() == 3 * failed_call, "no bytes after zero-byte write");
      }
    }
#ifdef _WIN32
    NativeRoundTrip(reply, expected);
#endif
  }
  // Nested Out command streams remain unframed, including command replacement.
  Out commands;
  commands.Put<uint32_t>(0x12345678);
  commands.Put<uint64_t>(0x0102030405060708ULL);
  Check(commands.bytes.size() == 12, "nested command size has no prefix");
  const uint32_t replacement = 0xabcdef01;
  std::memcpy(commands.bytes.data(), &replacement, 4);
  WireReply metadata;
  metadata.Put<int32_t>(-9);
  metadata.Put<uint32_t>(17);
  metadata.Write(commands.bytes.data(), commands.bytes.size());
  std::vector<uint8_t> payload(8);
  const int32_t result = -9;
  const uint32_t consumed = 17;
  std::memcpy(payload.data(), &result, 4);
  std::memcpy(payload.data() + 4, &consumed, 4);
  payload.insert(payload.end(), commands.bytes.begin(), commands.bytes.end());
  Reset(payload.size() + 4);
  Check(WriteMessage(nullptr, metadata) && observed == Frame(payload), "nested command reply framing");
  std::printf("Binder reply contracts: %zu PASS\n", checks);
}
