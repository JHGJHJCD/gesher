// Extracted production helpers; controlled Win32/JNI/allocation boundaries.
#include <algorithm>
#include <array>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <new>
#include <string>
#include <vector>

bool forbid_new = false;
void* operator new(std::size_t size) {
  if (forbid_new || size > 2 * 1024 * 1024) {
    std::fprintf(stderr, "FAIL Debug memory: forbidden throwing/unbounded C++ allocation (%zu bytes)\n", size);
    std::exit(101);
  }
  if (void* p = std::malloc(size ? size : 1)) return p;
  std::exit(102);
}
void* operator new[](std::size_t size) { return ::operator new(size); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, std::size_t) noexcept { std::free(p); }
void operator delete[](void* p, std::size_t) noexcept { std::free(p); }

using DWORD = uint32_t;
using ULONG_PTR = uintptr_t;
using SIZE_T = size_t;
using HANDLE = void*;
using PVOID = void*;
using BOOL = int;
using jint = int32_t;
using jlong = int64_t;
using jsize = int32_t;
using jobject = void*;
using jclass = void*;
using jmethodID = void*;
using jfieldID = void*;
#define WINAPI
constexpr BOOL FALSE = 0;
constexpr DWORD PROCESS_QUERY_INFORMATION = 0x400;
constexpr DWORD PROCESS_VM_READ = 0x10;
constexpr DWORD ERROR_BAD_LENGTH = 24;
struct SYSTEM_INFO { DWORD dwPageSize; };
struct LongArray { std::array<jlong, 32> values{}; jsize length = 27; };
using jlongArray = LongArray*;

int checks = 0, failures = 0;
void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) { ++failures; std::printf("FAIL Debug memory: %s\n", message); }
}

struct JNIEnv {
  bool pending = false;
  int operations = 0, fail_at = 0, illegal_calls = 0, deleted = 0;
  jlong total = 32 * 1024, available = 8 * 1024;
  enum Error { NONE, NULL_POINTER, RUNTIME } error = NONE;
  bool Enter() {
    if (pending) { ++illegal_calls; return false; }
    if (++operations == fail_at) { pending = true; return false; }
    return true;
  }
  jclass FindClass(const char*) { return Enter() ? reinterpret_cast<void*>(1) : nullptr; }
  jmethodID GetStaticMethodID(jclass, const char*, const char*) {
    return Enter() ? reinterpret_cast<void*>(2) : nullptr;
  }
  jmethodID GetMethodID(jclass, const char* name, const char*) {
    return Enter() ? reinterpret_cast<void*>(std::strcmp(name, "totalMemory") == 0 ? 3 : 4) : nullptr;
  }
  jobject CallStaticObjectMethod(jclass, jmethodID) {
    return Enter() ? reinterpret_cast<void*>(5) : nullptr;
  }
  jlong CallLongMethod(jobject, jmethodID id) {
    if (!Enter()) return 0;
    return id == reinterpret_cast<void*>(3) ? total : available;
  }
  bool ExceptionCheck() { return pending; }
  void ExceptionClear() { pending = false; }
  void DeleteLocalRef(jobject object) { if (object != nullptr) ++deleted; }
  jfieldID GetFieldID(jclass, const char* name, const char* type) {
    if (!Enter()) return nullptr;
    Check(std::strlen(name) < 32 && std::strcmp(type, "I") == 0, "bounded category field signature");
    return reinterpret_cast<void*>(6);
  }
  jsize GetArrayLength(jlongArray out) { Check(!pending, "array read without a pending JNI exception"); return out->length; }
  void SetLongArrayRegion(jlongArray out, jsize start, jsize count, const jlong* values) {
    Check(!pending && start >= 0 && count >= 0 && start + count <= out->length,
          "system counter publication respects JNI bounds");
    if (start >= 0 && count >= 0 && start + count <= out->length)
      std::copy(values, values + count, out->values.begin() + start);
  }
};
void jniThrowNullPointerException(JNIEnv* env, const char*) { env->pending = true; env->error = JNIEnv::NULL_POINTER; }
void jniThrowRuntimeException(JNIEnv* env, const char*) { env->pending = true; env->error = JNIEnv::RUNTIME; }

const HANDLE kSelf = reinterpret_cast<HANDLE>(uintptr_t{0x100});
const HANDLE kOther = reinterpret_cast<HANDLE>(uintptr_t{0x200});
DWORD page_size = 4096, last_error = 0;
int opens = 0, closes = 0, queries = 0, allocations = 0, reallocations = 0, frees = 0;
size_t allocated_bytes = 0, last_reallocation = 0;
bool fail_malloc = false, fail_realloc = false, query_error = false, invalid_count = false;
bool grow_forever = false, performance_error = false;
ULONG_PTR grow_required = 0;
std::array<ULONG_PTR, 8> page_flags{};
size_t page_count = 0;

DWORD GetCurrentProcessId() { return 123; }
HANDLE GetCurrentProcess() { return kSelf; }
HANDLE OpenProcess(DWORD rights, BOOL inherit, DWORD pid) {
  Check(rights == (PROCESS_QUERY_INFORMATION | PROCESS_VM_READ) && inherit == FALSE && pid == 456,
        "foreign memory reads request only required rights");
  ++opens;
  return kOther;
}
BOOL CloseHandle(HANDLE handle) { Check(handle == kOther, "only owned process handles are closed"); ++closes; return 1; }
void GetSystemInfo(SYSTEM_INFO* info) { info->dwPageSize = page_size; }
DWORD GetLastError() { return last_error; }

void* SampleMalloc(size_t size) {
  ++allocations;
  Check(size <= 64 * 1024 * 1024, "initial snapshot stays within the sampling budget");
  if (fail_malloc) return nullptr;
  void* p = std::malloc(size);
  if (p) allocated_bytes = size;
  return p;
}
void* SampleRealloc(void* p, size_t size) {
  ++reallocations;
  last_reallocation = size;
  Check(size <= 64 * 1024 * 1024, "growth stays within the sampling budget");
  if (fail_realloc) return nullptr;
  void* result = std::realloc(p, size);
  if (result) allocated_bytes = size;
  return result;
}
void SampleFree(void* p) { if (p) { ++frees; allocated_bytes = 0; } std::free(p); }

BOOL MockWorkingSet(HANDLE process, PVOID data, DWORD bytes) {
  Check(process == kSelf || process == kOther, "queries the selected process");
  Check(bytes >= sizeof(ULONG_PTR) && bytes % sizeof(ULONG_PTR) == 0,
        "DWORD byte capacity includes the entry count");
  ++queries;
  auto* words = static_cast<ULONG_PTR*>(data);
  size_t capacity = bytes / sizeof(ULONG_PTR);
  if (query_error) { last_error = 5; return 0; }
  if (grow_forever || (grow_required && queries == 1)) {
    words[0] = grow_forever ? capacity : grow_required;
    last_error = ERROR_BAD_LENGTH;
    return 0;
  }
  if (invalid_count) { words[0] = capacity; return 1; }
  Check(capacity > page_count, "snapshot has space for all controlled pages");
  words[0] = page_count;
  for (size_t i = 0; i < page_count; ++i) words[i + 1] = page_flags[i];
  return 1;
}

struct PerformanceFixture {
  DWORD cb;
  SIZE_T commit_total, commit_limit, commit_peak, physical_total, physical_available,
      system_cache, kernel_total, kernel_paged, kernel_nonpaged, page_size;
  DWORD handles, processes, threads;
};
int performance_calls = 0;
BOOL MockPerformance(void* output, DWORD bytes) {
  ++performance_calls;
  Check(bytes == sizeof(PerformanceFixture), "system performance ABI size");
  if (performance_error) return 0;
  PerformanceFixture p{};
  p.cb = sizeof(p); p.physical_total = 10000; p.physical_available = 2500;
  p.system_cache = 4000; p.kernel_total = 1000; p.kernel_paged = 700; p.kernel_nonpaged = 300;
  p.commit_total = 11000; p.commit_limit = 15000; p.page_size = 4096;
  std::memcpy(output, &p, sizeof(p));
  return 1;
}
HANDLE GetModuleHandleW(const wchar_t*) { return reinterpret_cast<HANDLE>(uintptr_t{1}); }
using FARPROC = void(*)();
FARPROC GetProcAddress(HANDLE, const char* name) {
  if (std::strcmp(name, "K32QueryWorkingSet") == 0) return reinterpret_cast<FARPROC>(MockWorkingSet);
  if (std::strcmp(name, "K32GetPerformanceInfo") == 0) return reinterpret_cast<FARPROC>(MockPerformance);
  return nullptr;
}

#define malloc SampleMalloc
#define realloc SampleRealloc
#define free SampleFree
@WORKING_SET@
#undef free
#undef realloc
#undef malloc
@CATEGORY_FIELDS@
@JAVA_HEAP@
@SYSTEM_MEMORY@

void Reset() {
  Check(allocated_bytes == 0, "previous sample released its allocation");
  queries = allocations = reallocations = frees = 0;
  last_reallocation = 0; grow_required = 0;
  fail_malloc = fail_realloc = query_error = invalid_count = grow_forever = forbid_new = false;
  page_size = 4096; page_count = 0; page_flags.fill(0);
}
ULONG_PTR Page(unsigned protection, unsigned shares, bool shared) {
  return protection | (static_cast<ULONG_PTR>(shares) << 5) | (static_cast<ULONG_PTR>(shared) << 8);
}
WorkingSetUsage Sentinel() { return {91, 92, 93, 94, 95, 96, 97, 98}; }
void Unchanged(const WorkingSetUsage& value) {
  Check(value.rss == 91 && value.pss == 92 && value.uss == 93 && value.swappable_pss == 94
            && value.private_dirty == 95 && value.private_clean == 96
            && value.shared_dirty == 97 && value.shared_clean == 98,
        "failed sampling leaves every prior usage field untouched");
}

int main() {
  Check(OpenForMemory(-1) == nullptr && OpenForMemory(0) == nullptr && opens == 0,
        "invalid PIDs do not open processes");
  Check(OpenForMemory(123) == kSelf && opens == 0, "self sampling uses the borrowed pseudo-handle");
  Check(OpenForMemory(456) == kOther && opens == 1, "foreign sampling opens its process");
  CloseProcess(nullptr); CloseProcess(kSelf); CloseProcess(kOther);
  Check(closes == 1, "borrowed or absent process handles are never closed");

  Reset();
  page_count = 5;
  page_flags = {Page(4, 0, false), Page(1, 0, false), Page(6, 2, true),
                Page(5, 4, true), Page(7, 1, true), 0, 0, 0};
  WorkingSetUsage usage;
  Check(ReadWorkingSet(kSelf, &usage), "valid mixed working set succeeds");
  Check(usage.rss == 20 && usage.pss == 15 && usage.uss == 12,
        "private and shared page weighting preserves RSS/USS/PSS");
  Check(usage.private_dirty == 4 && usage.private_clean == 8
            && usage.shared_dirty == 4 && usage.shared_clean == 4,
        "permission estimates retain original private/shared accounting");
  Check(usage.swappable_pss == 0, "read-only private memory never invents file-backed swappable PSS");
  Check(allocations == 1 && frees == 1, "successful sample releases its owned snapshot");

  for (ULONG_PTR required : {ULONG_PTR{6000}, ULONG_PTR{64 * 1024 * 1024 / sizeof(ULONG_PTR) - 1}}) {
    Reset(); grow_required = required;
    Check(ReadWorkingSet(kSelf, &usage) && queries == 2, "growing snapshot retries and succeeds");
    Check(reallocations == 1 && frees == 1 && last_reallocation <= 64 * 1024 * 1024,
          "reported capacity plus capped headroom stays bounded and owned");
    if (required > 6000) Check(last_reallocation == 64 * 1024 * 1024,
                               "optional headroom does not reject a representable boundary snapshot");
  }

  for (int mode = 0; mode < 8; ++mode) {
    Reset(); usage = Sentinel();
    if (mode == 0) { fail_malloc = true; forbid_new = true; }
    if (mode == 1) { grow_required = 6000; fail_realloc = true; }
    if (mode == 2) query_error = true;
    if (mode == 3) invalid_count = true;
    if (mode == 4) grow_required = std::numeric_limits<ULONG_PTR>::max();
    if (mode == 5) grow_required = 64 * 1024 * 1024 / sizeof(ULONG_PTR);
    if (mode == 6) grow_forever = true;
    if (mode == 7) page_size = 0;
    Check(!ReadWorkingSet(kSelf, &usage), "unreadable, oversized or allocation-failed sample reports unavailable");
    forbid_new = false;
    Unchanged(usage);
    Check(allocated_bytes == 0, "every failure releases its owned allocation");
    if (mode == 6) Check(queries == 9, "working-set churn retains the nine-attempt bound");
    if (mode == 4 || mode == 5) Check(reallocations == 0, "unrepresentable required count never reaches allocation");
  }
  Reset();

  for (int fault = 0; fault <= 7; ++fault) {
    JNIEnv env; env.fail_at = fault;
    jlong heap = JavaHeapKb(&env);
    Check(heap == (fault ? 0 : 24), "Java heap is best effort with exact KiB conversion");
    Check(!env.pending && env.illegal_calls == 0, "Java helper stops ordinary JNI calls at each pending exception");
  }
  for (const char* prefix : {"dalvik", "native", "other"}) {
    JNIEnv env; CategoryFields fields{};
    forbid_new = true;
    bool result = CategoryFieldsFor(&env, reinterpret_cast<jclass>(1), prefix, &fields);
    forbid_new = false;
    Check(result && env.operations == 9, "all category field IDs resolve without heap allocation");
  }

  JNIEnv env;
  LongArray out; out.length = 29; out.values.fill(-7);
  Debug_getMemInfo(&env, nullptr, &out);
  Check(!env.pending && out.values[kMemTotal] == 40000 && out.values[kMemAvailable] == 10000,
        "physical total and immediately available memory use documented page counters");
  for (int slot = 0; slot < kMemCount; ++slot)
    if (slot != kMemTotal && slot != kMemAvailable)
      Check(out.values[slot] == 0, "unavailable Linux-only counters are not derived from unlike Windows fields");
  Check(out.values[27] == -7 && out.values[28] == -7, "system memory preserves oversized-array tail");
  env = {}; out.values.fill(-7); performance_error = true;
  Debug_getMemInfo(&env, nullptr, &out);
  Check(env.error == JNIEnv::RUNTIME && std::all_of(out.values.begin(), out.values.end(), [](jlong v) { return v == -7; }),
        "failed system query throws without publishing partial counters");
  performance_error = false; performance_calls = 0; env = {}; out.length = 26;
  Debug_getMemInfo(&env, nullptr, &out);
  Check(env.error == JNIEnv::RUNTIME && performance_calls == 0, "short system array is rejected before the query");
  env = {};
  Debug_getMemInfo(&env, nullptr, nullptr);
  Check(env.error == JNIEnv::NULL_POINTER && performance_calls == 0, "null system array is rejected before the query");
  std::printf("Debug memory contracts: %d checks, %d failed\n", checks, failures);
  return failures ? 1 : 0;
}
