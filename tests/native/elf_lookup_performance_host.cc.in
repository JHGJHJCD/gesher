#include "envelope.h"
#include <atomic>
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <deque>
#include <new>
#include <thread>
#include <unordered_set>

static thread_local bool tracking = false, tracing = true;
static thread_local size_t allocations = 0, allocated_bytes = 0;
static thread_local size_t gnu_hash_calls = 0, sysv_hash_calls = 0;
static thread_local std::vector<Library*> visited, resolved;
[[gnu::noinline]] void* operator new(size_t n) {
  if (tracking) { ++allocations; allocated_bytes += n; }
  if (void* p = std::malloc(n ? n : 1)) return p;
  std::abort();
}
void* operator new[](size_t n) { return ::operator new(n); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }

@HASHES@
@SYMBOLS@

void* SymbolAddress(const Library* library, const Elf64_Sym* symbol) {
  if (tracing) resolved.push_back(const_cast<Library*>(library));
  if (ELF64_ST_TYPE(symbol->st_info) == STT_GNU_IFUNC) {
    if (library->resolver == nullptr) std::abort();
    return library->resolver();
  }
  return reinterpret_cast<void*>(static_cast<uintptr_t>(symbol->st_value));
}
static size_t checks = 0;
static void Check(bool ok, const char* label) {
  ++checks;
  if (!ok) { std::fprintf(stderr, "ELF lookup check %zu failed: %s\n", checks, label); std::exit(1); }
}
static void Add(Library& library, const char* name, uintptr_t value,
                unsigned binding = STB_GLOBAL, unsigned type = STT_FUNC,
                bool defined = true, unsigned visibility = STV_DEFAULT) {
  Elf64_Sym symbol{};
  symbol.st_name = static_cast<uint32_t>(library.strings.size());
  symbol.st_value = value;
  symbol.st_shndx = defined ? 1 : SHN_UNDEF;
  symbol.st_info = ELF64_ST_INFO(binding, type);
  symbol.st_other = visibility;
  library.strings += name;
  library.strings += '\0';
  library.symbols.push_back(symbol);
}
static void Publish(Library& library, bool gnu) {
  library.has_gnu_hash = gnu;
  library.has_sysv_hash = !gnu;
  library.bucket = library.symbols.size() > 1 ? 1 : 0;
  library.gnu_chains.clear();
  library.sysv_chains.assign(library.symbols.size(), 0);
  for (size_t i = 1; i < library.symbols.size(); ++i) {
    const bool last = i + 1 == library.symbols.size();
    const uint32_t hash = GnuHash(library.strings.c_str() + library.symbols[i].st_name);
    library.gnu_chains.push_back((hash & ~uint32_t{1}) | last);
    library.sysv_chains[i] = last ? 0 : static_cast<uint32_t>(i + 1);
  }
  library.symtab = library.symbols.data();
  library.strtab = library.strings.c_str();
  library.gnu_bloom = &library.bloom;
  library.gnu_buckets = library.sysv_buckets = &library.bucket;
  library.gnu_chain = library.gnu_chains.data();
  library.sysv_chain = library.sysv_chains.data();
}
static void Publish(std::vector<Library>& graph) {
  for (size_t i = 0; i < graph.size(); ++i) Publish(graph[i], (i & 1) == 0);
}

using LookupFn = void* (*)(Library*, const char*);
static void* Oracle(Library* root, const char* name) {
  if (root == nullptr || name == nullptr) return nullptr;
  const uint32_t gh = GnuHash(name), sh = SysvHash(name);
  std::deque<Library*> queue{root};
  std::unordered_set<Library*> seen{root};
  while (!queue.empty()) {
    Library* library = queue.front();
    queue.pop_front();
    if (const auto* symbol = FindDefinedSymbol(library, name, gh, sh)) return SymbolAddress(library, symbol);
    for (Library* dependency : library->dependencies)
      if (seen.insert(dependency).second) queue.push_back(dependency);
  }
  return nullptr;
}
static thread_local LookupFn active_lookup = nullptr;
static Library* reentrant_root = nullptr;
static thread_local size_t callback_calls = 0;
static void* Reenter() {
  ++callback_calls;
  if (active_lookup(reentrant_root, "inner") != reinterpret_cast<void*>(0x4567)) std::abort();
  return reinterpret_cast<void*>(0xfedc);
}
struct Observation {
  void* result;
  std::vector<Library*> visits, resolutions;
  size_t gnu, sysv, callbacks;
};
static Observation Observe(LookupFn lookup, Library* root, const char* name) {
  visited.clear(); resolved.clear();
  gnu_hash_calls = sysv_hash_calls = callback_calls = 0;
  active_lookup = lookup;
  void* result = lookup(root, name);
  return {result, visited, resolved, gnu_hash_calls, sysv_hash_calls, callback_calls};
}
static void Same(const Observation& actual, const Observation& expected) {
  Check(actual.result == expected.result, "resolved address identity");
  Check(actual.visits == expected.visits, "complete breadth-first visited order");
  Check(actual.resolutions == expected.resolutions, "exact resolver ownership and call order");
  Check(actual.gnu == expected.gnu && actual.sysv == expected.sysv, "hash calls unchanged");
  Check(actual.callbacks == expected.callbacks, "IFUNC callback count unchanged");
}
static void Compare(Library* root, const char* name) {
  const auto expected = Observe(Oracle, root, name);
  const auto candidate = Observe(Lookup, root, name);
  Same(candidate, expected);
#if HAS_REFERENCE
  Same(candidate, Observe(ReferenceLookup, root, name));
#endif
}
static void Measure(std::vector<Library>& graph, const char* name, size_t calls, bool enforce) {
  tracing = false;
  allocations = allocated_bytes = 0;
  const auto start = std::chrono::steady_clock::now();
  tracking = true;
  for (size_t i = 0; i < calls; ++i) (void)Lookup(&graph.front(), name);
  tracking = false;
  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
      std::chrono::steady_clock::now() - start).count();
  std::printf("ELF graph libraries=%zu name=%s calls=%zu allocations=%zu bytes=%zu elapsed_us=%lld\n",
              graph.size(), name, calls, allocations, allocated_bytes, static_cast<long long>(elapsed));
  if (enforce) {
    if (graph.size() <= 17) Check(allocations == 0, "small graph needs no heap scratch");
    else {
      // Preserve the original tree/vector asymptotic behavior after overflow.
      size_t logarithm = 0;
      for (size_t n = graph.size(); n; n >>= 1) ++logarithm;
      Check(allocations <= calls * (graph.size() + logarithm + 2), "large graph retains linear allocation bound");
    }
  }
  tracing = true;
}
static uint32_t state = 0x3767b2e5;
static uint32_t Random() { state ^= state << 13; state ^= state >> 17; state ^= state << 5; return state; }

int main(int argc, char** argv) {
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  visited.reserve(65536); resolved.reserve(1024);
  Compare(nullptr, "present");
  Library empty;
  Publish(empty, true);
  Compare(&empty, nullptr);
  Compare(&empty, "missing");

  std::vector<Library> diamond(6);
  diamond[0].dependencies = {&diamond[1], &diamond[2], &diamond[1]};
  diamond[1].dependencies = {&diamond[3], &diamond[4]};
  diamond[2].dependencies = {&diamond[4]};
  diamond[3].dependencies = {&diamond[0], &diamond[5]};
  diamond[4].dependencies = {&diamond[5]};
  Add(diamond[0], "root", 11); Add(diamond[1], "root", 21);
  Add(diamond[2], "breadth", 41); Add(diamond[3], "breadth", 32);
  Add(diamond[3], "order", 33); Add(diamond[4], "order", 51);
  Add(diamond[0], "binding", 61, STB_WEAK); Add(diamond[1], "binding", 62);
  Add(diamond[0], "undefined", 0, STB_GLOBAL, STT_FUNC, false); Add(diamond[5], "undefined", 71);
  Add(diamond[5], "visibility", 81, STB_GLOBAL, STT_OBJECT, true, STV_HIDDEN);
  Publish(diamond);
  for (const char* name : {"root", "breadth", "order", "binding", "undefined", "visibility", "missing"}) Compare(&diamond[0], name);
  Check(Lookup(&diamond[0], "root") == reinterpret_cast<void*>(11), "root wins");
  Check(Lookup(&diamond[0], "breadth") == reinterpret_cast<void*>(41), "sibling beats grandchild");
  Check(Lookup(&diamond[0], "order") == reinterpret_cast<void*>(33), "DT_NEEDED order within depth");
  Check(Lookup(&diamond[0], "binding") == reinterpret_cast<void*>(61), "weak binding lookup behavior unchanged");
  Check(Lookup(&diamond[0], "undefined") == reinterpret_cast<void*>(71), "undefined entry skipped");

  for (size_t nodes : {size_t(1), size_t(2), size_t(6), size_t(15), size_t(16), size_t(17), size_t(18), size_t(64), size_t(1024)}) {
    std::vector<Library> graph(nodes);
    for (size_t i = 1; i < nodes; ++i) graph[i - 1].dependencies = {&graph[i]};
    graph.back().dependencies = {&graph.front(), &graph.back()};
    Add(graph.back(), "present", 0x1234);
    Publish(graph);
    Compare(&graph[0], "present"); Compare(&graph[0], "missing");
    const size_t calls = nodes < 20 ? 100000 : nodes < 100 ? 10000 : 1000;
    Measure(graph, "present", calls, enforce); Measure(graph, "missing", calls, enforce);
    // Overflow can also happen while enqueuing siblings before any is visited.
    graph[0].dependencies.clear();
    for (size_t i = 1; i < nodes; ++i) graph[0].dependencies.push_back(&graph[i]);
    Compare(&graph[0], "present"); Compare(&graph[0], "missing");
  }
  for (unsigned sample = 0; sample < 10000; ++sample) {
    std::vector<Library> graph(1 + Random() % 80);
    for (size_t i = 0; i < graph.size(); ++i) {
      for (unsigned n = Random() % 12; n; --n) graph[i].dependencies.push_back(&graph[Random() % graph.size()]);
      if (Random() % 7 == 0) Add(graph[i], "present", 0x1000 + i,
          Random() % 2 ? STB_GLOBAL : STB_WEAK, STT_FUNC, Random() % 4 != 0,
          Random() % 2 ? STV_DEFAULT : STV_HIDDEN);
    }
    Publish(graph);
    Compare(&graph[0], "present"); Compare(&graph[0], "missing");
  }

  // Overflow while visiting an already queued owner must retain the processed
  // prefix and the complete BFS frontier, including duplicates back into both.
  std::vector<Library> frontier(19);
  for (size_t i = 1; i <= 16; ++i) frontier[0].dependencies.push_back(&frontier[i]);
  frontier[1].dependencies = {&frontier[0], &frontier[1], &frontier[2], &frontier[17], &frontier[17]};
  frontier[2].dependencies = {&frontier[16], &frontier[18]};
  frontier[17].dependencies = {&frontier[1], &frontier[18], &frontier[0]};
  Add(frontier[16], "winner", 0x1616); Add(frontier[17], "winner", 0x1717);
  Publish(frontier);
  Compare(&frontier[0], "missing");
  std::vector<Library*> frontier_order;
  for (Library& library : frontier) frontier_order.push_back(&library);
  Check(Observe(Lookup, &frontier[0], "missing").visits == frontier_order,
        "overflow after one visited dependency preserves processed prefix and BFS frontier");
  Compare(&frontier[0], "winner");
  Check(Lookup(&frontier[0], "winner") == reinterpret_cast<void*>(0x1616), "queued direct symbol beats newly discovered child");
  frontier[0].dependencies.insert(frontier[0].dependencies.begin(), &frontier[17]);
  Compare(&frontier[0], "winner");
  Check(Lookup(&frontier[0], "winner") == reinterpret_cast<void*>(0x1717), "later invocation sees replacement dependency order");
  frontier[0].dependencies = {&frontier[2]};
  frontier[16].symbols[1].st_value = 0x1617;
  Compare(&frontier[0], "winner");
  Check(Lookup(&frontier[0], "winner") == reinterpret_cast<void*>(0x1617), "later invocation sees graph and symbol mutation without stale cache");

  // Exercise both directions of IFUNC reentry across the queue threshold,
  // rather than only a large outer lookup with a small nested lookup.
  for (size_t outer_size : {size_t(2), size_t(16), size_t(17), size_t(18)}) {
    std::vector<Library> outer(outer_size), inner(20);
    for (size_t i = 1; i < outer.size(); ++i) outer[i - 1].dependencies = {&outer[i]};
    for (size_t i = 1; i < inner.size(); ++i) inner[i - 1].dependencies = {&inner[i]};
    inner.back().dependencies = {&inner[0], &inner[1]};
    Add(inner.back(), "inner", 0x4567);
    Add(outer.back(), "resolver", 0, STB_GLOBAL, STT_GNU_IFUNC);
    outer.back().resolver = Reenter;
    Publish(outer); Publish(inner);
    reentrant_root = &inner[0];
    Compare(&outer[0], "resolver");
  }

  std::vector<Library> nested(3), ifunc(19);
  nested[0].dependencies = {&nested[1], &nested[2]};
  nested[2].dependencies = {&nested[0]};
  Add(nested[2], "inner", 0x4567);
  for (size_t i = 1; i < ifunc.size(); ++i) ifunc[i - 1].dependencies = {&ifunc[i]};
  Add(ifunc.back(), "resolver", 0, STB_GLOBAL, STT_GNU_IFUNC);
  ifunc.back().resolver = Reenter;
  Publish(nested); Publish(ifunc);
  reentrant_root = &nested[0];
  Compare(&ifunc[0], "resolver");
  active_lookup = Lookup;
  callback_calls = 0;
  Check(Lookup(&ifunc[0], "resolver") == reinterpret_cast<void*>(0xfedc) &&
        Lookup(&ifunc[0], "resolver") == reinterpret_cast<void*>(0xfedc) && callback_calls == 2,
        "IFUNC reenters with independent scratch and resolves on each invocation");

  std::vector<Library> deep(65536);
  for (size_t i = 1; i < deep.size(); ++i) deep[i - 1].dependencies = {&deep[i]};
  deep.back().dependencies = {&deep.front()};
  Add(deep.back(), "last", 0x9876);
  Publish(deep);
  Compare(&deep[0], "last"); Compare(&deep[0], "missing");
  std::atomic<bool> concurrent{true};
  std::vector<std::thread> threads;
  for (int t = 0; t < 4; ++t) threads.emplace_back([&] {
    tracing = false;
    allocations = allocated_bytes = 0;
    tracking = true;
    for (int i = 0; i < 1000; ++i)
      if (Lookup(&diamond[0], "undefined") != reinterpret_cast<void*>(71)) concurrent = false;
    tracking = false;
    if (enforce && allocations != 0) concurrent = false;
  });
  for (auto& thread : threads) thread.join();
  Check(concurrent, "parallel invocations own independent scratch");
  threads.clear();
  for (int t = 0; t < 4; ++t) threads.emplace_back([&] {
    tracing = false;
    active_lookup = Lookup;
    callback_calls = 0;
    for (int i = 0; i < 1000; ++i)
      if (Lookup(&ifunc[0], "resolver") != reinterpret_cast<void*>(0xfedc)) concurrent = false;
    if (callback_calls != 1000) concurrent = false;
  });
  for (auto& thread : threads) thread.join();
  Check(concurrent, "parallel fallback lookups and nested IFUNC callbacks own independent scratch");
  std::printf("ELF lookup performance contracts: %zu PASS (20000 seeded graph queries)\n", checks);
}
