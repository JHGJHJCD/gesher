// Production deferred-walk and execute-fault functions with controlled failure
// boundaries. No generated instructions or host exception handler are executed.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <map>
#include <set>
#include <string>
#include <vector>

constexpr uintptr_t kPage = 4096;
constexpr int PROT_READ = 1, PROT_WRITE = 2, PROT_EXEC = 4;
uintptr_t PageOf(uintptr_t value) { return value & ~(kPage - 1); }
struct Region { uint64_t start, end; };
struct LazyObject {
  const char* name = "injected failure";
  uintptr_t lo = 0x10000, hi = 0x11000, bias = 0;
  std::vector<Region> fdes;
  uint64_t eh_frame_hdr = 0;
  bool eh_frame_hdr_read = false, unpacking = false;
  std::map<uintptr_t, int> done;
  std::map<uintptr_t, uint8_t> patched;
};
struct PendingPage { LazyObject* object; int prot; bool regenerated; };
struct FsRewriteStats {};
struct X86Insn { size_t length = 1; };
int g_lazy_lock;
void AcquireSRWLockExclusive(int*) {}
void ReleaseSRWLockExclusive(int*) {}
void* GetCurrentProcess() { return nullptr; }
void FlushInstructionCache(void*, void*, size_t) {}
std::map<uintptr_t, PendingPage> pending_pages;
std::map<uintptr_t, PendingPage>& Pending() { return pending_pages; }
LazyObject object;
LazyObject* FindObjectLocked(uintptr_t) { return &object; }
std::vector<Region> ReadableRegions(const LazyObject*) { return {}; }
bool RegionsFromEhFrameHdr(const uint8_t*, uint8_t*, const std::vector<Region>&,
                          std::vector<Region>*) { return false; }
bool DecodeX86(const uint8_t*, size_t, X86Insn*) { return true; }
bool BranchTarget(const uint8_t*, uintptr_t, const X86Insn&, uint64_t*) { return false; }
bool EndsBlock(const X86Insn&) { return true; }
uint8_t KnownSyscallLength(uintptr_t) { return 0; }
bool rewrite_ok = true, finish_ok = true, restore_ok = true;
int executable_requests, actual_protection;
int mprotect(void*, size_t, int prot) {
  if ((prot & PROT_EXEC) != 0) ++executable_requests;
  if (!restore_ok && prot == PROT_READ) return -1;
  actual_protection = prot;
  return 0;
}
struct Rewriter {
  std::map<uintptr_t, int>* restore;
  Rewriter(LazyObject*, bool, FsRewriteStats*, std::string*, size_t, uintptr_t, uintptr_t,
           std::map<uintptr_t, int>* r) : restore(r) {}
  bool Rewrite(uint8_t* site, const X86Insn&) {
    (*restore)[PageOf(reinterpret_cast<uintptr_t>(site))] = PROT_READ;
    actual_protection = PROT_READ | PROT_WRITE;
    return rewrite_ok;
  }
  bool Finish(const std::vector<Region>&) { return finish_ok; }
};

@PRODUCTION_DEFERRED_FUNCTIONS@

int failures;
void Check(const char* name, bool ok) {
  std::printf("deferred failure: %s %s\n", name, ok ? "PASS" : "FAIL");
  failures += !ok;
}
void Reset() {
  object = {};
  Pending().clear();
  Pending()[object.lo] = {&object, PROT_READ | PROT_EXEC, false};
  rewrite_ok = finish_ok = restore_ok = true;
  executable_requests = 0;
  actual_protection = PROT_READ;
}
int main() {
  Reset();
  rewrite_ok = false;
  Check("rewrite failure propagates", !HandleExecuteFault(object.lo));
  Check("rewrite failure never enables execution", executable_requests == 0 &&
        actual_protection == PROT_READ && Pending().count(object.lo) == 1 && object.done.empty());
  rewrite_ok = true;
  Check("pending page can retry after recovery", HandleExecuteFault(object.lo));
  Check("successful retry commits executable state", executable_requests == 1 &&
        Pending().empty() && object.done[object.lo] == (PROT_READ | PROT_EXEC));
  Reset();
  finish_ok = false;
  Check("trap registration failure propagates", !HandleExecuteFault(object.lo));
  Check("registration failure keeps page pending", executable_requests == 0 &&
        actual_protection == PROT_READ && Pending().count(object.lo) == 1);
  Reset();
  restore_ok = false;
  Check("protection restoration failure propagates", !HandleExecuteFault(object.lo));
  Check("restoration failure never enables execution", executable_requests == 0 &&
        Pending().count(object.lo) == 1 && object.done.empty());
  return failures != 0;
}
