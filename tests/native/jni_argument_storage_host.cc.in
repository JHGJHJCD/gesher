// JNI scalar/jvalue adapter only; Args and both va_list decoders are production.
#include <array>
#include <atomic>
#include <chrono>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <new>
#include <string>
#include <thread>
#include <vector>

#include "shim_internal.h"

using jboolean = uint8_t;
using jbyte = int8_t;
using jchar = uint16_t;
using jshort = int16_t;
using jint = int32_t;
using jlong = int64_t;
using jfloat = float;
using jdouble = double;
using jobject = void*;
union jvalue {
  jboolean z;
  jbyte b;
  jchar c;
  jshort s;
  jint i;
  jlong j;
  jfloat f;
  jdouble d;
  jobject l;
};
static_assert(sizeof(jvalue) == 8);

namespace allocation {
thread_local bool enabled = false;
thread_local size_t count = 0;
thread_local size_t bytes = 0;
}
// Allocation counters observe only the exact Args lifetime, after fixture setup.
// malloc/free remain visible to ASan; the noinline boundary avoids compiler
// allocation elision and makes the allocation regression deterministic.
[[gnu::noinline]] void* operator new(size_t size) {
  if (allocation::enabled) { ++allocation::count; allocation::bytes += size; }
  void* memory = std::malloc(size ? size : 1);
  if (!memory) std::abort();
  return memory;
}
[[gnu::noinline]] void operator delete(void* memory) noexcept { std::free(memory); }
void operator delete(void* memory, size_t) noexcept { ::operator delete(memory); }
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete[](void* memory) noexcept { ::operator delete(memory); }
void operator delete[](void* memory, size_t) noexcept { ::operator delete(memory); }

using gesher::bionic::NextGp;
using gesher::bionic::NextFp;
using gesher::bionic::SysvVaList;

@ARGS@

namespace {
std::atomic<unsigned> checks{0}, failures{0};
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok && failures.fetch_add(1) < 20) std::fprintf(stderr, "FAIL JNI arguments: %s\n", reason);
}

struct Sample {
  char kind;
  uint64_t gp = 0;
  double fp = 0;
  jvalue expected{};
};
Sample Boolean(jboolean n) { Sample s{'Z'}; s.gp = n; s.expected.z = n; return s; }
Sample Byte(jbyte n) { Sample s{'B'}; s.gp = static_cast<uint64_t>(n); s.expected.b = n; return s; }
Sample Character(jchar n) { Sample s{'C'}; s.gp = n; s.expected.c = n; return s; }
Sample Short(jshort n) { Sample s{'S'}; s.gp = static_cast<uint64_t>(n); s.expected.s = n; return s; }
Sample Int(jint n) { Sample s{'I'}; s.gp = static_cast<uint64_t>(n); s.expected.i = n; return s; }
Sample Long(jlong n) { Sample s{'J'}; s.gp = static_cast<uint64_t>(n); s.expected.j = n; return s; }
Sample Float(jfloat n) { Sample s{'F'}; s.fp = n; s.expected.f = n; return s; }
Sample Double(jdouble n) { Sample s{'D'}; s.fp = n; s.expected.d = n; return s; }
Sample Ref(jobject n) {
  Sample s{'L'}; s.gp = reinterpret_cast<uintptr_t>(n); s.expected.l = n; return s;
}

class Input {
 public:
  explicit Input(const std::vector<Sample>& samples, bool arm64, unsigned fixed_gp = 3,
                 unsigned fixed_fp = 0) {
    expected.resize(samples.size() + 1);
    const size_t gp_limit = arm64 ? 8 : 6;
    size_t gp = fixed_gp, fp = fixed_fp, stack = 0;
    for (size_t i = 0; i < samples.size(); ++i) {
      const auto& sample = samples[i];
      kinds += sample.kind;
      expected[i] = sample.expected;
      bool floating = sample.kind == 'F' || sample.kind == 'D';
      const void* value = floating ? static_cast<const void*>(&sample.fp)
                                   : static_cast<const void*>(&sample.gp);
      uint8_t* target;
      if (floating && fp < 8) {
        target = arm64 ? arm_fp.data() + fp * 16 : sysv.data() + 48 + fp * 16;
        ++fp;
      } else if (!floating && gp < gp_limit) {
        target = arm64 ? arm_gp.data() + gp * 8 : sysv.data() + gp * 8;
        ++gp;
      } else {
        if (stack + 8 > overflow.size()) std::abort();
        target = overflow.data() + stack;
        stack += 8;
      }
      std::memcpy(target, value, 8);
    }
    consumed_stack = stack;
    if (arm64) {
      banks = {arm_gp.data() + arm_gp.size(), arm_fp.data() + arm_fp.size()};
      initial = {gesher::abi::kArm64VaTag | (fixed_gp * 8), fixed_fp * 16,
                 overflow.data(), reinterpret_cast<uint8_t*>(&banks)};
    } else {
      initial = {fixed_gp * 8, 48 + fixed_fp * 16, overflow.data(), sysv.data()};
    }
  }
  SysvVaList list() const { return initial; }
  bool stackConsumed(const SysvVaList& ap) const {
    return ap.overflow_arg_area == overflow.data() + consumed_stack;
  }
  std::string kinds;
  std::vector<jvalue> expected;

 private:
  std::array<uint8_t, 176> sysv{};
  std::array<uint8_t, 64> arm_gp{};
  std::array<uint8_t, 128> arm_fp{};
  std::array<uint8_t, 4096> overflow{};
  gesher::abi::Arm64VaRegisters banks{};
  SysvVaList initial{};
  size_t consumed_stack = 0;
};

void Values(const Args& decoded, const std::vector<jvalue>& expected) {
  Check(decoded.data() != nullptr, "data is non-null even without arguments");
  Check(std::memcmp(decoded.data(), expected.data(), expected.size() * sizeof(jvalue)) == 0,
        "argument values, unused union bytes and spare slot are preserved");
}

void Verify(const std::vector<Sample>& samples, bool arm64, bool allocation_gate,
            unsigned fixed_gp = 3, unsigned fixed_fp = 0) {
  Input input(samples, arm64, fixed_gp, fixed_fp);
  auto ap = input.list();
  auto copy = ap;
  allocation::count = allocation::bytes = 0;
  allocation::enabled = true;
  {
    Args decoded(input.kinds, &ap);
    allocation::enabled = false;
    Values(decoded, input.expected);
    Check(input.stackConsumed(ap), "all spilled arguments consumed exactly once");
    auto unchanged = input.list();
    Check(std::memcmp(&copy, &unchanged, sizeof(copy)) == 0, "independent input cursor is not changed");
    if (allocation_gate) {
      Check(allocation::count == (samples.size() <= 16 ? 0 : 1),
            "small arguments never allocate; overflow uses one owned allocation");
      Check(allocation::bytes == (samples.size() <= 16 ? 0 : input.expected.size() * sizeof(jvalue)),
            "only overflow argument bytes are allocated");
    }
    Args again(input.kinds, &copy);
    Values(again, input.expected);
    Values(decoded, input.expected);
    Check(again.data() != decoded.data(), "nested argument arrays have independent ownership");
  }
  allocation::enabled = false;
}

#if defined(__x86_64__)
// The host compiler supplies a real SysV va_list, including default promotions
// and simultaneous GP/FP stack spill. Copy its representation, not its values.
void ActualEllipsis(const std::string& kinds, const std::vector<jvalue>* expected, ...) {
  va_list native;
  va_start(native, expected);
  static_assert(sizeof(native) == sizeof(SysvVaList));
  SysvVaList ap;
  std::memcpy(&ap, &native, sizeof(ap));
  Args decoded(kinds, &ap);
  Values(decoded, *expected);
  va_end(native);
}
#endif

std::vector<Sample> Mixed(size_t count) {
  static int token;
  const std::array<Sample, 10> values = {
      Boolean(1), Byte(-111), Character(0xffd3), Short(-23145), Int(-1234567),
      Long(-INT64_C(0x123456789abcdef)), Float(-0.375f), Double(12345.125), Ref(&token), Ref(nullptr)};
  std::vector<Sample> out;
  for (size_t i = 0; i < count; ++i) out.push_back(values[i % values.size()]);
  return out;
}

void Functional(bool allocation_gate) {
  for (bool arm64 : {false, true}) {
    for (size_t count : {size_t(0), size_t(1), size_t(10), size_t(15), size_t(16), size_t(17), size_t(64), size_t(127)}) {
      Verify(Mixed(count), arm64, allocation_gate);
    }
    std::vector<Sample> floats, alternating;
    for (int i = 0; i < 24; ++i) {
      floats.push_back(i % 2 ? Float(i + 0.25f) : Double(-i - 0.125));
      alternating.push_back(i % 2 ? Int(i * -151) : Double(i + 0.5));
    }
    Verify(floats, arm64, allocation_gate);
    Verify(alternating, arm64, allocation_gate);
    Verify(Mixed(17), arm64, allocation_gate, arm64 ? 8 : 6, 8);
    Verify(Mixed(16), arm64, allocation_gate, 4, 7);  // nonvirtual fixed args, near-full FP bank
  }
#if defined(__x86_64__)
  auto samples = std::vector<Sample>{Boolean(1), Byte(-101), Character(0xfff0), Short(-23001),
      Int(-12345), Long(INT64_C(0x123456789a)), Float(0.25f), Double(-0.5), Ref(nullptr),
      Double(1.25), Double(2.5), Double(3.75), Double(4.0), Double(5.25), Double(6.5),
      Float(7.75f), Int(-99), Double(8.125)};
  Input input(samples, false);
  ActualEllipsis(input.kinds, &input.expected, 1, -101, 0xfff0, -23001, -12345,
                 INT64_C(0x123456789a), 0.25, -0.5, static_cast<void*>(nullptr),
                 1.25, 2.5, 3.75, 4.0, 5.25, 6.5, 7.75, -99, 8.125);
#endif
  // Simultaneous invocations use separate stack storage, including nested overflow.
  std::vector<std::thread> threads;
  for (int n = 0; n < 4; ++n) {
    threads.emplace_back([n, allocation_gate] {
      for (int i = 0; i < 100; ++i) Verify(Mixed(i % 2 ? 16 : 17), n % 2, allocation_gate);
    });
  }
  for (auto& thread : threads) thread.join();
}

[[gnu::noinline]] uint64_t Consume(const Args& args) {
  uint64_t value;
  std::memcpy(&value, args.data(), sizeof(value));
  return value;
}
void Benchmark() {
  constexpr size_t iterations = 200000;
  for (size_t count : {size_t(0), size_t(1), size_t(10), size_t(16), size_t(17)}) {
    Input input(Mixed(count), false);
    uint64_t checksum = 0;
    for (size_t n = 0; n < 1000; ++n) {
      auto ap = input.list(); Args args(input.kinds, &ap); checksum += Consume(args);
    }
    allocation::count = allocation::bytes = 0;
    auto start = std::chrono::steady_clock::now();
    allocation::enabled = true;
    for (size_t n = 0; n < iterations; ++n) {
      auto ap = input.list(); Args args(input.kinds, &ap); checksum += Consume(args);
    }
    allocation::enabled = false;
    auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now() - start).count();
    std::printf("JNI Args benchmark arguments=%zu iterations=%zu allocations=%zu bytes=%zu ns_per_call=%.2f checksum=%llu\n",
                count, iterations, allocation::count, allocation::bytes,
                static_cast<double>(elapsed) / iterations, static_cast<unsigned long long>(checksum));
  }
}
}  // namespace

int main(int argc, char** argv) {
  bool gate = true, benchmark = false;
  for (int i = 1; i < argc; ++i) {
    if (!std::strcmp(argv[i], "--behavior-only")) gate = false;
    else if (!std::strcmp(argv[i], "--benchmark")) benchmark = true;
    else return 2;
  }
  Functional(gate);
  if (benchmark) Benchmark();
  std::printf("JNI argument storage: %u checks, %u failures\n", checks.load(), failures.load());
  return failures.load() ? 1 : 0;
}
