// The production LogLines and exact Launcher.printTail body are compiled unchanged.
package com.gesher.app;

import java.io.BufferedWriter;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.IOException;
import java.io.PrintStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.IdentityHashMap;
import java.util.List;

class LauncherLogBoundary {
@PRINT_TAIL@
    static void print(File file, int lines) { printTail(file, lines); }
}

public final class LauncherLogHostTest {
    private static int checks;
    private static void check(boolean ok, String message) {
        checks++;
        if (!ok) throw new AssertionError(message);
    }

    private static String tail(Path path, int lines) throws Exception {
        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
        PrintStream before = System.err;
        try (PrintStream output = new PrintStream(bytes, true, "UTF-8")) {
            System.setErr(output);
            LauncherLogBoundary.print(path.toFile(), lines);
        } finally {
            System.setErr(before);
        }
        return new String(bytes.toByteArray(), StandardCharsets.UTF_8).replace("\r\n", "\n");
    }

    private static void behavior(Path path) throws Exception {
        String[] inputs = {"", "one", "one\n", "one\ntwo", "one\r\ntwo\rthree\n\nשלום",
                "אבג\n\nlast\n", "x".repeat(32769) + "\nend"};
        for (String input : inputs) {
            Files.write(path, input.getBytes(StandardCharsets.UTF_8));
            List<String> reference = Files.readAllLines(path, StandardCharsets.UTF_8);
            for (int count : new int[] {0, 1, 2, 40}) {
                StringBuilder expected = new StringBuilder();
                for (int i = Math.max(0, reference.size() - count); i < reference.size(); i++) {
                    expected.append("  ").append(reference.get(i)).append('\n');
                }
                check(expected.toString().equals(tail(path, count)), "UTF-8 suffix/line ending mismatch");
            }
        }
        Files.write(path, new byte[] {'o', 'k', '\n', (byte) 0xc3, (byte) 0x28});
        check(tail(path, 40).isEmpty(), "malformed UTF-8 must preserve no-log fallback");
        Files.delete(path);
        check(tail(path, 40).isEmpty(), "missing log must preserve no-log fallback");
    }

    private static void allocations() throws Exception {
        class Observer extends PrintStream {
            final IdentityHashMap<byte[], Boolean> arrays = new IdentityHashMap<>();
            int writes;
            boolean held = true;
            Observer() throws Exception { super(new ByteArrayOutputStream(), true, "UTF-8"); }
            @Override public void write(byte[] bytes, int offset, int length) {
                held &= Thread.holdsLock(this);
                arrays.put(bytes, Boolean.TRUE);
                writes++;
                super.write(bytes, offset, length);
            }
        }
        try (Observer output = new Observer()) {
            LogLines lines = new LogLines(output);
            byte[] input = ("steady verbose application log שלום " + "x".repeat(96) + "\n")
                    .getBytes(StandardCharsets.UTF_8);
            for (int i = 0; i < 10000; i++) lines.write(input, 0, input.length);
            lines.finish();
            check(output.writes == 10000, "complete lines use one synchronous bulk write each");
            check(output.held, "line writes must hold the shared output monitor");
            System.out.println("Log forwarding: lines=" + output.writes + " distinct transfer buffers="
                    + output.arrays.size());
            check(output.arrays.size() == 1, "steady forwarding must reuse its owned line buffer");
        }
    }

    private static void memory(Path path) throws Exception {
        final int lines = 400000;
        final String prefix = "diagnostic שלום " + "x".repeat(96);
        try (BufferedWriter writer = Files.newBufferedWriter(path, StandardCharsets.UTF_8)) {
            for (int i = 0; i < lines; i++) {
                writer.write(prefix); writer.write(Integer.toString(i)); writer.newLine();
            }
        }
        StringBuilder expected = new StringBuilder();
        for (int i = lines - 40; i < lines; i++) expected.append("  ").append(prefix).append(i).append('\n');
        check(expected.toString().equals(tail(path, 40)), "large-file suffix must remain exact");
        System.out.println("Log tail: file_bytes=" + Files.size(path) + " retained_lines=40 max_heap="
                + Runtime.getRuntime().maxMemory());
    }

    public static void main(String[] args) throws Exception {
        Path path = Files.createTempFile("gesher-log-contract-", ".log");
        try {
            switch (args[0]) {
                case "behavior": behavior(path); break;
                case "allocation": allocations(); break;
                case "tail-memory": memory(path); break;
                default: throw new IllegalArgumentException(args[0]);
            }
        } finally {
            Files.deleteIfExists(path);
        }
        System.out.println("Launcher log " + args[0] + " PASS: " + checks + " checks");
    }
}
