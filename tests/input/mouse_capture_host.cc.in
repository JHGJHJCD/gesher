// Exact production method bodies; only Win32 and Android event containers are seams.
#include <cstdint>
#include <cstdio>
#include <mutex>
#include <vector>

@EVENT@
constexpr int kCancel = 19;
constexpr int kMouseDeviceId = 1, AINPUT_SOURCE_MOUSE = 0x2002;
constexpr int AMOTION_EVENT_ACTION_DOWN = 0, AMOTION_EVENT_ACTION_UP = 1,
    AMOTION_EVENT_ACTION_MOVE = 2, AMOTION_EVENT_ACTION_CANCEL = 3,
    AMOTION_EVENT_ACTION_HOVER_MOVE = 7, AMOTION_EVENT_ACTION_SCROLL = 8,
    AMOTION_EVENT_ACTION_HOVER_ENTER = 9, AMOTION_EVENT_ACTION_HOVER_EXIT = 10,
    AMOTION_EVENT_ACTION_BUTTON_PRESS = 11, AMOTION_EVENT_ACTION_BUTTON_RELEASE = 12;
constexpr int AMOTION_EVENT_FLAG_CANCELED = 32;
constexpr int AMOTION_EVENT_AXIS_X = 0, AMOTION_EVENT_AXIS_Y = 1,
    AMOTION_EVENT_AXIS_PRESSURE = 2, AMOTION_EVENT_AXIS_VSCROLL = 9,
    AMOTION_EVENT_AXIS_HSCROLL = 10;
enum class ToolType { MOUSE = 3 };
struct Properties {
  int id = 0;
  ToolType toolType = ToolType::MOUSE;
  void clear() { id = 0; }
};
struct Coords {
  float axes[16]{};
  void clear() { for (float& value : axes) value = 0; }
  void setAxisValue(int axis, float value) { axes[axis] = value; }
};
struct AndroidEvent {
  enum { kMotion, kFocus };
  int kind = 0, device_id = 0, source = 0, action = 0, flags = 0,
      meta_state = 0, button_state = 0, pointer_count = 0, action_button = 0;
  int64_t down_time = 0, event_time = 0;
  float cursor_x = 0, cursor_y = 0;
  bool has_focus = false;
  Properties properties[1];
  Coords coords[1];
};
int32_t MetaState(int32_t value) { return value; } // Separately covered by key contract tests.
struct KeyHistory { void Reset() {} };
class Translator {
 public:
  void Translate(const WindowEvent&, int64_t, std::vector<AndroidEvent>*);
  static bool IsInput(const WindowEvent&);
  void Mouse(const WindowEvent&, int64_t, std::vector<AndroidEvent>*);
  AndroidEvent MouseMotion(int32_t, float, float, int64_t, int32_t) const;
  void Key(const WindowEvent&, int64_t, std::vector<AndroidEvent>*) {}
  void TouchEvent(const WindowEvent&, int64_t, std::vector<AndroidEvent>*) {}
  void Outside(const WindowEvent&, int64_t, std::vector<AndroidEvent>*) {}
  float X(float x) const { return x * 2 + 5; }
  float Y(float y) const { return y * 2; }
  int buttons_ = 0;
  bool hovering_ = false, has_last_ = false;
  float last_x_ = 0, last_y_ = 0;
  int64_t mouse_down_time_ = 0;
  KeyHistory key_history_;
};
@MOUSE_MOTION@
@MOUSE@
@TRANSLATE@
@IS_INPUT@

using HWND = void*;
constexpr unsigned WM_LBUTTONDOWN = 0x201, WM_LBUTTONUP = 0x202,
    WM_RBUTTONDOWN = 0x204, WM_RBUTTONUP = 0x205,
    WM_MBUTTONDOWN = 0x207, WM_MBUTTONUP = 0x208,
    WM_CAPTURECHANGED = 0x215, WM_CANCELMODE = 0x1f;
int GET_X_LPARAM(intptr_t value) { return static_cast<int16_t>(value); }
int GET_Y_LPARAM(intptr_t value) { return static_cast<int16_t>(value >> 16); }
void SetCapture(HWND);
void ReleaseCapture();
class Window {
 public:
  void* hwnd_ = this;
  int buttons_ = 0, gesture_touches_ = 0;
  Window *route_pointer_ = nullptr, *route_keys_ = nullptr, *gesture_target_ = nullptr;
  bool gesture_active_ = false, gesture_routed_ = false;
  std::vector<Window*> route_outside_;
  std::vector<WindowEvent> received;
  int Modifiers() const { return 0; }
  bool RouteEvent(const WindowEvent&);
  void QueueOwn(const WindowEvent& e) { received.push_back(e); }
  void Queue(const WindowEvent& e) { if (!RouteEvent(e)) QueueOwn(e); }
  intptr_t HandleMessage(unsigned msg, intptr_t lparam = 0) {
    HWND hwnd = hwnd_;
    WindowEvent e;
    switch (msg) {
@PRODUCER@
      default: return -1;
    }
  }
};
std::mutex& RegistryMutex() { static std::mutex mutex; return mutex; }
// Client origins are identical for these ownership tests.
WindowEvent Translated(const WindowEvent& e, HWND, HWND) { return e; }
@IS_POINTER@
@IS_KEY@
@ROUTE@
Window* capture = nullptr;
void SetCapture(HWND hwnd) {
  Window* old = capture;
  capture = static_cast<Window*>(hwnd);
  if (old && old != capture) old->HandleMessage(WM_CAPTURECHANGED);
}
void ReleaseCapture() {
  Window* old = capture;
  capture = nullptr;
  if (old) old->HandleMessage(WM_CAPTURECHANGED);
}
void Send(Window& w, unsigned msg) {
  if (w.HandleMessage(msg) == -1 && msg == WM_CANCELMODE) ReleaseCapture();
}
int checks = 0, failures = 0;
void check(bool ok, const char* name) {
  ++checks;
  if (!ok) { ++failures; std::printf("FAIL %s\n", name); }
}
WindowEvent Event(int type, int button = 0) {
  WindowEvent e; e.type = type; e.button = button; e.x = 10; e.y = 20; return e;
}
int main() {
  Translator t;
  std::vector<AndroidEvent> out;
  check(Translator::IsInput(Event(kCancel)), "cancel is translated input");
  t.Translate(Event(WindowEvent::kMouseDown, 1), 100, &out);
  t.Translate(Event(WindowEvent::kMouseDown, 2), 101, &out);
  out.clear();
  t.Translate(Event(kCancel), 110, &out);
  check(out.size() == 1, "one cancel for a multi-button gesture");
  if (!out.empty()) {
    const auto& e = out.front();
    check(e.action == AMOTION_EVENT_ACTION_CANCEL &&
          (e.flags & AMOTION_EVENT_FLAG_CANCELED), "Android cancellation flag and action");
    check(e.source == AINPUT_SOURCE_MOUSE && e.device_id == kMouseDeviceId,
          "cancel retains mouse source and device");
    check(e.down_time == 100 && e.event_time == 110, "cancel retains original gesture time");
    check(e.cursor_x == 25 && e.cursor_y == 40, "cancel retains scaled last position");
  }
  out.clear();
  t.Translate(Event(kCancel), 111, &out);
  t.Translate(Event(WindowEvent::kMouseUp, 1), 112, &out);
  t.Translate(Event(WindowEvent::kMouseUp, 2), 113, &out);
  check(out.empty(), "duplicate cancel and stale releases do not click");
  t.Translate(Event(WindowEvent::kMouseMove), 114, &out);
  check(out.size() == 1 && out.back().action == AMOTION_EVENT_ACTION_HOVER_ENTER &&
        out.back().button_state == 0, "same-position motion resumes hover");
  out.clear();
  t.Translate(Event(WindowEvent::kMouseDown, 1), 120, &out);
  check(out.size() == 3 && out[1].action == AMOTION_EVENT_ACTION_DOWN &&
        out[1].down_time == 120, "next press starts an independent gesture");
  out.clear();
  t.Translate(Event(WindowEvent::kMouseUp, 1), 125, &out);
  t.Translate(Event(kCancel), 126, &out);
  check(out.size() == 2 && out.back().action == AMOTION_EVENT_ACTION_UP,
        "normal release followed by capture change is not canceled");

  Window origin, first, next, other;
  origin.route_pointer_ = &first;
  Send(origin, WM_LBUTTONDOWN);
  origin.route_pointer_ = &next;
  // Real SetCapture notification is synchronous; simulate a different owner.
  SetCapture(other.hwnd_);
  check(origin.buttons_ == 0, "capture loss clears Win32 button state");
  check(first.received.size() == 2 && first.received.back().type == kCancel,
        "capture cancel reaches original popup target");
  check(next.received.empty(), "capture cancel does not move to new route");
  check(!origin.gesture_active_ && origin.gesture_target_ == nullptr,
        "capture cancel releases popup gesture ownership");
  Send(origin, WM_LBUTTONDOWN);
  check(next.received.size() == 1 && next.received.front().type == WindowEvent::kMouseDown,
        "next gesture follows current popup route");
  Send(origin, WM_LBUTTONUP);
  check(next.received.size() == 2 && next.received.back().type == WindowEvent::kMouseUp,
        "final mouse-up keeps ordinary release notification");
  check(!origin.gesture_active_, "normal final mouse-up clears routing");
  Send(origin, WM_LBUTTONDOWN);
  Send(origin, WM_RBUTTONDOWN);
  const auto count = next.received.size();
  Send(origin, WM_CANCELMODE);
  check(capture == nullptr, "cancel mode preserves DefWindowProc release");
  check(next.received.size() == count + 1 && next.received.back().type == kCancel,
        "cancel mode emits one cancellation despite reentrant capture message");
  Send(origin, WM_CANCELMODE);
  check(next.received.size() == count + 1, "inactive cancel mode is silent");
  capture = nullptr;
  std::printf("mouse capture contracts: %d checks, %d failures\n", checks, failures);
  return failures ? 1 : 0;
}
