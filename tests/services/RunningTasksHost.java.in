import java.util.*;

/** Host-only value adapters; the aggregation method is inserted verbatim from production. */
public final class RunningTasksHost {
    static final class Bundle {}
    static final class Display { static final int INVALID_DISPLAY = -1, DEFAULT_DISPLAY = 0; }
    static final class Configuration { void setTo(Configuration other) {} }
    static final class LocaleManagerService {
        static Configuration configurationFor(String name) { return new Configuration(); }
    }
    static final class Intent {
        final String name;
        String extra;
        Intent(String name) { this.name = this.extra = name; }
        Intent(Intent from) { name = from.name; extra = from.extra; }
        Intent replaceExtras(Bundle ignored) { extra = null; return this; }
    }
    static final class ActivityManager {
        static final class RunningTaskInfo {
            int taskId, id, numActivities, displayId, userId;
            String baseActivity, topActivity;
            Intent baseIntent;
            boolean isRunning;
            Object token;
            Configuration configuration = new Configuration();
        }
    }
    enum State { RESUMED, DESTROYED }
    static final class Info { String packageName = "com.gesher.snapshot"; }
    static final class ActivityRecord {
        final int taskId;
        final Intent intent;
        final Info info = new Info();
        final Object taskToken = new Object();
        Object app = new Object();
        State state;
        ActivityRecord(int id, String name, State state) {
            taskId = id; intent = new Intent(name); this.state = state;
        }
        String component() { return intent.name; }
    }
    final List<ActivityRecord> mActivities = new ArrayList<>();
    // PRODUCTION_METHOD

    static int checks;
    static void check(boolean ok, String message) {
        if (!ok) throw new AssertionError(message);
        checks++;
    }
    public static void main(String[] args) {
        RunningTasksHost host = new RunningTasksHost();
        host.mActivities.add(new ActivityRecord(11, "ABase", State.RESUMED));
        host.mActivities.add(new ActivityRecord(22, "BBase", State.RESUMED));
        host.mActivities.add(new ActivityRecord(11, "AMiddle", State.RESUMED));
        host.mActivities.add(new ActivityRecord(22, "BTop", State.RESUMED));
        host.mActivities.add(new ActivityRecord(11, "ATop", State.RESUMED));
        host.mActivities.add(new ActivityRecord(11, "ADestroyed", State.DESTROYED));
        host.mActivities.add(new ActivityRecord(33, "CDestroyed", State.DESTROYED));
        for (int cap : new int[]{1, 2, 10}) {
            List<ActivityManager.RunningTaskInfo> values = host.getTasks(cap, false, false, -1);
            check(values.size() == Math.min(cap, 2), "result cap");
            ActivityManager.RunningTaskInfo first = values.get(0);
            check(first.taskId == 11, "recency order");
            check(first.baseActivity.equals("ABase"), "base must be independent of result cap " + cap);
            check(first.topActivity.equals("ATop"), "top skips destroyed records");
            check(first.numActivities == 3, "full activity count at cap " + cap);
            check(first.baseIntent.name.equals("ABase") && first.baseIntent.extra == null,
                    "base intent and stripped extras");
            if (cap > 1) {
                ActivityManager.RunningTaskInfo second = values.get(1);
                check(second.taskId == 22 && second.baseActivity.equals("BBase")
                        && second.topActivity.equals("BTop") && second.numActivities == 2,
                        "interleaved second task aggregation");
            }
        }
        ActivityManager.RunningTaskInfo copied = host.getTasks(1, false, true, 0).get(0);
        check(copied.baseIntent.extra.equals("ABase"), "keep base extras");
        copied.baseIntent.extra = "mutated";
        check(host.getTasks(1, false, true, 0).get(0).baseIntent.extra.equals("ABase"), "intent copy");
        check(host.getTasks(0, false, false, -1).isEmpty(), "zero cap");
        check(host.getTasks(-1, false, false, -1).isEmpty(), "negative cap");
        check(host.getTasks(5, false, false, 99).isEmpty(), "foreign display");
        System.out.println("RunningTasksHost all passed: " + checks);
    }
}
