package com.gesher.app.webview;

import java.lang.management.ManagementFactory;
import java.lang.reflect.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.*;

public final class WebViewBoundaryDispatchHost {
    private static final boolean CACHE_GATE = @CACHE_GATE@;
    private static final AtomicInteger LOOKUPS = new AtomicInteger();
    private static int checks;

    @PRODUCTION@

    private static Method lookup(Object delegate, Method method) throws NoSuchMethodException {
        LOOKUPS.incrementAndGet();
        return delegate.getClass().getMethod(method.getName(), method.getParameterTypes());
    }

    @INTERFACES@

    interface Api {
        void ping();
        int echo(int value);
        String echo(String value);
        Object identity(Object value);
        void fail() throws Exception;
        void recurse(int remaining);
        String missing();
        String[] getSupportedFeatures();
    }
    private static final class Delegate {
        InvocationHandler handler;
        final AtomicInteger calls = new AtomicInteger();
        final Exception failure = new Exception("fixture identity");
        public void ping() { calls.incrementAndGet(); }
        public int echo(int value) { return value * 3; }
        public String echo(String value) { return value; }
        public Object identity(Object value) { return value; }
        public void fail() throws Exception { throw failure; }
        public void recurse(int remaining) {
            calls.incrementAndGet();
            if (remaining == 0) return;
            try { handler.invoke(null, Api.class.getMethod("recurse", int.class), new Object[] {remaining - 1}); }
            catch (Throwable failure) { throw new AssertionError(failure); }
        }
    }

    private static void check(boolean condition, String message) {
        checks++;
        if (!condition) throw new AssertionError(message);
    }

    private static void behavior() throws Throwable {
        Delegate delegate = new Delegate();
        InvocationHandler handler = Boundary.of(delegate);
        delegate.handler = handler;
        Api api = (Api) Proxy.newProxyInstance(Api.class.getClassLoader(), new Class<?>[] {Api.class}, handler);
        check(Boundary.of(null) == null, "null boundary");
        api.ping();
        check(delegate.calls.get() == 1, "private-class public method");
        check(api.echo(7) == 21, "primitive overload");
        check(api.echo("hello").equals("hello"), "reference overload");
        check(api.echo((String) null) == null, "null reference");
        Object object = new Object();
        check(api.identity(object) == object, "argument/result identity");
        check(api.identity(null) == null, "null identity");
        for (int i = 0; i < 2; i++) {
            try { api.fail(); throw new AssertionError("expected checked exception"); }
            catch (Exception failure) { check(failure == delegate.failure, "unwrapped exception identity"); }
            try { api.missing(); throw new AssertionError("expected unsupported method"); }
            catch (UnsupportedOperationException failure) {
                check(failure.getMessage().equals("Gesher's WebView does not implement Api.missing"), "missing diagnostic");
            }
        }
        String[] first = api.getSupportedFeatures(), second = api.getSupportedFeatures();
        check(first.length == 0 && second.length == 0 && first != second, "feature fallback fresh empty arrays");
        api.recurse(12);
        check(delegate.calls.get() == 14, "recursive dispatch");
        check(handler.invoke(null, Object.class.getMethod("toString"), null).equals(delegate.toString()), "Object dispatch");
        Delegate other = new Delegate();
        check(Boundary.of(other).invoke(null, Api.class.getMethod("identity", Object.class),
                new Object[] {object}) == object, "independent wrappers");
        Method echo = Api.class.getMethod("echo", int.class);
        try { handler.invoke(null, echo, new Object[] {"wrong"}); throw new AssertionError("bad argument accepted"); }
        catch (IllegalArgumentException expected) { check(true, "bad argument failure preserved"); }
        check(((Integer) handler.invoke(null, echo, new Object[] {9})) == 27, "failure does not poison resolution");
    }

    private static void concurrent() throws Throwable {
        Delegate delegate = new Delegate();
        InvocationHandler handler = Boundary.of(delegate);
        Method ping = Api.class.getMethod("ping");
        int before = LOOKUPS.get();
        CountDownLatch ready = new CountDownLatch(8), start = new CountDownLatch(1);
        AtomicReference<Throwable> error = new AtomicReference<>();
        Thread[] threads = new Thread[8];
        for (int i = 0; i < threads.length; i++) {
            threads[i] = new Thread(() -> {
                ready.countDown();
                try {
                    start.await();
                    for (int n = 0; n < 10000; n++) handler.invoke(null, ping, null);
                } catch (Throwable failure) { error.compareAndSet(null, failure); }
            });
            threads[i].start();
        }
        check(ready.await(10, TimeUnit.SECONDS), "concurrent readiness");
        start.countDown();
        for (Thread thread : threads) { thread.join(10000); check(!thread.isAlive(), "concurrent completion"); }
        check(error.get() == null, "concurrent errors: " + error.get());
        check(delegate.calls.get() == 80000, "every concurrent call delivered");
        int lookups = LOOKUPS.get() - before;
        System.out.println("concurrent cold/warm calls=80000 reflection lookups=" + lookups);
        if (CACHE_GATE) check(lookups == 1, "cold concurrent method resolved once");
    }

    private static void bounded() throws Throwable {
        Class<?>[] aliases = {@ALIASES@};
        InvocationHandler handler = Boundary.of(new Delegate());
        for (Class<?> alias : aliases) handler.invoke(null, alias.getMethod("ping"), null);
        // An app may hand the InvocationHandler arbitrarily many distinct Methods.
        // Saturation must retain the same successful invocation behavior.
        int before = LOOKUPS.get();
        for (int round = 0; round < 3; round++) {
            for (Class<?> alias : aliases) handler.invoke(null, alias.getMethod("ping"), null);
        }
        int after = LOOKUPS.get() - before;
        System.out.println("96 method identities, saturated repeat reflection lookups=" + after);
        if (CACHE_GATE) check(after == (96 - 64) * 3, "cache bounded to 64 successful method identities");
    }

    private static void measurement() throws Throwable {
        com.sun.management.ThreadMXBean bean = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
        bean.setThreadAllocatedMemoryEnabled(true);
        InvocationHandler handler = Boundary.of(new Delegate());
        Method ping = Api.class.getMethod("ping");
        for (int i = 0; i < 30000; i++) handler.invoke(null, ping, null);
        int beforeLookups = LOOKUPS.get();
        long thread = Thread.currentThread().threadId();
        long before = bean.getThreadAllocatedBytes(thread);
        for (int i = 0; i < 100000; i++) handler.invoke(null, ping, null);
        long allocated = bean.getThreadAllocatedBytes(thread) - before;
        int lookups = LOOKUPS.get() - beforeLookups;
        System.out.println("100000 warmed dispatches: reflection lookups=" + lookups + " allocated bytes=" + allocated);
        if (CACHE_GATE) {
            check(lookups == 0, "warm dispatch avoids reflection lookup");
            check(allocated < 100000L * 16, "warm dispatch allocation bound");
        }
    }

    public static void main(String[] args) throws Throwable {
        behavior(); concurrent(); bounded(); measurement();
        System.out.println("WebView boundary dispatch checks passed: " + checks);
    }
}
