// Allocation measurement is local to the explicitly driven production mixer.
#include <array>
#include <cstdlib>
#include <new>

namespace {
thread_local bool count_allocations = false;
thread_local size_t allocations = 0, allocation_bytes = 0;
}
void* operator new(size_t size) {
  if (count_allocations) { ++allocations; allocation_bytes += size; }
  if (void* pointer = std::malloc(size == 0 ? 1 : size)) return pointer;
  std::abort();
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* pointer) noexcept { std::free(pointer); }
void operator delete[](void* pointer) noexcept { std::free(pointer); }
void operator delete(void* pointer, size_t) noexcept { std::free(pointer); }
void operator delete[](void* pointer, size_t) noexcept { std::free(pointer); }

@PRODUCTION@

namespace {
using namespace gesher::media;
constexpr size_t kFrames = 480, kBlocks = 100, kWarmBlocks = 100;
int checks = 0, failures = 0;
Engine engine;
void Check(bool okay, const char* why) {
  ++checks;
  if (!okay) { ++failures; std::fprintf(stderr, "FAIL mixer allocation: %s\n", why); }
}
void Write(FILE* output, const void* data, size_t size) {
  if (std::fwrite(data, 1, size, output) != size) std::abort();
}

std::vector<uint8_t> Payload(PcmFormat format, uint32_t channels, size_t frames) {
  const size_t bytes = BytesPerSample(format);
  std::vector<uint8_t> data(frames * channels * bytes);
  for (size_t i = 0; i < frames * channels; ++i) {
    // Identical, exactly representable sample levels across all five formats.
    const int level = static_cast<int>((i * 17 + i / channels * 3) % 201) - 100;
    uint8_t* p = data.data() + i * bytes;
    switch (format) {
      case PcmFormat::kU8: *p = static_cast<uint8_t>(128 + level); break;
      case PcmFormat::kS16: {
        int16_t v = static_cast<int16_t>(level * 256); std::memcpy(p, &v, 2); break;
      }
      case PcmFormat::kS24Packed: {
        uint32_t v = static_cast<uint32_t>(level * 65536);
        p[0] = static_cast<uint8_t>(v); p[1] = static_cast<uint8_t>(v >> 8);
        p[2] = static_cast<uint8_t>(v >> 16); break;
      }
      case PcmFormat::kS32: {
        int32_t v = level * 16777216; std::memcpy(p, &v, 4); break;
      }
      case PcmFormat::kFloat: {
        float v = level / 128.0f; std::memcpy(p, &v, 4); break;
      }
    }
  }
  return data;
}

void Record(Track& track, FILE* output, size_t frames = kFrames, uint32_t channels = 2) {
  std::array<float, kFrames * 2> mix{};
  bool active = track.MixInto(mix.data(), frames, 48000, channels);
  uint32_t position = track.Position();
  Write(output, &active, sizeof active);
  Write(output, &position, sizeof position);
  Write(output, mix.data(), frames * channels * sizeof(float));
}

void Case(PcmFormat format, uint32_t channels, uint32_t rate, FILE* output, bool enforce) {
  constexpr size_t source_frames = 4096;
  TrackParams params;
  params.is_static = true;
  params.channels = channels;
  params.sample_rate = rate;
  params.format = format;
  params.capacity_frames = source_frames;
  Track track(&engine, params);
  const auto data = Payload(format, channels, source_frames);
  Check(track.Write(data.data(), data.size(), false) == static_cast<ssize_t>(data.size()),
        "complete static PCM load");
  Check(track.SetLoop(0, source_frames, -1) == kOk && track.Start() == kOk,
        "looped track starts");
  std::vector<float> output_blocks(kBlocks * kFrames * 2);
  std::array<uint32_t, kBlocks> positions{};
  std::array<float, kFrames * 2> warm{};
  bool warm_active = true;
  for (size_t i = 0; i < kWarmBlocks; ++i) {
    warm.fill(0);
    warm_active &= track.MixInto(warm.data(), kFrames, 48000, 2);
  }
  Check(warm_active, "warm loop remains active");
  allocations = allocation_bytes = 0;
  bool all_active = true;
  count_allocations = true;
  for (size_t block = 0; block < kBlocks; ++block) {
    all_active &= track.MixInto(output_blocks.data() + block * kFrames * 2, kFrames, 48000, 2);
    positions[block] = track.Position();
  }
  count_allocations = false;
  const size_t measured_allocations = allocations, measured_bytes = allocation_bytes;
  Check(all_active, "measured loop remains active");
  if (enforce) Check(measured_allocations == 0, "warmed fixed-configuration mixes do not allocate");
  std::printf("mixer format=%d channels=%u rate=%u blocks=%zu allocations=%zu bytes=%zu\n",
              static_cast<int>(format), channels, rate, kBlocks, measured_allocations, measured_bytes);
  Write(output, output_blocks.data(), output_blocks.size() * sizeof(float));
  Write(output, positions.data(), positions.size() * sizeof(uint32_t));

  // Preserve output/position semantics through parameter changes and scratch reuse.
  track.SetVolume(0.25f, 0.75f); Record(track, output, 137);
  track.Pause(); Record(track, output);
  Check(track.SetPosition(123) == kOk && track.Start() == kOk, "seek/restart succeeds");
  Record(track, output, 311, 1);
  track.SetSpeed(1.25f); Record(track, output);
  Check(track.SetSampleRate(rate / 2) == kOk, "sample-rate change succeeds");
  Record(track, output);
  track.Stop(); Record(track, output);
  Check(track.Reload() == kOk && track.SetLoop(4, 1024, -1) == kOk && track.Start() == kOk,
        "reload with partial loop succeeds");
  for (size_t i = 0; i < 12; ++i) Record(track, output);
  track.Release(); Record(track, output);
}
}

int main(int argc, char** argv) {
  if (argc != 3) return 2;
  FILE* output = std::fopen(argv[1], "wb");
  if (output == nullptr) return 2;
  const bool enforce = std::strcmp(argv[2], "gate") == 0;
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed,
                          PcmFormat::kS32, PcmFormat::kFloat})
    for (uint32_t channels : {1u, 2u, 8u, 24u})
      for (uint32_t rate : {44100u, 48000u, 96000u}) Case(format, channels, rate, output, enforce);
  if (std::fclose(output) != 0) return 2;
  std::printf("audio mixer allocation contracts: %d checks, %d failures\n", checks, failures);
  return failures != 0;
}
