// The host boundary substitutes only Android headers and their inline dispatch.
// Production entrypoints and shared assertions are inserted without rewriting.
#include <cerrno>
#include <cstdint>
#include <initializer_list>
struct ANativeWindow_Buffer {};
struct ARect {};
struct ANativeWindow {
  int (*query)(const ANativeWindow*, int, int*) = nullptr;
  int (*perform)(ANativeWindow*, int, ...) = nullptr;
};
using android_dataspace_t = int;
enum {
  NATIVE_WINDOW_IS_VALID, NATIVE_WINDOW_DATASPACE, NATIVE_WINDOW_DEFAULT_DATASPACE,
  NATIVE_WINDOW_LOCK, NATIVE_WINDOW_UNLOCK_AND_POST, NATIVE_WINDOW_SET_BUFFERS_FORMAT,
  NATIVE_WINDOW_SET_BUFFERS_USER_DIMENSIONS, NATIVE_WINDOW_SET_BUFFERS_TRANSFORM,
  NATIVE_WINDOW_SET_BUFFERS_DATASPACE, NATIVE_WINDOW_SET_FRAME_RATE
};
constexpr int NATIVE_WINDOW_TRANSFORM_FLIP_H = 1, NATIVE_WINDOW_TRANSFORM_FLIP_V = 2;
constexpr int NATIVE_WINDOW_TRANSFORM_ROT_90 = 4, NATIVE_WINDOW_TRANSFORM_INVERSE_DISPLAY = 8;
constexpr int ANATIVEWINDOW_CHANGE_FRAME_RATE_ONLY_IF_SEAMLESS = 0;
inline int native_window_set_buffers_format(ANativeWindow* w, int x) {
  return w->perform(w, NATIVE_WINDOW_SET_BUFFERS_FORMAT, x);
}
inline int native_window_set_buffers_user_dimensions(ANativeWindow* w, int x, int y) {
  return w->perform(w, NATIVE_WINDOW_SET_BUFFERS_USER_DIMENSIONS, x, y);
}
inline int native_window_set_buffers_transform(ANativeWindow* w, int x) {
  return w->perform(w, NATIVE_WINDOW_SET_BUFFERS_TRANSFORM, x);
}
inline int native_window_set_buffers_data_space(ANativeWindow* w, android_dataspace_t x) {
  return w->perform(w, NATIVE_WINDOW_SET_BUFFERS_DATASPACE, x);
}
extern "C" int32_t ANativeWindow_setFrameRateWithChangeStrategy(ANativeWindow*, float, int8_t, int8_t);
@PRODUCTION@
@ASSERTIONS@
int main(int argc, char**) {
  return native_window_dispatch_contract::Run(argc == 1) != 0;
}
