// Real JNI and production receiver/source code. Only the media parser is a
// deterministic observer: byte 2 carries art, byte 1 has no art, 0 is unreadable.
#include <jni.h>
#include <algorithm>
#include <cstdint>
#include <limits>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <vector>
#include "compat/media/jni/java_data_source.h"
#include "compat/media/jni/receiver_lease.h"
#define MEDIA_LOGE(...) ((void)0)
namespace gesher::media {
JavaVM* host_vm;
JNIEnv* AttachedEnv(const char*) {
  struct Attachment {
    JNIEnv* env = nullptr;
    bool detach = false;
    Attachment() {
      if (host_vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK) {
        detach = host_vm->AttachCurrentThreadAsDaemon(reinterpret_cast<void**>(&env), nullptr) == JNI_OK;
      }
    }
    ~Attachment() { if (detach) host_vm->DetachCurrentThread(); }
  };
  thread_local Attachment attachment;
  return attachment.env;
}
bool CheckException(JNIEnv* env, const char*) {
  if (!env->ExceptionCheck()) return false;
  env->ExceptionClear();
  return true;
}
void jniThrow(JNIEnv* env, const char* type, const char* message) {
  jclass cls = env->FindClass(type);
  if (cls != nullptr) { env->ThrowNew(cls, message); env->DeleteLocalRef(cls); }
}
struct Format {
  uint8_t tag;
  std::string Mime() const { return "audio/raw"; }
  bool GetString(const char* key, std::string* out) const {
    if (std::string(key) != "title") return false;
    *out = std::to_string(tag); return true;
  }
  bool GetBuffer(const char*, std::vector<uint8_t>* out) const {
    if (tag != 2) return false; // Deliberately leaves absent output unchanged.
    *out = {11, 22, 33}; return true;
  }
  bool GetInt64(const char* key, int64_t* out) const {
    if (std::string(key) != "durationUs") return false;
    *out = 1000000; return true;
  }
  bool GetInt32(const char* key, int32_t* out) const {
    if (std::string(key) != "sample-rate") return false;
    *out = 8000; return true;
  }
};
enum class SeekMode { kPrevious, kNext, kClosest };
struct Sample { int64_t time_us = 0; };
struct TrackReader {
  std::shared_ptr<DataSource> source;
  int Read(Sample* sample, int64_t = 0, SeekMode = SeekMode::kPrevious) {
    uint8_t tag = 0;
    if (source->ReadAt(0, &tag, 1) != 1) return -1;
    sample->time_us = tag;
    return 0;
  }
};
struct Extractor {
  uint8_t tag;
  std::shared_ptr<DataSource> source;
  static std::unique_ptr<Extractor> Open(std::shared_ptr<DataSource> source, std::string*) {
    uint8_t tag = 0;
    if (source->ReadAt(0, &tag, 1) != 1 || tag == 0) return nullptr;
    return std::unique_ptr<Extractor>(new Extractor{tag, source});
  }
  Format FileFormat() const { return {tag}; }
  Format TrackFormat(size_t) const { return {tag}; }
  size_t TrackCount() const { return 1; }
  std::unique_ptr<TrackReader> OpenTrack(size_t) { return std::unique_ptr<TrackReader>(new TrackReader{source}); }
};
@RETRIEVER@
@EXTRACTOR@

void JNICALL Setup(JNIEnv* env, jobject thiz, jboolean extractor) {
  if (extractor) ME_setup(env, thiz); else MMR_setup(env, thiz);
}
void JNICALL Release(JNIEnv* env, jobject thiz, jboolean extractor) {
  if (extractor) ME_release(env, thiz); else MMR_release(env, thiz);
}
void JNICALL Source(JNIEnv* env, jobject thiz, jboolean extractor, jobject callback) {
  if (extractor) ME_setDataSourceCallback(env, thiz, callback);
  else MMR_setDataSourceCallback(env, thiz, callback);
}
jbyteArray JNICALL Read(JNIEnv* env, jclass, jobject callback, jlong offset, jint size) {
  auto source = OpenJavaDataSource(env, callback);
  if (source == nullptr) return nullptr;
  std::vector<uint8_t> bytes(static_cast<size_t>(std::max(size, 0)) + 16, 0x6b);
  ssize_t count = source->ReadAt(offset, bytes.data() + 8, static_cast<size_t>(size));
  for (size_t i = 0; i < 8; ++i) {
    if (bytes[i] != 0x6b || bytes[bytes.size() - 1 - i] != 0x6b) {
      jniThrow(env, "java/lang/AssertionError", "native guard bytes changed"); return nullptr;
    }
  }
  if (count < 0) return nullptr;
  jbyteArray result = env->NewByteArray(static_cast<jsize>(count));
  if (result != nullptr) env->SetByteArrayRegion(result, 0, static_cast<jsize>(count),
                                                reinterpret_cast<jbyte*>(bytes.data() + 8));
  return result;
}
jlong JNICALL Probe(JNIEnv* env, jclass, jobject callback, jint mode) {
  auto source = OpenJavaDataSource(env, callback);
  if (source == nullptr) return -99;
  if (mode == 0) {
    source->Size(); return source->Size();
  }
  if (mode == 1) {
    uint8_t byte = 0; source->ReadAt(0, &byte, 1); return source->ReadAt(0, &byte, 1);
  }
  if (mode == 2) {
    jniThrow(env, "java/io/IOException", "original failure"); return 0;
  }
  std::atomic<int> successes{0};
  auto read = [&] {
    std::vector<uint8_t> bytes(131077);
    if (source->ReadAt(0, bytes.data(), bytes.size()) != static_cast<ssize_t>(bytes.size())) return;
    for (size_t i = 0; i < bytes.size(); ++i) if (bytes[i] != static_cast<uint8_t>(i * 17 + 3)) return;
    ++successes;
  };
  std::thread one(read), two(read);
  one.join(); two.join();
  return successes;
}
const JNINativeMethod methods[] = {
  {const_cast<char*>("setup"), const_cast<char*>("(Z)V"), reinterpret_cast<void*>(&Setup)},
  {const_cast<char*>("release"), const_cast<char*>("(Z)V"), reinterpret_cast<void*>(&Release)},
  {const_cast<char*>("source"), const_cast<char*>("(ZLMediaCallbackHostTest$Source;)V"), reinterpret_cast<void*>(&Source)},
  {const_cast<char*>("metadata"), const_cast<char*>("(I)Ljava/lang/String;"), reinterpret_cast<void*>(&MMR_extractMetadata)},
  {const_cast<char*>("artwork"), const_cast<char*>("(I)[B"), reinterpret_cast<void*>(&MMR_getEmbeddedPicture)},
  {const_cast<char*>("select"), const_cast<char*>("(I)V"), reinterpret_cast<void*>(&ME_selectTrack)},
  {const_cast<char*>("unselect"), const_cast<char*>("(I)V"), reinterpret_cast<void*>(&ME_unselectTrack)},
  {const_cast<char*>("seek"), const_cast<char*>("(JI)V"), reinterpret_cast<void*>(&ME_seekTo)},
  {const_cast<char*>("time"), const_cast<char*>("()J"), reinterpret_cast<void*>(&ME_getSampleTime)},
  {const_cast<char*>("tracks"), const_cast<char*>("()I"), reinterpret_cast<void*>(&ME_getTrackCount)},
  {const_cast<char*>("read"), const_cast<char*>("(LMediaCallbackHostTest$Source;JI)[B"), reinterpret_cast<void*>(&Read)},
  {const_cast<char*>("probe"), const_cast<char*>("(LMediaCallbackHostTest$Source;I)J"), reinterpret_cast<void*>(&Probe)},
};
} // namespace gesher::media
extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* vm, void*) {
  using namespace gesher::media;
  host_vm = vm;
  JNIEnv* env = AttachedEnv("main");
  jclass cls = env->FindClass("MediaCallbackHostTest");
  gContext = gRetrieverContext = env->GetFieldID(cls, "context", "J");
  if (env->RegisterNatives(cls, methods, sizeof(methods) / sizeof(methods[0])) != JNI_OK) return JNI_ERR;
  return JNI_VERSION_1_6;
}
