// Win32 buffer locking/posting is the boundary; both presentation methods are production source.
#include <algorithm>
#include <chrono>
#include <climits>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <mutex>
#include <new>
#include <vector>

bool count_allocations = false;
size_t allocations = 0, allocated_bytes = 0, checks = 0, failures = 0;
void* operator new(size_t size) {
  if (count_allocations) { ++allocations; allocated_bytes += size; }
  if (void* p = std::malloc(size != 0 ? size : 1)) return p;
  std::abort();
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { ++failures; if (failures < 12) std::fprintf(stderr, "FAIL presentation: %s\n", reason); }
}
namespace gesher {
class Window {
 public:
  Window(int width, int height, int stride = 0)
      : w_(width), h_(height), stride_(stride ? stride : width),
        reported_w_(width), reported_h_(height),
        pixels(static_cast<size_t>(stride_) * height, 0xaabbccdd) {}
  int width() const { return reported_w_; }
  int height() const { return reported_h_; }
  uint8_t* Lock(int* width, int* height, int* stride) {
    ++locks;
    *width = w_; *height = h_; *stride = stride_;
    return reinterpret_cast<uint8_t*>(pixels.data());
  }
  void UnlockAndPost() { ++posts; }
  @WINDOW_DECLARATION@
  int w_, h_, stride_, reported_w_, reported_h_, locks = 0, posts = 0;
  std::vector<uint32_t> pixels;
};
class Win32Surface {
 public:
  Win32Surface(Window* window, int left, int top, int right, int bottom)
      : window_(window), inset_left_(left), inset_top_(top), inset_right_(right), inset_bottom_(bottom) {}
  void PresentPixels(const uint32_t* argb, int width, int height);
  Window* window_;
  int inset_left_, inset_top_, inset_right_, inset_bottom_;
  std::mutex mutex_;
};
}
@PRODUCTION@

// Independent coordinate oracle, including the historical no-publication rule
// for an inset crop with no pixels (its previous back buffer remains visible).
void Case(int sw, int sh, int dw, int dh, int l, int t, int r, int b, bool gate) {
  std::vector<uint32_t> source(static_cast<size_t>(sw) * sh);
  for (size_t p = 0; p < source.size(); ++p) source[p] = 0xff000000 | static_cast<uint32_t>(p);
  const auto original = source;
  gesher::Window window(dw, dh);
  gesher::Win32Surface surface(&window, l, t, r, b);
  bool inset = l || t || r || b;
  int cols = static_cast<int>(std::min<int64_t>(dw, std::max<int64_t>(0, int64_t{sw} - l - r)));
  int rows = static_cast<int>(std::min<int64_t>(dh, std::max<int64_t>(0, int64_t{sh} - t - b)));
  bool present = !inset || (cols > 0 && rows > 0);
  std::vector<uint32_t> expected(static_cast<size_t>(dw) * dh, present ? 0 : 0xaabbccdd);
  if (present) {
    int visible_width = inset ? cols : sw, visible_height = inset ? rows : sh;
    for (int y = 0; y < dh; ++y)
      for (int x = 0; x < dw; ++x)
        if (x < visible_width && y < visible_height)
          expected[static_cast<size_t>(y) * dw + x] = source[static_cast<size_t>(y + t) * sw + x + l];
  }
  allocations = allocated_bytes = 0;
  count_allocations = true;
  surface.PresentPixels(source.data(), sw, sh);
  count_allocations = false;
  Check(window.pixels == expected, "exact crop/clip/padding coordinates");
  Check(source == original, "source ownership and bytes unchanged");
  Check(window.posts == int(present) && window.locks == int(present), "single synchronous post or empty-crop no-op");
  if (gate) Check(allocations == 0 && allocated_bytes == 0, "no intermediate cropped-frame allocation");
  // Publication owns a copy: changing the caller's source after return cannot
  // alter the window's back buffer or a pending paint.
  std::fill(source.begin(), source.end(), 0);
  Check(window.pixels == expected, "window owns the published pixels");
}

void Measure(bool inset) {
  constexpr int w = 1280, h = 720, frames = 200;
  std::vector<uint32_t> source(static_cast<size_t>(w + 16) * (h + 24), 0xff337799);
  gesher::Window window(w, h);
  gesher::Win32Surface surface(&window, inset ? 8 : 0, inset ? 12 : 0,
                              inset ? 8 : 0, inset ? 12 : 0);
  surface.PresentPixels(source.data(), w + 16, h + 24);
  allocations = allocated_bytes = 0;
  const auto begin = std::chrono::steady_clock::now();
  count_allocations = true;
  for (int i = 0; i < frames; ++i) surface.PresentPixels(source.data(), w + 16, h + 24);
  count_allocations = false;
  double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
  Check(std::all_of(window.pixels.begin(), window.pixels.end(), [](uint32_t p) { return p == 0xff337799; }),
        "measured visible frame bytes");
  std::printf("Surface %s 1280x720: %d frames, %zu allocations, %zu bytes, %.3f ms\n",
              inset ? "inset" : "plain", frames, allocations, allocated_bytes, ms);
}

// Independent QA: planning dimensions may change before Window::Lock takes
// its buffer mutex. Neither that resize nor a padded destination row may
// change the cropped source's stride or overwrite padding outside the view.
void ResizeAndPaddingCase(int locked_width, int locked_height, bool gate) {
  constexpr int sw = 13, sh = 9, l = 2, t = 1, r = 1, b = 2;
  std::vector<uint32_t> source(sw * sh);
  for (size_t i = 0; i < source.size(); ++i) source[i] = 0xff123000u + static_cast<uint32_t>(i);
  const auto original = source;
  gesher::Window window(locked_width, locked_height, locked_width + 3);
  window.reported_w_ = 7;
  window.reported_h_ = 4;
  gesher::Win32Surface surface(&window, l, t, r, b);
  std::vector<uint32_t> expected(window.pixels.size(), 0xaabbccdd);
  for (int y = 0; y < locked_height; ++y)
    for (int x = 0; x < locked_width; ++x)
      expected[static_cast<size_t>(y) * window.stride_ + x] =
          y < 4 && x < 7 ? source[static_cast<size_t>(y + t) * sw + x + l] : 0;
  allocations = allocated_bytes = 0;
  count_allocations = true;
  surface.PresentPixels(source.data(), sw, sh);
  count_allocations = false;
  Check(window.pixels == expected, "resize at lock preserves cropped source stride and destination padding");
  Check(window.posts == 1 && window.locks == 1, "resized view publishes exactly once");
  Check(source == original, "resized view leaves source bytes unchanged");
  if (gate) Check(allocations == 0 && allocated_bytes == 0, "resized view allocates no intermediate storage");
  std::fill(source.begin(), source.end(), 0);
  Check(window.pixels == expected, "resized publication owns its copied pixels");
}

int main(int argc, char** argv) {
  bool gate = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  for (int sw : {1, 2, 7, 12})
    for (int sh : {1, 3, 9})
      for (int dw : {1, 4, 8})
        for (int dh : {1, 5, 11}) {
          Case(sw, sh, dw, dh, 0, 0, 0, 0, gate);
          for (int l = 0; l <= sw; ++l)
            for (int t = 0; t <= sh; ++t) {
              Case(sw, sh, dw, dh, l, t, 1, 2, gate);
              Case(sw, sh, dw, dh, l, t, sw + 1, sh + 1, gate);
            }
        }
  Case(1296, 744, 1280, 720, 8, 12, 8, 12, gate);
  // Independent QA: oversized insets must stay an empty crop without integer
  // wraparound or forming an out-of-range source pointer.
  Case(7, 9, 4, 5, INT_MAX, 0, INT_MAX, 0, gate);
  Case(7, 9, 4, 5, 0, INT_MAX, 0, INT_MAX, gate);
  Case(7, 9, 4, 5, INT_MAX, 1, 0, 0, gate);
  Case(7, 9, 4, 5, 1, INT_MAX, 0, 0, gate);
  Case(0, 0, 4, 5, 0, 0, 0, 0, gate);
  Case(0, 4, 4, 5, 1, 0, 0, 0, gate);
  ResizeAndPaddingCase(3, 2, gate);
  ResizeAndPaddingCase(11, 8, gate);
  // A null source with insets remains a no-op.
  gesher::Window window(4, 6);
  gesher::Win32Surface surface(&window, 1, 1, 1, 1);
  surface.PresentPixels(nullptr, 4, 6);
  Check(window.posts == 0 && window.locks == 0, "null inset source ignored");
  Measure(false);
  Measure(true);
  std::printf("Surface presentation: %zu checks, %zu failures\n", checks, failures);
  return failures != 0;
}
