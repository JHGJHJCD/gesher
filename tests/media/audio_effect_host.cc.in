#include <jni.h>
#define GESHER_NATIVE(fn) reinterpret_cast<void*>(&(fn))
@EFFECTS@
// Defer each registration until that real class's native_init. Resolving both
// classes from JNI_OnLoad would initialize the second before the host JVM has
// finished associating this library with the classloader.
extern "C" JNIEXPORT void JNICALL Java_android_media_audiofx_AudioEffect_native_1init(JNIEnv* env, jclass cls) {
  env->RegisterNatives(cls, kUnavailableEffectMethods,
      sizeof(kUnavailableEffectMethods) / sizeof(kUnavailableEffectMethods[0]));
}
extern "C" JNIEXPORT void JNICALL Java_android_media_audiofx_Visualizer_native_1init(JNIEnv* env, jclass cls) {
  env->RegisterNatives(cls, kUnavailableVisualizerMethods,
      sizeof(kUnavailableVisualizerMethods) / sizeof(kUnavailableVisualizerMethods[0]));
}
