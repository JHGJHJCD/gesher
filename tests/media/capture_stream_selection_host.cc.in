// Exact capture-engine membership method, with atomic stream-state adapters.
#include <algorithm>
#include <atomic>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <mutex>
#include <new>
#include <thread>
#include <vector>

thread_local bool counting = false;
thread_local size_t allocations = 0, allocated_bytes = 0;
void* operator new(size_t bytes) {
  if (counting) { ++allocations; allocated_bytes += bytes; }
  if (void* p = std::malloc(bytes ? bytes : 1)) return p;
  std::abort();
}
void* operator new[](size_t bytes) { return ::operator new(bytes); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }

struct CaptureStream {
  explicit CaptureStream(size_t value) : id(value) {}
  bool started() const { return active.load(); }
  std::atomic<bool> active{false};
  size_t id;
};

class Selection {
 public:
  @SELECTION@
  @WRAPPERS@
  std::vector<std::weak_ptr<CaptureStream>> streams_;
};

std::atomic<size_t> checks{0};
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { std::fprintf(stderr, "capture selection: %s\n", reason); std::abort(); }
}

void Membership() {
  Selection selection;
  Check(!selection.Any() && selection.Snapshot().empty(), "empty registry has no selected streams");
  std::vector<std::shared_ptr<CaptureStream>> owners;
  for (size_t id = 0; id < 64; ++id) {
    auto s = std::make_shared<CaptureStream>(id);
    s->active = id % 3 == 0;
    selection.streams_.push_back(s);
    owners.push_back(std::move(s));
  }
  // Expired entries are interspersed with live stopped and started streams.
  for (size_t id = 1; id < owners.size(); id += 4) owners[id].reset();
  std::vector<size_t> expected;
  size_t living = 0;
  for (const auto& s : owners) if (s) { ++living; if (s->active) expected.push_back(s->id); }
  Check(selection.Any() == !expected.empty(), "presence agrees with independent owner membership");
  Check(selection.streams_.size() == living, "presence scan prunes all expired entries");
  auto snapshot = selection.Snapshot();
  Check(snapshot.size() == expected.size(), "snapshot selects exactly the started streams");
  for (size_t i = 0; i < expected.size(); ++i) Check(snapshot[i]->id == expected[i], "snapshot preserves registration order");
  std::vector<std::weak_ptr<CaptureStream>> retained;
  for (const auto& s : snapshot) retained.push_back(s);
  for (auto& s : owners) if (s) s->active = false;
  owners.clear();
  Check(!selection.Any() && selection.Snapshot().empty(), "later scans use current state while old snapshot owns stopped streams");
  Check(selection.streams_.size() == snapshot.size(), "only the dispatch snapshot retains otherwise unowned streams");
  for (const auto& s : retained) Check(!s.expired(), "dispatch ownership survives release of external owners");
  snapshot.clear();
  Check(!selection.Any() && selection.streams_.empty(), "snapshot release permits all stale registrations to retire");
  for (const auto& s : retained) Check(s.expired(), "presence check retains no stream after its call");
}

void Churn() {
  Selection selection;
  std::mutex mutex;
  std::vector<std::thread> workers;
  for (size_t worker = 0; worker < 4; ++worker) workers.emplace_back([&, worker] {
    for (size_t round = 0; round < 250; ++round) {
      auto s = std::make_shared<CaptureStream>(worker * 1000 + round);
      s->active = true;
      {
        std::lock_guard<std::mutex> lock(mutex);
        selection.streams_.push_back(s);
        Check(selection.Any(), "serialized concurrent registration becomes visible");
        auto snapshot = selection.Snapshot();
        Check(std::find(snapshot.begin(), snapshot.end(), s) != snapshot.end(), "dispatch snapshot contains its newly active stream");
      }
      s->active = false;
    }
  });
  for (auto& worker : workers) worker.join();
  Check(!selection.Any() && selection.streams_.empty(), "all expired concurrent registrations are pruned");
}

void Measure(bool gate) {
  Selection selection;
  std::vector<std::shared_ptr<CaptureStream>> owners;
  for (size_t i = 0; i < 64; ++i) {
    auto s = std::make_shared<CaptureStream>(i);
    s->active = true;
    selection.streams_.push_back(s);
    owners.push_back(std::move(s));
  }
  allocations = allocated_bytes = 0;
  size_t present = 0;
  counting = true;
  for (size_t i = 0; i < 10000; ++i) present += selection.Any();
  counting = false;
  Check(present == 10000, "measured registry remains active");
  if (gate) Check(allocations == 0 && allocated_bytes == 0, "presence checks need no heap snapshot");
  std::printf("Capture presence: 10000 scans of 64 streams, %zu allocations, %zu bytes\n", allocations, allocated_bytes);
}

int main(int argc, char** argv) {
  Membership();
  Churn();
  Measure(argc < 2 || std::strcmp(argv[1], "measure") != 0);
  std::printf("Capture selection: %zu checks PASS\n", checks.load());
}
