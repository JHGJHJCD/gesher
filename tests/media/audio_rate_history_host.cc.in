// Production mixer, explicit host clock/attachment boundary; no audio device or JNI VM.
#include <array>

@PRODUCTION@

namespace {
using namespace gesher::media;
int checks = 0, failures = 0, cases = 0, guarded_stops = 0;
std::string context;
Engine engine;

bool Check(bool okay, const char* why) {
  ++checks;
  if (!okay) {
    ++failures;
    std::fprintf(stderr, "FAIL rate history [%s]: %s\n", context.c_str(), why);
  }
  return okay;
}

float Sample(size_t frame, uint32_t channel, uint32_t channels) {
  const size_t i = frame * channels + channel;
  const int level = static_cast<int>((i * 17 + frame * 3) % 201) - 100;
  return level / 128.0f;
}

std::vector<uint8_t> Payload(PcmFormat format, uint32_t channels, size_t frames) {
  const size_t bytes = BytesPerSample(format);
  std::vector<uint8_t> data(frames * channels * bytes);
  for (size_t i = 0; i < frames * channels; ++i) {
    const int level = static_cast<int>(Sample(i / channels, i % channels, channels) * 128);
    uint8_t* p = data.data() + i * bytes;
    switch (format) {
      case PcmFormat::kU8: *p = static_cast<uint8_t>(128 + level); break;
      case PcmFormat::kS16: {
        const int16_t v = static_cast<int16_t>(level * 256); std::memcpy(p, &v, 2); break;
      }
      case PcmFormat::kS24Packed: {
        const uint32_t v = static_cast<uint32_t>(level * 65536);
        p[0] = static_cast<uint8_t>(v); p[1] = static_cast<uint8_t>(v >> 8);
        p[2] = static_cast<uint8_t>(v >> 16); break;
      }
      case PcmFormat::kS32: {
        const int32_t v = level * 16777216; std::memcpy(p, &v, 4); break;
      }
      case PcmFormat::kFloat: {
        const float v = level / 128.0f; std::memcpy(p, &v, 4); break;
      }
    }
  }
  return data;
}

enum class Change { kSpeed, kSourceRate, kOutputRate };
uint32_t Configure(Track& track, Change change, float factor) {
  if (change == Change::kSpeed) track.SetSpeed(factor);
  if (change == Change::kSourceRate)
    Check(track.SetSampleRate(static_cast<uint32_t>(48000 * factor)) == kOk,
          "source-rate setter accepts the test rate");
  return change == Change::kOutputRate ? static_cast<uint32_t>(48000 / factor) : 48000;
}

struct Snapshot {
  explicit Snapshot(Track& track)
      : hist(track.rs_->hist), data(track.data_), start(track.rs_->start_index),
        center(start + track.rs_->t), played_index(track.rs_->played_index),
        real_end(track.rs_->real_end), played(track.played_), position(track.Position()),
        read(track.read_), written(track.written_), stop_end(track.stop_end_),
        static_pos(track.static_pos_), state(track.state_), queued(track.Queued()) {}
  std::vector<float> hist;
  std::vector<uint8_t> data;
  int64_t start;
  double center;
  int64_t played_index, real_end;
  uint64_t played;
  uint32_t position;
  uint64_t read, written, stop_end;
  size_t static_pos;
  Track::State state;
  size_t queued;
};

bool TapBound(Track& track) {
  const auto& rs = *track.rs_;
  const int64_t center = static_cast<int64_t>(std::floor(rs.t));
  const int64_t first = rs.width == 0 ? center : center - static_cast<int64_t>(rs.width) + 1;
  if (Check(rs.primed && first >= 0, "first source tap is within retained history")) return true;
  // Stop the case here, including with --source-ref. Never perform a
  // positive-frame mix after this failure on an older implementation.
  ++guarded_stops;
  return false;
}

bool Prepare(Track& track, uint32_t out_rate, const Snapshot& before, bool needs_padding) {
  std::array<float, 2> untouched{0.25f, -0.125f};
  Check(!track.MixInto(untouched.data(), 0, out_rate, 2), "zero-output preparation plays nothing");
  if (!TapBound(track)) return false;
  const auto& rs = *track.rs_;
  Check(untouched == std::array<float, 2>{0.25f, -0.125f}, "preparation does not write output");
  Check(rs.start_index + rs.t == before.center, "absolute source center and fractional phase survive");
  Check(rs.played_index == before.played_index && track.played_ == before.played &&
        track.Position() == before.position, "preparation does not advance played positions");
  Check(rs.real_end == before.real_end, "known or unknown real source end survives");
  Check(track.read_ == before.read && track.written_ == before.written &&
        track.static_pos_ == before.static_pos && track.stop_end_ == before.stop_end &&
        track.Queued() == before.queued, "source cursors, drain boundary and queued frames survive");
  Check(track.state_ == before.state && track.data_ == before.data,
        "playback state and source payload survive");
  if (!Check(rs.start_index <= before.start, "preparation only extends history into the past")) return false;
  const size_t padding = static_cast<size_t>(before.start - rs.start_index) * track.params_.channels;
  if (!Check(rs.hist.size() == before.hist.size() + padding, "retained history has no gaps or dropped frames"))
    return false;
  Check(std::all_of(rs.hist.begin(), rs.hist.begin() + padding, [](float v) { return v == 0; }),
        "only silence represents unavailable past samples");
  Check(before.hist.empty() || std::memcmp(rs.hist.data() + padding, before.hist.data(),
                                         before.hist.size() * sizeof(float)) == 0,
        "every retained real and synthetic sample is bit-identical");
  Check(!needs_padding || padding != 0, "scenario actually exercises missing left history");
  Check(padding == 0 || static_cast<int64_t>(std::floor(rs.t)) -
        static_cast<int64_t>(rs.width) + 1 == 0, "padding adds only the unavailable taps");
  return true;
}

// An absolute-coordinate oracle uses the old retained history, independent of
// how the production fix shifts its vector indices. The production kernel is
// shared; this checks sample ownership/phase, not filter frequency response.
std::array<float, 2> Expected(Track& track, const Snapshot& before, uint32_t out_rate,
                            size_t source_frames, size_t source_base = 0) {
  const uint32_t ch = track.params_.channels;
  const double step = static_cast<double>(track.sample_rate()) * track.speed() / out_rate;
  const double cutoff = step > 1 ? 0.97 / step : 1;
  const int64_t center = static_cast<int64_t>(std::floor(before.center));
  const int64_t width = static_cast<int64_t>(track.rs_->width);
  std::vector<float> frame(ch, 0);
  const auto value = [&](int64_t index, uint32_t c) {
    if (index < before.start) return 0.0f;  // discarded past history
    const size_t relative = static_cast<size_t>(index - before.start);
    if (relative < before.hist.size() / ch) return before.hist[relative * ch + c];
    if (index < 0 || static_cast<uint64_t>(index) >= source_frames ||
        (before.real_end >= 0 && index >= before.real_end)) return 0.0f;
    return Sample(source_base + static_cast<size_t>(index), c, ch);
  };
  if (step == 1) {
    for (uint32_t c = 0; c < ch; ++c) frame[c] = value(center, c);
  } else {
    for (int64_t k = center - width + 1; k <= center + width; ++k) {
      const float w = Kernel(KernelTable(), (before.center - static_cast<double>(k)) * cutoff) *
                      static_cast<float>(cutoff);
      for (uint32_t c = 0; c < ch; ++c) frame[c] += value(k, c) * w;
    }
  }
  float left = frame[0], right = ch == 1 ? frame[0] : frame[1];
  if (ch > 2) {
    left += 0.7071f * frame[2]; right += 0.7071f * frame[2];
    for (uint32_t c = 4; c + 1 < ch && c < 8; c += 2) {
      left += 0.7071f * frame[c]; right += 0.7071f * frame[c + 1];
    }
  }
  return {0.25f + left, -0.125f + right};
}

bool OneOutput(Track& track, const Snapshot& before, uint32_t out_rate,
               size_t source_frames, size_t source_base = 0) {
  if (!TapBound(track)) return false;
  const auto expected = Expected(track, before, out_rate, source_frames, source_base);
  std::array<float, 2> output{0.25f, -0.125f};
  Check(track.MixInto(output.data(), 1, out_rate, 2), "valid history produces the next frame");
  Check(std::isfinite(output[0]) && std::isfinite(output[1]) &&
        std::fabs(output[0] - expected[0]) < 2e-6f && std::fabs(output[1] - expected[1]) < 2e-6f,
        "output matches the absolute-history oracle");
  const double step = static_cast<double>(track.sample_rate()) * track.speed() / out_rate;
  Check(track.rs_->start_index + track.rs_->t == before.center + step,
        "one output advances the absolute center by exactly the configured step");
  int64_t passed = static_cast<int64_t>(std::floor(before.center + step));
  if (track.rs_->real_end >= 0) passed = std::min(passed, track.rs_->real_end);
  const uint64_t delta = static_cast<uint64_t>(std::max<int64_t>(0, passed - before.played_index));
  Check(track.played_ == before.played + delta &&
        track.Position() == static_cast<uint32_t>(before.position + delta),
        "played position follows source time without counting left padding");
  return true;
}

bool Drain(Track& track, uint32_t out_rate, size_t expected_position, int& ends) {
  const int prior_ends = ends;
  for (size_t block = 0; block < 128 && ends == prior_ends; ++block) {
    if (!TapBound(track)) return false;
    std::array<float, 512> output{};
    track.MixInto(output.data(), 256, out_rate, 2);
    Check(std::all_of(output.begin(), output.end(), [](float v) { return std::isfinite(v); }),
          "draining output remains finite");
  }
  Check(ends == prior_ends + 1, "drain reaches one end event within the bounded output budget");
  Check(track.Position() == expected_position && track.rs_->played_index == track.rs_->real_end,
        "drain counts every real source frame and no padding");
  Check(track.params_.is_static ? track.state() == Track::State::kPlaying : track.stopped(),
        "static completion and streaming drain retain their public states");
  if (!TapBound(track)) return false;
  std::array<float, 16> silence{};
  Check(!track.MixInto(silence.data(), 8, out_rate, 2) && ends == prior_ends + 1 &&
        std::all_of(silence.begin(), silence.end(), [](float v) { return v == 0; }),
        "completed drain emits neither extra samples nor duplicate completion");
  return true;
}

void RateCase(PcmFormat format, uint32_t channels, bool is_static, Change change, bool compacted) {
  ++cases;
  context = "format=" + std::to_string(static_cast<int>(format)) + " ch=" + std::to_string(channels) +
            (is_static ? " static" : " stream") + " change=" + std::to_string(static_cast<int>(change)) +
            (compacted ? " compacted" : " immediate");
  const size_t source_frames = compacted ? 4608 : 512;
  TrackParams params;
  params.channels = channels; params.format = format; params.is_static = is_static;
  params.capacity_frames = source_frames;
  Track track(&engine, params);
  const auto data = Payload(format, channels, source_frames);
  Check(track.Write(data.data(), data.size(), false) == static_cast<ssize_t>(data.size()), "load all PCM");
  int ends = 0;
  TrackEvents events; events.end = [&] { ++ends; }; track.SetEvents(events);
  Check(track.Start() == kOk, "start loaded track");
  float untouched = 0;
  track.MixInto(&untouched, 0, 48000, 1);
  if (!TapBound(track)) return;
  std::vector<float> warm((compacted ? 4098 : 1) * 2, 0);
  Check(track.MixInto(warm.data(), warm.size() / 2, 48000, 2), "warm-up produces real samples");
  Check(!compacted || track.rs_->start_index > 0, "compacted scenario discarded old source history");
  uint32_t out_rate = 48000;
  size_t transition = 0;
  for (float factor : {2.0f, 0.5f, 4.0f, 1.0f, 4.0f}) {
    const Snapshot before(track);
    out_rate = Configure(track, change, factor);
    if (!Prepare(track, out_rate, before, transition == 0 || transition == 2)) return;
    if (!OneOutput(track, before, out_rate, source_frames)) return;
    ++transition;
  }
  if (!is_static) track.Stop();
  if (!Drain(track, out_rate, source_frames, ends)) return;
  Check(track.rs_->real_end == static_cast<int64_t>(source_frames), "absolute real end excludes added silence");
  Check(is_static ? track.static_pos_ == source_frames : track.read_ == track.written_,
        "drain consumes exactly the loaded source");
}

void TailCase(PcmFormat format, uint32_t channels, Change change, bool resume) {
  ++cases;
  context = "tail format=" + std::to_string(static_cast<int>(format)) + " ch=" +
            std::to_string(channels) + " change=" + std::to_string(static_cast<int>(change)) +
            (resume ? " resume" : " restart");
  constexpr size_t old_frames = 64, next_frames = 32;
  TrackParams params; params.channels = channels; params.format = format;
  params.capacity_frames = old_frames + next_frames;
  Track track(&engine, params);
  const auto data = Payload(format, channels, params.capacity_frames);
  const size_t first_bytes = old_frames * track.frame_size();
  Check(track.Write(data.data(), first_bytes, false) == static_cast<ssize_t>(first_bytes), "prime first drain");
  int ends = 0;
  TrackEvents events; events.end = [&] { ++ends; }; track.SetEvents(events);
  uint32_t out_rate = Configure(track, change, 0.5f);
  track.Start(); track.Stop();
  Check(track.Write(data.data() + first_bytes, data.size() - first_bytes, false) ==
        static_cast<ssize_t>(data.size() - first_bytes), "post-stop write primes the next playback");
  float untouched = 0;
  track.MixInto(&untouched, 0, out_rate, 1);
  if (!TapBound(track)) return;
  for (size_t tick = 0; tick < 128 && track.rs_->real_end < 0; ++tick) {
    std::array<float, 2> output{};
    track.MixInto(output.data(), 1, out_rate, 2);
  }
  if (!Check(track.rs_->real_end == old_frames && !track.stopped() && track.Position() < old_frames,
             "old drain reaches a known real end with an unfinished filter tail")) return;
  Check(track.Queued() == next_frames, "tail does not consume the next playback's primed samples");
  const Snapshot before(track);
  out_rate = Configure(track, change, 8);
  if (!Prepare(track, out_rate, before, true)) return;
  if (!OneOutput(track, before, out_rate, old_frames)) return;
  if (resume) {
    const Snapshot tail(track);
    track.Pause(); track.Start();
    Check(track.rs_->real_end == -1 && track.rs_->start_index + track.rs_->t == tail.center &&
          track.rs_->played_index == tail.played_index && track.Position() == tail.position,
          "resuming a padded drain preserves phase and positions while reopening the real end");
    Check(track.rs_->frames() == static_cast<size_t>(old_frames - track.rs_->start_index),
          "resume removes only the synthetic right tail, retaining added left history");
    Check(track.Queued() == next_frames && track.read_ == old_frames,
          "resume keeps next playback payload queued until mixing");
    track.Stop();
    const Snapshot resumed(track);
    if (!Prepare(track, out_rate, resumed, false)) return;
    if (!OneOutput(track, resumed, out_rate, old_frames + next_frames)) return;
    if (!Drain(track, out_rate, old_frames + next_frames, ends)) return;
    Check(track.read_ == track.written_ && track.Queued() == 0, "resumed drain consumes the new stop boundary");
  } else {
    if (!Drain(track, out_rate, old_frames, ends)) return;
    Check(track.Queued() == next_frames && track.read_ == old_frames && track.stop_end_ == old_frames,
          "completed old drain preserves post-stop priming and its frozen boundary");
    track.Start();
    out_rate = Configure(track, change, 1);
    track.Stop();
    track.MixInto(&untouched, 0, out_rate, 1);
    if (!TapBound(track)) return;
    Check(track.Position() == 0, "fresh playback starts with a fresh public position");
    const Snapshot restarted(track);
    if (!OneOutput(track, restarted, out_rate, next_frames, old_frames)) return;
    if (!Drain(track, out_rate, next_frames, ends)) return;
    Check(track.read_ == track.written_ && track.Queued() == 0 && ends == 2,
          "fresh playback consumes the primed payload exactly once");
  }
}
}  // namespace

int main() {
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed,
                          PcmFormat::kS32, PcmFormat::kFloat})
    for (uint32_t channels : {1u, 2u, 8u, 24u})
      for (Change change : {Change::kSpeed, Change::kSourceRate, Change::kOutputRate}) {
        for (bool is_static : {false, true})
          for (bool compacted : {false, true}) RateCase(format, channels, is_static, change, compacted);
        for (bool resume : {false, true}) TailCase(format, channels, change, resume);
      }
  std::printf("audio rate-history contracts: %d cases, %d checks, %d failures, %d guarded stops\n",
              cases, checks, failures, guarded_stops);
  return failures != 0;
}
