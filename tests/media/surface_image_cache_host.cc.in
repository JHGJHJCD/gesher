// Declared host adapters for immutable Skia pixel ownership, surfaces and JNI.
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <functional>
#include <future>
#include <memory>
#include <mutex>
#include <thread>
#include <vector>

template<class T> using sk_sp = std::shared_ptr<T>;
struct SurfaceFrame {
  int width = 0, height = 0;
  uint64_t number = 0;
  std::vector<uint32_t> pixels;
};
struct SkData {
  const void* pixels;
  size_t bytes;
  void (*release)(const void*, void*);
  void* context;
  SkData(const void* p, size_t b, void (*r)(const void*, void*), void* c)
      : pixels(p), bytes(b), release(r), context(c) {}
  ~SkData() { release(pixels, context); }
  static sk_sp<SkData> MakeWithProc(const void* p, size_t b,
                                   void (*r)(const void*, void*), void* c) {
    return std::make_shared<SkData>(p, b, r, c);
  }
};
constexpr int kRGBA_8888_SkColorType = 1, kPremul_SkAlphaType = 1;
struct SkImageInfo {
  int width, height;
  static SkImageInfo Make(int w, int h, int, int) { return {w, h}; }
};
struct SkImage {
  SkImageInfo info;
  sk_sp<SkData> data;
  SkImage(SkImageInfo i, sk_sp<SkData> d) : info(i), data(std::move(d)) {}
  uint32_t pixel() const { return static_cast<const uint32_t*>(data->pixels)[0]; }
};
std::atomic<unsigned> image_creations{0};
bool fail_image = false;
namespace SkImages {
sk_sp<SkImage> RasterFromData(SkImageInfo info, sk_sp<SkData> data, size_t) {
  ++image_creations;
  if (fail_image) { fail_image = false; return nullptr; }
  return std::make_shared<SkImage>(info, std::move(data));
}
}

@CACHE@

namespace android {
struct VirtualLightRefBase { virtual ~VirtualLightRefBase() = default; };
template<class T> using sp = std::shared_ptr<T>;
}
struct SkMatrix { static SkMatrix I() { return {}; } };
enum class SkBlendMode { kSrcOver };
struct SkColorFilter {};
struct QueueSurface {
  std::shared_ptr<const SurfaceFrame> frame;
  std::function<void()> before_latest;
  std::shared_ptr<const SurfaceFrame> Latest() {
    if (before_latest) before_latest();
    return frame;
  }
};

@LAYER@

struct JNIEnv {};
using jclass = void*;
using jobject = void*;
using jlong = intptr_t;
#define JNICALL
struct SurfaceTextureState { android::sp<QueueSurface> surface; };
SurfaceTextureState* StateOf(JNIEnv*, jobject value) {
  return static_cast<SurfaceTextureState*>(value);
}
TextureLayer* LayerOf(jlong value) { return reinterpret_cast<TextureLayer*>(value); }

@DETACH@
@ATTACH@

namespace {
using namespace std::chrono_literals;
int checks = 0, failures = 0;
void Check(bool okay, const char* why) {
  ++checks;
  if (!okay) { ++failures; std::fprintf(stderr, "FAIL surface image cache: %s\n", why); }
}
std::shared_ptr<SurfaceFrame> Frame(uint64_t number, int width, uint32_t pixel) {
  auto frame = std::make_shared<SurfaceFrame>();
  frame->width = width; frame->height = 1; frame->number = number;
  frame->pixels.assign(width, pixel);
  return frame;
}
void Attach(TextureLayer& layer, SurfaceTextureState* state) {
  TL_setSurfaceTexture(nullptr, nullptr, reinterpret_cast<jlong>(&layer), state);
}
void Detach(TextureLayer& layer) {
  HR_detachSurfaceTexture(nullptr, nullptr, 0, reinterpret_cast<jlong>(&layer));
}
SurfaceTextureState Surface(std::shared_ptr<const SurfaceFrame> frame) {
  auto surface = std::make_shared<QueueSurface>();
  surface->frame = std::move(frame);
  return {std::move(surface)};
}

void IdentityAndOwnership() {
  FrameImages cache;
  auto first = Frame(1, 1, 0xff000011);
  auto second = Frame(1, 2, 0xff000022);
  std::weak_ptr<const SurfaceFrame> first_weak = first, second_weak = second;
  auto image1 = cache.Get(first);
  unsigned built = image_creations;
  Check(cache.Get(first) == image1 && image_creations == built, "same frame reuses image");
  auto image2 = cache.Get(second);
  Check(image2 != image1 && image2->pixel() == 0xff000022 && image2->info.width == 2,
        "distinct surfaces with equal sequence number use new pixels and dimensions");
  first.reset();
  Check(!first_weak.expired() && image1->pixel() == 0xff000011,
        "returned old image owns its old immutable pixels after replacement");
  image1.reset();
  Check(first_weak.expired(), "replaced image retires when its consumer releases it");
  second.reset();
  Check(cache.Get(nullptr) == nullptr, "null frame returns no image");
  Check(!second_weak.expired() && image2->pixel() == 0xff000022,
        "returned image survives cache reset");
  image2.reset();
  Check(second_weak.expired(), "null frame releases cache ownership");
  auto third = Frame(1, 3, 0xff000033);
  auto image3 = cache.Get(third);
  Check(image3->pixel() == 0xff000033 && image3->info.width == 3,
        "reattach with same sequence creates correct image");
  auto next = Frame(2, 3, 0xff000044);
  Check(cache.Get(next)->pixel() == 0xff000044, "next frame on same surface replaces image");
}

void FailedCreation() {
  FrameImages cache;
  auto frame = Frame(1, 1, 0x12345678);
  std::weak_ptr<const SurfaceFrame> weak = frame;
  fail_image = true;
  Check(cache.Get(frame) == nullptr, "Skia creation failure returns null");
  Check(cache.Get(frame)->pixel() == 0x12345678, "same frame retries failed creation");
  cache.Get(nullptr);
  frame.reset();
  Check(weak.expired(), "failed and successful Skia owners are eventually released");
}

void LayerLifecycle() {
  TextureLayer layer;
  auto first = Surface(Frame(1, 2, 0xff112233));
  auto second = Surface(Frame(1, 3, 0xff445566));
  std::weak_ptr<const SurfaceFrame> first_weak = first.surface->frame;
  std::weak_ptr<const SurfaceFrame> second_weak = second.surface->frame;
  Attach(layer, &first);
  auto image1 = layer.Image();
  Check(image1 != nullptr && image1->pixel() == 0xff112233, "attached layer reads first frame");
  Attach(layer, &second);
  first.surface.reset();
  Check(image1->pixel() == 0xff112233, "attachment replacement preserves returned image");
  image1.reset();
  Check(first_weak.expired(), "attachment change immediately drops unused cached frame");
  auto image2 = layer.Image();
  Check(image2 != nullptr && image2->pixel() == 0xff445566, "layer replacement reads new frame");
  Attach(layer, &second);
  Check(layer.Image() == image2, "reattaching same surface preserves its image cache");
  Detach(layer);
  second.surface.reset();
  Check(layer.Image() == nullptr, "detached layer reads no frame");
  Check(!second_weak.expired() && image2->pixel() == 0xff445566,
        "detach preserves image held by a renderer");
  image2.reset();
  Check(second_weak.expired(), "detach retires cache pixels without needing another frame");
  auto third = Surface(Frame(1, 1, 0xff778899));
  std::weak_ptr<const SurfaceFrame> third_weak = third.surface->frame;
  Attach(layer, &third);
  Check(layer.Image()->pixel() == 0xff778899, "layer can reattach after detach");
  Attach(layer, nullptr);
  third.surface.reset();
  Check(third_weak.expired() && layer.Image() == nullptr, "null attachment clears cache");
}

void ConcurrentCacheReaders() {
  FrameImages cache;
  auto frame = Frame(1, 1, 0x10203040);
  const unsigned before = image_creations;
  std::vector<sk_sp<SkImage>> images(8);
  std::vector<std::thread> readers;
  for (size_t i = 0; i < images.size(); ++i)
    readers.emplace_back([&, i] { images[i] = cache.Get(frame); });
  for (auto& thread : readers) thread.join();
  for (const auto& image : images)
    Check(image == images.front() && image->pixel() == 0x10203040, "concurrent reader sees cached image");
  Check(image_creations == before + 1, "concurrent first readers build one image");
}

void DetachDuringImageRead() {
  TextureLayer layer;
  auto state = Surface(Frame(1, 1, 0xffabcdef));
  std::weak_ptr<const SurfaceFrame> weak = state.surface->frame;
  std::promise<void> entered, release, detach_started;
  auto gate = release.get_future().share();
  state.surface->before_latest = [&] { entered.set_value(); gate.wait(); };
  Attach(layer, &state);
  auto reader = std::async(std::launch::async, [&] { return layer.Image(); });
  Check(entered.get_future().wait_for(1s) == std::future_status::ready,
        "controlled image read reached surface snapshot");
  auto detach = std::async(std::launch::async, [&] { detach_started.set_value(); Detach(layer); });
  Check(detach_started.get_future().wait_for(1s) == std::future_status::ready,
        "concurrent detachment started");
  Check(detach.wait_for(20ms) == std::future_status::timeout,
        "detachment serializes with image-cache publication");
  release.set_value();
  Check(reader.wait_for(1s) == std::future_status::ready && detach.wait_for(1s) == std::future_status::ready,
        "image and detachment finish without deadlock");
  auto image = reader.get(); detach.get();
  state.surface.reset();
  Check(image != nullptr && image->pixel() == 0xffabcdef, "in-flight image keeps its pixels");
  image.reset();
  Check(weak.expired(), "detachment cannot be followed by stale cache publication");
  Check(layer.Image() == nullptr, "detached image stays empty");
}

void ReplaceDuringImageRead() {
  TextureLayer layer;
  auto old_state = Surface(Frame(1, 1, 0xff000001));
  auto new_state = Surface(Frame(1, 2, 0xff000002));
  std::weak_ptr<const SurfaceFrame> old_weak = old_state.surface->frame;
  std::promise<void> entered, release, started;
  auto gate = release.get_future().share();
  old_state.surface->before_latest = [&] { entered.set_value(); gate.wait(); };
  Attach(layer, &old_state);
  auto reader = std::async(std::launch::async, [&] { return layer.Image(); });
  Check(entered.get_future().wait_for(1s) == std::future_status::ready,
        "replacement reader reached surface snapshot");
  auto replacement = std::async(std::launch::async, [&] {
    started.set_value(); Attach(layer, &new_state);
  });
  Check(started.get_future().wait_for(1s) == std::future_status::ready,
        "concurrent surface replacement started");
  Check(replacement.wait_for(20ms) == std::future_status::timeout,
        "replacement serializes with image-cache publication");
  release.set_value();
  Check(reader.wait_for(1s) == std::future_status::ready &&
            replacement.wait_for(1s) == std::future_status::ready,
        "image and replacement finish without deadlock");
  auto old_image = reader.get(); replacement.get();
  old_state.surface.reset();
  auto current = layer.Image();
  Check(old_image->pixel() == 0xff000001 && current->pixel() == 0xff000002 &&
            current->info.width == 2,
        "replacement preserves old consumer pixels and publishes the new surface");
  old_image.reset();
  Check(old_weak.expired(), "replacement cannot be followed by stale cache publication");
}

void FailedReplacement() {
  FrameImages cache;
  auto old_frame = Frame(7, 1, 0x12345678);
  auto next_frame = Frame(7, 2, 0x87654321);
  std::weak_ptr<const SurfaceFrame> old_weak = old_frame;
  auto old_image = cache.Get(old_frame);
  old_frame.reset();
  fail_image = true;
  Check(cache.Get(next_frame) == nullptr, "failed replacement returns no stale cached image");
  Check(!old_weak.expired() && old_image->pixel() == 0x12345678,
        "old consumer keeps its pixels after failed replacement");
  old_image.reset();
  Check(old_weak.expired(), "failed replacement releases the old cache owner");
  auto retry = cache.Get(next_frame);
  Check(retry != nullptr && retry->pixel() == 0x87654321,
        "failed replacement retries the new frame with the same sequence number");
}
}

int main() {
  IdentityAndOwnership(); FailedCreation(); LayerLifecycle();
  ConcurrentCacheReaders(); DetachDuringImageRead();
  ReplaceDuringImageRead(); FailedReplacement();
  std::printf("surface image-cache contracts: %d checks, %d failures\n", checks, failures);
  return failures != 0;
}
