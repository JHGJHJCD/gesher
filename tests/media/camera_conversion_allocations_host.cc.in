// Boundary: JNI byte arrays only. The converter and JNI entrypoint below are production source.
#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <new>
#include <vector>

bool count_allocations = false;
size_t allocations = 0, allocated_bytes = 0, checks = 0, failures = 0;
void* operator new(size_t size) {
  if (count_allocations) { ++allocations; allocated_bytes += size; }
  if (void* p = std::malloc(size != 0 ? size : 1)) return p;
  std::abort();
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }
struct Uncounted {
  bool previous = count_allocations;
  Uncounted() { count_allocations = false; }
  ~Uncounted() { count_allocations = previous; }
};
using jint = int32_t;
using jsize = int32_t;
using jbyte = int8_t;
using jclass = void*;
struct Array { std::vector<jbyte> bytes; };
using jbyteArray = Array*;
constexpr int JNI_ABORT = 2;
struct JNIEnv {
  Array result;
  int pins = 0, releases = 0, creates = 0, writes = 0;
  bool exception = false, fail_pin = false, fail_create = false;
  jsize GetArrayLength(jbyteArray array) { return static_cast<jsize>(array->bytes.size()); }
  jbyte* GetByteArrayElements(jbyteArray array, void*) {
    ++pins;
    if (fail_pin) { exception = true; return nullptr; }
    return array->bytes.data();
  }
  void ReleaseByteArrayElements(jbyteArray, jbyte*, int mode) {
    if (mode != JNI_ABORT) std::abort();
    ++releases;
  }
  jbyteArray NewByteArray(jsize size) {
    ++creates;
    if (fail_create) { exception = true; return nullptr; }
    Uncounted uncounted;
    result.bytes.resize(size);
    return &result;
  }
  void SetByteArrayRegion(jbyteArray array, jsize begin, jsize size, const jbyte* data) {
    ++writes;
    if (begin < 0 || size < 0 || static_cast<size_t>(begin) + size > array->bytes.size()) std::abort();
    std::memcpy(array->bytes.data() + begin, data, size);
  }
};
void jniThrowException(JNIEnv* env, const char*, const char*) { env->exception = true; }
void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) { ++failures; if (failures < 12) std::fprintf(stderr, "FAIL: %s\n", message); }
}

@CONVERSION@
@JNI@

// Independently address Y and NV21 V/U bytes from destination coordinates.
std::vector<jbyte> Oracle(const Array& input, int w, int h, int tw, int th) {
  std::vector<jbyte> expected(static_cast<size_t>(tw) * th * 3 / 2);
  for (int y = 0; y < th; ++y)
    for (int x = 0; x < tw; ++x)
      expected[static_cast<size_t>(y) * tw + x] =
          input.bytes[static_cast<size_t>(int64_t{y} * h / th) * w + int64_t{x} * w / tw];
  size_t source_y = static_cast<size_t>(w) * h, dest_y = static_cast<size_t>(tw) * th;
  for (int y = 0; y < th / 2; ++y)
    for (int x = 0; x < tw / 2; ++x) {
      size_t source = source_y + static_cast<size_t>(int64_t{y} * h / th) * w +
                      (int64_t{x} * w / tw) * 2;
      size_t dest = dest_y + static_cast<size_t>(y) * tw + x * 2;
      expected[dest] = input.bytes[source + 1];
      expected[dest + 1] = input.bytes[source];
    }
  return expected;
}

Array Input(int w, int h, uint32_t seed) {
  Array input;
  input.bytes.resize(static_cast<size_t>(w) * h * 3 / 2);
  for (jbyte& value : input.bytes) {
    seed = seed * 1664525u + 1013904223u;
    value = static_cast<jbyte>(seed >> 24);
  }
  return input;
}

void ValidCase(int w, int h, int tw, int th, bool gate) {
  Array input = Input(w, h, static_cast<uint32_t>(w * 197 + h * 11 + tw));
  const auto original = input.bytes;
  const auto expected = Oracle(input, w, h, tw, th);
  JNIEnv env;
  allocations = allocated_bytes = 0;
  count_allocations = true;
  auto output = CameraFrames_toNv21(&env, nullptr, &input, w, h, tw, th);
  count_allocations = false;
  Check(output != nullptr && !env.exception, "valid frame result");
  Check(output != nullptr && output->bytes == expected, "bit-exact NV21 and nearest-neighbor scaling");
  Check(input.bytes == original, "source bytes unchanged");
  Check(env.pins == 1 && env.releases == 1 && env.creates == 1 && env.writes == 1,
        "balanced input pin and single complete output publication");
  if (gate) {
    Check(allocations == 1, "one native frame allocation");
    Check(allocated_bytes == expected.size(), "native scratch exactly output size");
  }
  // The unchanged planar caller must keep its I420 layout, including odd destinations.
  int pw = tw - 1, ph = th - 1, cw = (pw + 1) / 2, ch = (ph + 1) / 2;
  size_t ysize = static_cast<size_t>(pw) * ph, csize = static_cast<size_t>(cw) * ch;
  std::vector<uint8_t> planar(ysize + csize * 2 + 2, 0xa5);
  Nv12ToI420(reinterpret_cast<uint8_t*>(input.bytes.data()), w, h, planar.data() + 1,
             planar.data() + 1 + ysize, planar.data() + 1 + ysize + csize, pw, ph);
  Check(planar.front() == 0xa5 && planar.back() == 0xa5, "I420 output guards preserved");
  for (int y = 0; y < ph; ++y)
    for (int x = 0; x < pw; ++x)
      Check(planar[1 + static_cast<size_t>(y) * pw + x] ==
                static_cast<uint8_t>(input.bytes[static_cast<size_t>(int64_t{y} * h / ph) * w + int64_t{x} * w / pw]),
            "I420 luma coordinates");
  for (int y = 0; y < ch; ++y)
    for (int x = 0; x < cw; ++x) {
      size_t src = static_cast<size_t>(w) * h + static_cast<size_t>(int64_t{y} * (h / 2) / ch) * w +
                   (int64_t{x} * (w / 2) / cw) * 2;
      size_t dest = static_cast<size_t>(y) * cw + x;
      Check(planar[1 + ysize + dest] == static_cast<uint8_t>(input.bytes[src]) &&
                planar[1 + ysize + csize + dest] == static_cast<uint8_t>(input.bytes[src + 1]),
            "I420 chroma coordinates");
    }
}

void InvalidCases() {
  Array input = Input(4, 4, 123);
  const int dims[][4] = {
      {0, 4, 4, 4}, {4, 0, 4, 4}, {-2, 4, 4, 4}, {4, -2, 4, 4},
      {3, 4, 4, 4}, {4, 3, 4, 4}, {4, 4, 0, 4}, {4, 4, 4, 0},
      {4, 4, -2, 4}, {4, 4, 3, 4}, {4, 4, 4, 3},
      {INT32_MAX - 1, INT32_MAX - 1, 4, 4}, {4, 4, INT32_MAX - 1, INT32_MAX - 1},
      {4, 4, 65536, 65536}, {65536, 65536, 4, 4}, {8, 8, 4, 4}};
  for (const auto& d : dims) {
    JNIEnv env;
    allocations = 0;
    count_allocations = true;
    auto output = CameraFrames_toNv21(&env, nullptr, &input, d[0], d[1], d[2], d[3]);
    count_allocations = false;
    Check(output == nullptr && env.exception, "bad dimensions/truncated input rejected");
    Check(env.pins == 0 && env.creates == 0 && allocations == 0, "invalid frame rejected before allocation or pin");
  }
  JNIEnv null_env;
  Check(CameraFrames_toNv21(&null_env, nullptr, nullptr, 4, 4, 4, 4) == nullptr && null_env.exception,
        "null input rejected");
  JNIEnv pin_env;
  pin_env.fail_pin = true;
  Check(CameraFrames_toNv21(&pin_env, nullptr, &input, 4, 4, 4, 4) == nullptr && pin_env.exception,
        "input pin failure preserved");
  Check(pin_env.releases == 0 && pin_env.creates == 0, "failed pin is not released or published");
  JNIEnv create_env;
  create_env.fail_create = true;
  Check(CameraFrames_toNv21(&create_env, nullptr, &input, 4, 4, 4, 4) == nullptr && create_env.exception,
        "output allocation failure preserved");
  Check(create_env.releases == 1 && create_env.writes == 0, "input released before failed output publication");
}

void Measure(int w, int h, int tw, int th, int rounds) {
  Array input = Input(w, h, 7);
  JNIEnv env;
  const auto expected = Oracle(input, w, h, tw, th);
  CameraFrames_toNv21(&env, nullptr, &input, w, h, tw, th);
  allocations = allocated_bytes = 0;
  const auto begin = std::chrono::steady_clock::now();
  count_allocations = true;
  for (int round = 0; round < rounds; ++round)
    CameraFrames_toNv21(&env, nullptr, &input, w, h, tw, th);
  count_allocations = false;
  double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
  Check(env.result.bytes == expected, "measured frame remains bit exact");
  std::printf("NV12 %dx%d -> NV21 %dx%d: %d frames, %zu native allocations, %zu bytes, %.3f ms\n",
              w, h, tw, th, rounds, allocations, allocated_bytes, ms);
}

int main(int argc, char** argv) {
  bool gate = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  const int sizes[][2] = {{2, 2}, {4, 6}, {6, 4}, {10, 14}, {18, 8}, {32, 24}, {48, 32}};
  for (const auto& source : sizes)
    for (const auto& target : sizes)
      ValidCase(source[0], source[1], target[0], target[1], gate);
  ValidCase(1920, 1080, 1280, 720, gate);
  ValidCase(640, 480, 1280, 720, gate);
  if (gate && (argc < 2 || std::strcmp(argv[1], "valid-gate") != 0)) InvalidCases();
  Measure(1280, 720, 1280, 720, 100);
  Measure(1920, 1080, 1280, 720, 100);
  Measure(640, 480, 1280, 720, 100);
  std::printf("Camera conversion: %zu checks, %zu failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
