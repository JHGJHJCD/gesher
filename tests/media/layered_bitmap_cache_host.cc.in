// Real GDI on Windows, declared GDI on other hosts. Window/desktop publication is an adapter.
#include <algorithm>
#include <array>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <mutex>
#include <thread>
#include <vector>
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
#include <windows.h>
#else
struct FakeBitmap { int width, height; std::vector<uint8_t> pixels; };
struct FakeDC { void* selected = reinterpret_cast<void*>(1); };
using HDC = FakeDC*;
using HBITMAP = FakeBitmap*;
using HGDIOBJ = void*;
using HWND = void*;
struct BITMAPINFOHEADER {
  uint32_t biSize; int biWidth, biHeight; uint16_t biPlanes, biBitCount; uint32_t biCompression;
};
struct BITMAPINFO { BITMAPINFOHEADER bmiHeader; };
struct SIZE { int cx, cy; };
struct POINT { int x, y; };
struct BLENDFUNCTION { uint8_t BlendOp, BlendFlags, SourceConstantAlpha, AlphaFormat; };
constexpr unsigned BI_RGB = 0, DIB_RGB_COLORS = 0, RDW_INVALIDATE = 1, RDW_FRAME = 2,
                   RDW_ALLCHILDREN = 4, AC_SRC_OVER = 0, AC_SRC_ALPHA = 1, ULW_ALPHA = 2;
#define FALSE 0
const auto HGDI_ERROR = reinterpret_cast<void*>(-1);
#endif

size_t checks = 0, failures = 0;
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { ++failures; if (failures < 12) std::fprintf(stderr, "FAIL layered bitmap: %s\n", reason); }
}
struct Counters {
  size_t dc_created = 0, dc_deleted = 0, dib_created = 0, dib_deleted = 0, flush = 0;
  size_t wrong_thread = 0, invalid_delete = 0, presentations = 0;
} calls;
bool fail_dc = false, fail_dib = false, fail_select = false;
std::thread::id owner = std::this_thread::get_id();
void Owner() { if (owner != std::this_thread::get_id()) ++calls.wrong_thread; }
HDC CountCreateDC(HDC dc) {
  Owner();
  if (fail_dc) return nullptr;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  HDC result = ::CreateCompatibleDC(dc);
#else
  (void)dc;
  HDC result = new FakeDC();
#endif
  if (result != nullptr) ++calls.dc_created;
  return result;
}
HBITMAP CountCreateDIB(HDC dc, const BITMAPINFO* info, unsigned usage, void** bits, void* section, unsigned offset) {
  Owner();
  if (fail_dib) return nullptr;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  HBITMAP result = ::CreateDIBSection(dc, info, usage, bits, static_cast<HANDLE>(section), offset);
#else
  (void)dc; (void)usage; (void)section; (void)offset;
  HBITMAP result = new FakeBitmap{info->bmiHeader.biWidth, -info->bmiHeader.biHeight, {}};
  result->pixels.resize(static_cast<size_t>(result->width) * result->height * 4);
  *bits = result->pixels.data();
#endif
  if (result != nullptr) ++calls.dib_created;
  return result;
}
HGDIOBJ CountSelect(HDC dc, HGDIOBJ object) {
  Owner();
  if (fail_select) return HGDI_ERROR;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  return ::SelectObject(dc, object);
#else
  HGDIOBJ previous = dc->selected;
  dc->selected = object;
  return previous;
#endif
}
int CountDeleteObject(HGDIOBJ object) {
  Owner();
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  int result = ::DeleteObject(object);
#else
  delete static_cast<FakeBitmap*>(object);
  int result = 1;
#endif
  if (result != 0) ++calls.dib_deleted;
  else ++calls.invalid_delete;
  return result;
}
int CountDeleteDC(HDC dc) {
  Owner();
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  int result = ::DeleteDC(dc);
#else
  delete dc;
  int result = 1;
#endif
  if (result != 0) ++calls.dc_deleted;
  else ++calls.invalid_delete;
  return result;
}
int CountFlush() {
  Owner();
  ++calls.flush;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  return ::GdiFlush();
#else
  return 1;
#endif
}
const uint8_t* Pixels(HDC dc, int width, int height) {
  if (dc == nullptr) return nullptr;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  DIBSECTION bitmap = {};
  if (::GetObjectW(::GetCurrentObject(dc, OBJ_BITMAP), sizeof(bitmap), &bitmap) != sizeof(bitmap)) return nullptr;
  if (bitmap.dsBm.bmWidth != width || bitmap.dsBm.bmHeight != height ||
      bitmap.dsBm.bmBitsPixel != 32) return nullptr;
  const auto* bytes = static_cast<const uint8_t*>(bitmap.dsBm.bmBits);
  // GetObject normalizes biHeight to positive even for a top-down DIB. Ask
  // GDI for top/bottom pixels to verify its actual coordinate interpretation.
  const auto* bottom = bytes + static_cast<size_t>(height - 1) * width * 4;
  if (::GetPixel(dc, 0, 0) != RGB(bytes[2], bytes[1], bytes[0]) ||
      ::GetPixel(dc, 0, height - 1) != RGB(bottom[2], bottom[1], bottom[0])) return nullptr;
  return bytes;
#else
  auto* bitmap = static_cast<FakeBitmap*>(dc->selected);
  return bitmap->width == width && bitmap->height == height ? bitmap->pixels.data() : nullptr;
#endif
}
void NoLeaks(const char* reason) {
  Check(calls.dc_created == calls.dc_deleted && calls.dib_created == calls.dib_deleted, reason);
  Check(calls.invalid_delete == 0 && calls.wrong_thread == 0, "resources deleted successfully on their owner thread");
}

const std::vector<uint8_t>* expected_frame = nullptr;
int CountUpdate(HWND, HDC, const POINT*, const SIZE* size, HDC source, const POINT* origin,
                unsigned, const BLENDFUNCTION* blend, unsigned flags) {
  Owner();
  ++calls.presentations;
  const auto* pixels = Pixels(source, size->cx, size->cy);
  Check(origin->x == 0 && origin->y == 0 && flags == ULW_ALPHA && blend->AlphaFormat == AC_SRC_ALPHA &&
            blend->SourceConstantAlpha == 255 && blend->BlendOp == AC_SRC_OVER,
        "layered alpha and source coordinates preserved");
  Check(expected_frame != nullptr && pixels != nullptr &&
            std::memcmp(pixels, expected_frame->data(), expected_frame->size()) == 0,
        "every byte reaches the layered-window boundary");
  return 1;
}
#if !defined(_WIN32) || defined(GESHER_TEST_DECLARED_GDI)
HDC GetDC(HWND) { return nullptr; }
int ReleaseDC(HWND, HDC) { return 1; }
#endif
int CountRedraw(HWND, const void*, const void*, unsigned) { return 1; }

#define CreateCompatibleDC CountCreateDC
#define CreateDIBSection CountCreateDIB
#define SelectObject CountSelect
#define DeleteObject CountDeleteObject
#define DeleteDC CountDeleteDC
#define GdiFlush CountFlush
#define UpdateLayeredWindow CountUpdate
#define RedrawWindow CountRedraw
@CACHE@
namespace gesher {
class Window {
 public:
  void PresentLayered();
  void ApplyExStyle() { ++style_changes; }
  const uint8_t* DimmedPixels() { return pixels.data(); }
  void* hwnd_ = nullptr;
  bool translucent_ = true, layered_ = false;
  int buffer_width_ = 0, buffer_height_ = 0, style_changes = 0;
  std::mutex buffer_mutex_;
  std::vector<uint8_t> pixels;
  std::unique_ptr<LayeredBitmap> layered_bitmap_;
};
}
@PRESENTATION@
#undef CreateCompatibleDC
#undef CreateDIBSection
#undef SelectObject
#undef DeleteObject
#undef DeleteDC
#undef GdiFlush
#undef UpdateLayeredWindow
#undef RedrawWindow

std::vector<uint8_t> Frame(int width, int height, uint8_t seed) {
  std::vector<uint8_t> frame(static_cast<size_t>(width) * height * 4);
  for (size_t i = 0; i < frame.size(); ++i) frame[i] = static_cast<uint8_t>(seed + i * 37);
  return frame;
}
void Contents(gesher::LayeredBitmap& bitmap, const std::vector<uint8_t>& frame, int w, int h) {
  const uint8_t* bytes = Pixels(bitmap.dc(), w, h);
  Check(bytes != nullptr && std::memcmp(bytes, frame.data(), frame.size()) == 0,
        "DIB dimensions/orientation/format and exact pixels");
}
void Direct() {
  auto small = Frame(7, 9, 5), wide = Frame(13, 3, 17);
  {
    gesher::LayeredBitmap bitmap;
    fail_dc = true;
    Check(!bitmap.Copy(small.data(), 7, 9) && bitmap.dc() == nullptr, "initial DC failure leaves empty cache");
    fail_dc = false;
    NoLeaks("failed initial DC has no retained handles");
    fail_dib = true;
    Check(!bitmap.Copy(small.data(), 7, 9) && bitmap.dc() == nullptr, "initial DIB failure leaves empty cache");
    fail_dib = false;
    NoLeaks("failed initial DIB releases temporary DC");
    fail_select = true;
    Check(!bitmap.Copy(small.data(), 7, 9) && bitmap.dc() == nullptr, "initial selection failure leaves empty cache");
    fail_select = false;
    NoLeaks("failed initial selection releases temporary DIB/DC");
    Check(bitmap.Copy(small.data(), 7, 9), "first successful frame");
    Contents(bitmap, small, 7, 9);
    HDC dc = bitmap.dc();
    size_t created = calls.dib_created;
    auto changed = Frame(7, 9, 99);
    Check(bitmap.Copy(changed.data(), 7, 9) && bitmap.dc() == dc && calls.dib_created == created,
          "same size reuses DC and DIB while replacing pixels");
    Contents(bitmap, changed, 7, 9);
    fail_dib = true;
    Check(!bitmap.Copy(wide.data(), 13, 3) && bitmap.dc() == dc, "failed resize keeps current DC");
    fail_dib = false;
    Contents(bitmap, changed, 7, 9);
    fail_select = true;
    Check(!bitmap.Copy(wide.data(), 13, 3) && bitmap.dc() == dc, "failed resize selection keeps current DC");
    fail_select = false;
    Contents(bitmap, changed, 7, 9);
    Check(bitmap.Copy(wide.data(), 13, 3) && bitmap.dc() == dc, "successful resize keeps DC and replaces DIB");
    Contents(bitmap, wide, 13, 3);
    Check(!bitmap.Copy(nullptr, 13, 3) && !bitmap.Copy(wide.data(), 0, 3) &&
              !bitmap.Copy(wide.data(), 13, -1), "invalid uploads rejected");
    Contents(bitmap, wide, 13, 3);
    for (int i = 0; i < 120; ++i) {
      auto pixels = Frame(8 + i % 3, 4 + i % 7, static_cast<uint8_t>(i));
      Check(bitmap.Copy(pixels.data(), 8 + i % 3, 4 + i % 7), "repeated resize succeeds");
      Contents(bitmap, pixels, 8 + i % 3, 4 + i % 7);
      Check(calls.dc_created == calls.dc_deleted + 1 && calls.dib_created == calls.dib_deleted + 1,
            "resizing retains one DC and one DIB only");
    }
    bitmap.Reset();
    bitmap.Reset();
    Check(bitmap.dc() == nullptr, "reset is idempotent");
    NoLeaks("reset releases selected DIB and DC");
    Check(bitmap.Copy(small.data(), 7, 9), "cache can restart after reset");
  }
  NoLeaks("destruction releases selected DIB and DC");
}

void Presentation(bool gate) {
  size_t before_dc = calls.dc_created, before_dib = calls.dib_created;
  constexpr int frames = 200, width = 1280, height = 720;
  {
    gesher::Window window;
    window.buffer_width_ = width; window.buffer_height_ = height;
    window.pixels = Frame(width, height, 3);
    expected_frame = &window.pixels;
    const auto begin = std::chrono::steady_clock::now();
    for (int frame = 0; frame < frames; ++frame) {
      window.pixels[frame] ^= 0x55;
      window.PresentLayered();
    }
    double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
    std::printf("Layered GDI %dx%d: %d frames, %zu DC creations, %zu DIB creations, %.3f ms\n",
                width, height, frames, calls.dc_created - before_dc, calls.dib_created - before_dib, ms);
    if (gate) Check(calls.dc_created - before_dc == 1 && calls.dib_created - before_dib == 1,
                    "fixed-size frames reuse one DC and one DIB");
    window.pixels = Frame(480, 640, 19);  // physical pixel resize, including a DPI-driven size change
    window.buffer_width_ = 480; window.buffer_height_ = 640;
    window.PresentLayered();
    window.translucent_ = false;
    window.PresentLayered();
    Check(!window.layered_, "disabling translucency removes layered style");
    NoLeaks("disabling translucency releases GDI cache");
    window.translucent_ = true;
    window.PresentLayered();
  }
  expected_frame = nullptr;
  NoLeaks("window destruction releases restarted cache");
}

int main(int argc, char** argv) {
  bool gate = argc < 2 || std::strcmp(argv[1], "measure") != 0;
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  DWORD before = GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS);
  std::puts("GDI boundary: real Windows DCs and DIBs");
#else
  std::puts("GDI boundary: declared host adapter");
#endif
  Direct();
  Presentation(gate);
  std::thread worker([] {
    owner = std::this_thread::get_id();
    Direct();
  });
  worker.join();
  owner = std::this_thread::get_id();
  NoLeaks("owner thread teardown leaves no handles");
#if defined(_WIN32) && !defined(GESHER_TEST_DECLARED_GDI)
  Check(GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS) == before,
        "Windows reports no net GDI handle growth after resize/retry/teardown");
#endif
  std::printf("Layered bitmap cache: %zu checks, %zu failures\n", checks, failures);
  return failures != 0;
}
