// Real host JVM/JNI. Only VM attachment and logging are platform boundaries.
#include <jni.h>
#include <sys/types.h>
#include <algorithm>
#include <cstdint>
#include <cstring>
#include <memory>
#include <mutex>
#include <vector>
#include "compat/media/player/data_source.h"
#include "compat/media/jni/jni_util.h"
#include "compat/media/jni/java_data_source.h"

namespace gesher::media {
static JavaVM* vm;
JNIEnv* AttachedEnv(const char*) {
  JNIEnv* env = nullptr;
  if (vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) == JNI_OK) return env;
  if (vm->AttachCurrentThreadAsDaemon(reinterpret_cast<void**>(&env), nullptr) != JNI_OK) return nullptr;
  struct Detach { ~Detach() { vm->DetachCurrentThread(); } };
  static thread_local Detach detach;
  return env;
}
bool CheckException(JNIEnv* env, const char*) {
  if (!env->ExceptionCheck()) return false;
  env->ExceptionClear();
  return true;
}
@ADAPTER@
}  // namespace gesher::media

using Holder = std::shared_ptr<gesher::media::DataSource>;
extern "C" JNIEXPORT jlong JNICALL Java_MediaCallbackHost_open(JNIEnv* env, jclass, jobject source) {
  auto owner = gesher::media::OpenJavaDataSource(env, source);
  if (owner == nullptr) return 0;
  return reinterpret_cast<jlong>(new Holder(std::move(owner)));
}
extern "C" JNIEXPORT jlong JNICALL Java_MediaCallbackHost_read(JNIEnv* env, jclass, jlong handle,
    jlong offset, jint size, jbyteArray output) {
  if (size < 0 || size > 200000 || env->GetArrayLength(output) < size + 16) return -88;
  // The extra capacity makes overreported-count controls ordinary assertions:
  // even the old adapter writes only into allocated memory in these cases.
  std::vector<uint8_t> bytes(static_cast<size_t>(size) + 16, 0x6d);
  const auto source = *reinterpret_cast<Holder*>(handle);
  const ssize_t result = source->ReadAt(offset, bytes.data(), static_cast<size_t>(size));
  env->SetByteArrayRegion(output, 0, size + 16, reinterpret_cast<const jbyte*>(bytes.data()));
  return result;
}
extern "C" JNIEXPORT jlong JNICALL Java_MediaCallbackHost_size(JNIEnv*, jclass, jlong handle) {
  return (*reinterpret_cast<Holder*>(handle))->Size();
}
extern "C" JNIEXPORT void JNICALL Java_MediaCallbackHost_close(JNIEnv* env, jclass, jlong handle,
    jboolean pending) {
  if (pending) {
    jclass cls = env->FindClass("java/lang/IllegalStateException");
    env->ThrowNew(cls, "original setup failure");
    env->DeleteLocalRef(cls);
  }
  delete reinterpret_cast<Holder*>(handle);
}
extern "C" JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM* machine, void*) {
  gesher::media::vm = machine;
  return JNI_VERSION_1_6;
}
