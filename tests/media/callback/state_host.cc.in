// Exact production metadata publication and Player::Reset; container/worker seams.
#include <algorithm>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <functional>
#include <limits>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <vector>
#include "compat/media/player/data_source.h"
using gesher::media::DataSource;
static int checks, failures;
void check(bool value, const char* name) {
  ++checks;
  if (!value) { ++failures; std::printf("FAIL %s\n", name); }
}
struct Source : DataSource {
  explicit Source(char value, int64_t size = 1000) : tag(value), size(size) {}
  char tag;
  int64_t size;
  std::function<void()> closing;
  ~Source() override { if (closing) closing(); }
  int64_t Size() override { return size; }
  ssize_t ReadAt(int64_t, void* data, size_t n) override {
    if (n != 0) *static_cast<char*>(data) = tag;
    return n == 0 ? 0 : 1;
  }
};
struct Format {
  char tag;
  bool track = false;
  std::string Mime() const { return track ? "audio/raw" : "audio/wav"; }
  bool GetString(const char* name, std::string* out) const {
    if (std::string(name) != "title") return false;
    *out = std::string(1, tag); return true;
  }
  bool GetBuffer(const char*, std::vector<uint8_t>* out) const {
    if (tag != 'a') return false;  // Like real Format::GetBuffer: no output mutation.
    *out = {4, 5, 6}; return true;
  }
  bool GetInt64(const char* name, int64_t* out) const {
    if (std::string(name) != "durationUs") return false;
    *out = tag == 'a' ? 1000000 : tag == 'r' ? 3000000 : 2000000; return true;
  }
  bool GetInt32(const char* name, int32_t* out) const {
    if (std::string(name) != "sample-rate") return false;
    *out = 8000; return true;
  }
};
struct Extractor {
  char tag;
  static std::unique_ptr<Extractor> Open(std::shared_ptr<DataSource> source, std::string* error) {
    char tag = 0;
    if (source->ReadAt(0, &tag, 1) != 1 || tag == 'x') {
      *error = "controlled open failure"; return nullptr;
    }
    return std::unique_ptr<Extractor>(new Extractor{tag});
  }
  Format FileFormat() { return Format{tag, false}; }
  Format TrackFormat(size_t) { return Format{tag, true}; }
  size_t TrackCount() { return 1; }
};
@RETRIEVER@
@KEYS@
@FILL@
struct Playback {
  std::shared_ptr<DataSource> source;
  bool* stopped;
  void Shutdown() { *stopped = true; }
};
constexpr int kPlayerOk = 0, kIdle = 1;
struct Player {
  std::mutex mu_;
  std::condition_variable prepared_cv_;
  bool loop_ = true, prepare_sync_ = true;
  std::shared_ptr<Playback> playback_;
  std::shared_ptr<DataSource> source_;
  int state_ = 4, current_position_ = 99, seek_position_ = 12;
  int Reset();
};
@RESET@
void metadata() {
  Retriever r;
  std::string error;
  int firstClosed = 0, secondClosed = 0, failedClosed = 0;
  auto first = std::make_shared<Source>('a');
  first->closing = [&] {
    ++firstClosed;
    check(r.metadata[7] == "b" && r.album_art.empty(), "old close sees fully published new metadata");
  };
  check(Fill(&r, first, &error), "first metadata source");
  first.reset();
  check(r.album_art == std::vector<uint8_t>({4, 5, 6}), "first source art");
  auto second = std::make_shared<Source>('b');
  second->closing = [&] { ++secondClosed; };
  check(Fill(&r, second, &error), "second metadata source");
  second.reset();
  check(r.album_art.empty(), "source without picture clears prior art");
  check(r.metadata[7] == "b" && r.metadata[9] == "2000", "replacement metadata fields");
  check(firstClosed == 1 && secondClosed == 0, "only replaced source closes");
  auto bad = std::make_shared<Source>('x');
  bad->closing = [&] { ++failedClosed; };
  check(!Fill(&r, std::move(bad), &error), "bad replacement fails");
  check(failedClosed == 1 && secondClosed == 0, "bad replacement retires candidate only");
  char tag = 0; r.source->ReadAt(0, &tag, 1);
  check(tag == 'b' && r.metadata[7] == "b", "failed replacement preserves matching source and metadata");
  check(Fill(&r, std::make_shared<Source>('a'), &error), "art may return on another source");
  check(r.album_art == std::vector<uint8_t>({4, 5, 6}), "new art remains present");
  check(secondClosed == 1, "successful third source retires second");
}
void reset() {
  for (bool prepared : {false, true}) {
    Player player;
    int closed = 0;
    bool stopped = !prepared;
    auto source = std::make_shared<Source>('a');
    source->closing = [&] {
      ++closed;
      bool unlocked = false;
      std::thread observer([&] {
        std::unique_lock<std::mutex> lock(player.mu_, std::try_to_lock);
        unlocked = lock.owns_lock();
      });
      observer.join();
      check(unlocked, "source close runs outside player state mutex");
      check(player.state_ == kIdle && !player.loop_, "source close sees idle reset state");
      check(stopped, "source closes after playback shutdown");
    };
    player.source_ = source;
    if (prepared) player.playback_ = std::make_shared<Playback>(Playback{source, &stopped});
    source.reset();
    check(player.Reset() == kPlayerOk, "player reset succeeds");
    check(closed == 1, "reset closes final source owner exactly once");
    check(player.source_ == nullptr && player.playback_ == nullptr, "player releases all source owners");
    check(player.Reset() == kPlayerOk && closed == 1, "repeat reset does not close twice");
  }
}
void bitrate() {
  Retriever r;
  std::string error;
  check(Fill(&r, std::make_shared<Source>('r', 17), &error), "fractional bitrate source opens");
  check(r.metadata[20] == "45", "average bitrate truncates toward zero");
  check(Fill(&r, std::make_shared<Source>('b', 2000000000000LL), &error), "large virtual source opens");
  check(r.metadata[20] == "8000000000000", "large source bitrate avoids overflowing an integer intermediate");
  check(Fill(&r, std::make_shared<Source>('a', int64_t{1} << 60), &error), "conversion-boundary source opens");
  check(r.metadata.count(20) == 0, "average equal to two-to-63 is not converted to signed int64");
  check(Fill(&r, std::make_shared<Source>('b', std::numeric_limits<int64_t>::max()), &error),
        "out-of-range bitrate source opens");
  check(r.metadata.count(20) == 0, "unrepresentable average bitrate remains unavailable");
}
int main(int argc, char** argv) {
  if (argc != 2) return 2;
  if (std::string(argv[1]) == "metadata") metadata();
  else if (std::string(argv[1]) == "reset") reset();
  else if (std::string(argv[1]) == "bitrate") bitrate();
  else return 2;
  std::printf("Media callback state %s: %d checks, %d failures\n", argv[1], checks, failures);
  return failures != 0;
}
