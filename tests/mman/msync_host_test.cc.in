// Verbatim production msync and loader wrapper over a recording mapping query.
#include <algorithm>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <vector>

constexpr size_t kPage = 4096;
constexpr int MS_ASYNC = 1, MS_INVALIDATE = 2, MS_SYNC = 4;
constexpr int MEM_COMMIT = 0x1000, MEM_MAPPED = 0x40000;
using SIZE_T = size_t;
struct State { size_t page_size = kPage; };
State& state() { static State value; return value; }
size_t RoundUp(size_t x, size_t n) { return (x + n - 1) / n * n; }
struct MEMORY_BASIC_INFORMATION { void* BaseAddress; size_t RegionSize; int State, Type; };
int query_calls, flush_calls, writeback_calls;
size_t flushed_length;
size_t VirtualQuery(void* address, MEMORY_BASIC_INFORMATION* info, size_t) {
  ++query_calls;
  uintptr_t start = reinterpret_cast<uintptr_t>(address);
  if (start < 0x10000 || start >= 0x12000) return 0;
  *info = {reinterpret_cast<void*>(0x10000), 2 * kPage, MEM_COMMIT, MEM_MAPPED};
  return sizeof(*info);
}
bool FlushViewOfFile(void*, size_t length) { ++flush_calls; flushed_length = length; return true; }
int g_lazy_lock;
void AcquireSRWLockExclusive(int*) {}
void ReleaseSRWLockExclusive(int*) {}
std::vector<int>& SharedCopies() { static std::vector<int> copies{1}; return copies; }
bool WriteBackLocked(uintptr_t, uintptr_t) { ++writeback_calls; return true; }

@PRODUCTION_MSYNC@

int failures;
void Check(const char* name, bool ok) {
  std::printf("msync contracts: %s %s\n", name, ok ? "PASS" : "FAIL");
  failures += !ok;
}
int main() {
  for (auto sync : {&msync, &SyncLoadedMemory}) {
    query_calls = flush_calls = writeback_calls = 0;
    errno = 0;
    Check("wrapped address range is ENOMEM",
          sync(reinterpret_cast<void*>(2 * kPage), SIZE_MAX - kPage + 1, MS_SYNC) == -1 && errno == ENOMEM);
    Check("overflow has no query or writeback", query_calls == 0 && flush_calls == 0 && writeback_calls == 0);
    errno = 0;
    Check("invalid flags checked before overflow",
          sync(reinterpret_cast<void*>(2 * kPage), SIZE_MAX - kPage + 1, MS_SYNC | MS_ASYNC) == -1 && errno == EINVAL);
    Check("Linux zero rounded span succeeds", sync(reinterpret_cast<void*>(0x10000), SIZE_MAX, MS_SYNC) == 0);
    Check("zero span has no query or writeback", query_calls == 0 && writeback_calls == 0);
    Check("partial page sync succeeds", sync(reinterpret_cast<void*>(0x10000), 1, MS_SYNC) == 0);
    Check("partial page flush covers full page", flushed_length == kPage);
    errno = 0;
    Check("unmapped page is ENOMEM", sync(reinterpret_cast<void*>(0x20000), kPage, MS_SYNC) == -1 && errno == ENOMEM);
  }
  return failures != 0;
}
